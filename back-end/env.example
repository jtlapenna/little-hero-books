# Cloudflare R2 Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Workflow 2B Integration ===
# Authentication token (same token used by n8n to call backend webhooks)
BACKEND_API_TOKEN=

# n8n webhook URL for triggering Workflow 2B (placeholder)
N8N_2B_WEBHOOK_URL=

# Backend public base URL (for constructing webhook callback URLs)
BACKEND_URL=

# Optional explicit override for the 2B completion webhook
BACKEND_WEBHOOK_2B_COMPLETE_URL=

# === R2 Buckets (explicit names) ===
R2_ASSETS_BUCKET_NAME=little-hero-assets
R2_ORDERS_BUCKET_NAME=little-hero-orders
R2_PUBLIC_URL=

# === Supabase ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Gemini API (for Tab 1 revisions) ===
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# === Amazon SP-API Configuration ===
# Get these from Amazon Seller Central → Apps & Services → Develop Apps
AMZ_APP_CLIENT_ID=
AMZ_APP_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=ATVPDKIKX0DER
AMZ_REGION=na

# === AWS IAM Credentials (for Amazon Message Center) ===
# Get these from AWS Console → IAM → Users
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# === Customer Site Configuration ===
# URL where customers will access preview pages
CUSTOMER_SITE_URL=https://littleherolabs.com
# For local testing, use: http://localhost:4321

# === Preview Auto-Approval (Optional) ===
# Hours until auto-approval if customer doesn't respond
PREVIEW_AUTO_APPROVAL_HOURS=72

# === Amazon Preview Notifications ===
# Set to 'true' to enable sending preview links via Amazon Message Center
# When enabled, clicking "Send for Customer Approval" will send message to customer
AMAZON_PREVIEW_NOTIFICATIONS_ENABLED=false

# Use text-only messages (no HTML attachment). Link in message is clickable.
# Set to 'false' only if you want to send the HTML attachment (confirmCustomizationDetails).
AMAZON_FORCE_TEXT_ONLY=true

# When Lulu webhook receives SHIPPED, send "your book has shipped" via Amazon Message Center (optional).
AMAZON_SHIPPED_NOTIFICATIONS_ENABLED=false

