# Cloudflare R2 Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Workflow 2B Integration ===
# Authentication token (same token used by n8n to call backend webhooks)
BACKEND_API_TOKEN=

# n8n webhook URL for triggering Workflow 2B (placeholder)
N8N_2B_WEBHOOK_URL=

# W1.1 Router: MUST be the router webhook (e.g. .../webhook/w1-1-router), NOT a workflow URL.
# If set to book-assembly, bg-removal, 2a-start, order-intake, or w4-pdf-print, the cron will error.
N8N_ROUTER_WEBHOOK_URL=

# Order intake (W0) - used by Amazon cron and router cron for new orders
N8N_W0_WEBHOOK_URL=

# Backend public base URL (for constructing webhook callback URLs)
BACKEND_URL=

# Optional explicit override for the 2B completion webhook
BACKEND_WEBHOOK_2B_COMPLETE_URL=

# === R2 Buckets (explicit names) ===
R2_ASSETS_BUCKET_NAME=little-hero-assets
R2_ORDERS_BUCKET_NAME=little-hero-orders
R2_PUBLIC_URL=

# === Supabase ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Stripe (D2C checkout and webhooks) ===
# Secret key for creating PaymentIntents (checkout API)
STRIPE_SECRET_KEY=
# Webhook signing secret for verifying payment_intent.succeeded (webhook route)
STRIPE_WEBHOOK_SECRET=
# Optional: checkout amount in cents (default 2999 = $29.99)
# D2C_CHECKOUT_AMOUNT_CENTS=2999
# Frontend origin for Stripe success/cancel URLs and CORS on /api/checkout/create.
# Local dev: http://localhost:4321 (Astro dev server). Production: https://www.littleherolabs.com
D2C_FRONTEND_ORIGIN=

# === Gemini API (for Tab 1 revisions) ===
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# === Preview (D2C character preview) ===
# Optional: local path to assets/hair-references when R2 doesn't have hairstyle images (dev only).
# Example: /path/to/little-hero-books/assets/hair-references
# PREVIEW_HAIR_FALLBACK_DIR=

# === Amazon SP-API Configuration ===
# Get these from Amazon Seller Central → Apps & Services → Develop Apps
AMZ_APP_CLIENT_ID=
AMZ_APP_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=ATVPDKIKX0DER
AMZ_REGION=na

# === AWS IAM Credentials (for Amazon Message Center) ===
# Get these from AWS Console → IAM → Users
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# === Customer Site Configuration ===
# URL where customers will access preview pages
CUSTOMER_SITE_URL=https://littleherolabs.com
# For local testing, use: http://localhost:4321

# === Preview Auto-Approval (Optional) ===
# Hours until auto-approval if customer doesn't respond
PREVIEW_AUTO_APPROVAL_HOURS=72

# === Amazon Preview Notifications ===
# Set to 'true' to enable sending preview links via Amazon Message Center
# When enabled, clicking "Send for Customer Approval" will send message to customer
AMAZON_PREVIEW_NOTIFICATIONS_ENABLED=false

# Use text-only messages (no HTML attachment). Link in message is clickable.
# Set to 'false' only if you want to send the HTML attachment (confirmCustomizationDetails).
AMAZON_FORCE_TEXT_ONLY=true

# When Lulu webhook receives SHIPPED, send "your book has shipped" via Amazon Message Center (optional).
AMAZON_SHIPPED_NOTIFICATIONS_ENABLED=false

# When W4 calls /api/webhooks/print-submitted (after Lulu job created), send "your book has been sent to print" via Amazon Message Center (optional).
AMAZON_PRINT_SUBMITTED_NOTIFICATIONS_ENABLED=false

# === D2C Email Notifications (Resend) ===
# Used for D2C preview link, reminders, and shipped emails. Alternatives: SendGrid, Postmark, SES.
RESEND_API_KEY=
# From address (e.g. notifications@littleherolabs.com; verify domain in Resend)
D2C_EMAIL_FROM=Little Hero Books <notifications@littleherolabs.com>
# Optional: set to 'false' to disable D2C email; default enabled in production when RESEND_API_KEY is set
# D2C_EMAIL_ENABLED=true

