    "@squoosh/lib": "^0.3.1",
    "@supabase/supabase-js": "^2.79.0",
    "adm-zip": "^0.5.16",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "fast-png": "^8.0.0",
    "fast-xml-parser": "^5.3.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.546.0",
    "next": "^15.5.7",
    "next-auth": "^4.24.11",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.4.394",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pdf": "^10.2.0",
    "recharts": "^3.8.0",
    "resend": "^4.8.0",
    "sharp": "^0.34.5",
    "stripe": "^14.21.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.45.2"
  },
  "engines": {
    "node": ">=20"
  }
}
