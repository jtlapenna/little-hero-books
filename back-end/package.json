{
  "name": "back-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "pages:build": "npx @opennextjs/cloudflare build --openNextConfigPath ./open-next.config.js --skipWranglerConfigCheck && npm run pages:postbuild",
    "pages:postbuild": "bash scripts/postbuild.sh",
    "pages:verify": "bash scripts/verify-build.sh",
    "pages:analyze": "bash scripts/analyze-output.sh",
    "pages:diagnose": "bash scripts/diagnose-worker-imports.sh",
    "pages:verify-imports": "bash scripts/verify-worker-imports.sh",
    "pages:pre-upload": "bash scripts/pre-upload-diagnostic.sh",
    "pages:deploy": "wrangler pages deploy .open-next/cloudflare --project-name=little-hero-labs-admin",
    "start": "next start",
    "lint": "eslint",
    "test:supabase": "dotenv -e .env.local -- tsx scripts/test-supabase-integration.ts",
    "check:migration": "dotenv -e .env.local -- tsx scripts/check-migration-status.ts",
    "test:statuses": "dotenv -e .env.local -- tsx scripts/test-status-constants.ts",
    "test:preview-token": "dotenv -e .env.local -- tsx scripts/test-preview-token.ts",
    "check:tokens": "dotenv -e .env.local -- tsx scripts/check-preview-tokens.ts",
    "cleanup:orders": "dotenv -e .env.local -- tsx scripts/cleanup-old-orders.ts",
    "cleanup:r2-orders": "dotenv -e .env.local -- tsx scripts/cleanup-r2-orders.ts",
    "fetch:all-orders": "dotenv -e .env.local -- tsx scripts/fetch-all-orders.ts",
    "compare:status": "dotenv -e .env.local -- tsx scripts/compare-order-status.ts",
    "create-sibling": "dotenv -e .env.local -- tsx scripts/create-sibling-order-from-line-item.ts",
    "create-sibling-from-json": "dotenv -e .env.local -- tsx scripts/create-sibling-from-json-file.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.911.0",
    "@aws-sdk/s3-request-presigner": "^3.911.0",
    "@opennextjs/cloudflare": "^1.11.0",
    "@paschendale/r2-presigned-url": "^1.0.0",
    "@squoosh/lib": "^0.3.1",
    "@supabase/supabase-js": "^2.79.0",
    "adm-zip": "^0.5.16",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.1",
    "lucide-react": "^0.546.0",
    "next": "^15.5.7",
    "next-auth": "^4.24.11",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.4.394",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pdf": "^10.2.0",
    "resend": "^4.8.0",
    "sharp": "^0.34.5",
    "stripe": "^14.21.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.45.2"
  },
  "engines": {
    "node": ">=20"
  }
}
