    "migrate:workflow-jobs": "dotenv -e .env.local -- tsx scripts/apply-workflow-jobs-migration.ts",
    "check:w2a-live-route": "tsx scripts/check-w2a-live-route.ts",
    "watch:w2a-activation": "tsx scripts/watch-w2a-activation.ts",
    "check:workflow-export-secrets": "tsx scripts/check-workflow-export-secrets.ts",
    "reconcile:w2a-completion": "tsx scripts/reconcile-w2a-completion.ts",
    "replay:w2a-order": "tsx scripts/replay-w2a-order.ts",
    "verify:book-config": "dotenv -e .env.local -- tsx scripts/verify-book-config-publish.ts",
    "cleanup:orders": "dotenv -e .env.local -- tsx scripts/cleanup-old-orders.ts",
    "cleanup:r2-orders": "dotenv -e .env.local -- tsx scripts/cleanup-r2-orders.ts",
    "publish:book-config": "dotenv -e .env.local -- tsx scripts/publish-book-config.ts",
    "publish:book-config:book2": "dotenv -e .env.local -- tsx scripts/publish-book-config.ts --book-id book-2-example --version 1 --activate --published-by codex-book2-local-proof",
    "verify:book-config:book2": "dotenv -e .env.local -- tsx scripts/verify-book-config-publish.ts --book-id book-2-example --version 1",
    "test:book2-local-proof": "npm run publish:book-config:book2 && npm run verify:book-config:book2 && npm run test:book-replay:book2 && npm run test:book-replay:book2:published && npm run test:book-replay:w3:book2 && npm run test:w4-print-input && npm run test:w4-sibling-print-input && npm run test:book-kernel",
    "fetch:all-orders": "dotenv -e .env.local -- tsx scripts/fetch-all-orders.ts",
    "compare:status": "dotenv -e .env.local -- tsx scripts/compare-order-status.ts",
    "create-sibling": "dotenv -e .env.local -- tsx scripts/create-sibling-order-from-line-item.ts",
    "create-sibling-from-json": "dotenv -e .env.local -- tsx scripts/create-sibling-from-json-file.ts"
