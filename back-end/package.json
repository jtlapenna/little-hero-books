{
  "name": "back-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "pages:build": "opennextjs-cloudflare build --openNextConfigPath ./open-next.config.ts --skipWranglerConfigCheck && npm run pages:postbuild",
    "pages:postbuild": "bash scripts/postbuild.sh",
    "pages:verify": "bash scripts/verify-build.sh",
    "pages:analyze": "bash scripts/analyze-output.sh",
    "pages:diagnose": "bash scripts/diagnose-worker-imports.sh",
    "pages:verify-imports": "bash scripts/verify-worker-imports.sh",
    "pages:pre-upload": "bash scripts/pre-upload-diagnostic.sh",
    "pages:deploy": "wrangler pages deploy .open-next/cloudflare --project-name=bright-gift",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.911.0",
    "@aws-sdk/s3-request-presigner": "^3.911.0",
    "@opennextjs/cloudflare": "^1.11.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.1",
    "lucide-react": "^0.546.0",
    "next": "15.5.6",
    "next-auth": "^4.24.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.45.2"
  },
  "engines": {
    "node": ">=20"
  }
}
