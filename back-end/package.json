    "test:statuses": "dotenv -e .env.local -- tsx scripts/test-status-constants.ts",
    "test:book-kernel": "tsx scripts/test-book-kernel.ts",
    "test:book-replay": "dotenv -e .env.local -- tsx scripts/test-book-replay.ts --stage w0 --source published",
    "test:book-replay:book2": "dotenv -e .env.local -- tsx scripts/test-book-replay.ts --stage w0 --source bundled --fixture book2-standard-single",
    "test:book-replay:book2:published": "dotenv -e .env.local -- tsx scripts/test-book-replay.ts --stage w0 --source published --fixture book2-standard-single",
    "test:book-replay:w3": "dotenv -e .env.local -- tsx scripts/test-book-replay.ts --stage w3",
    "test:book-replay:w3:book2": "dotenv -e .env.local -- tsx scripts/test-book-replay.ts --stage w3 --fixture book2-standard-example",
    "test:w2a-pose-input": "tsx scripts/test-w2a-pose-input.ts",
    "test:w2b-worklist": "tsx scripts/test-w2b-worklist.ts",
    "test:w2b-pose-input": "tsx scripts/test-w2b-pose-input.ts",
    "test:w2-workflow-contracts": "tsx scripts/test-w2-workflow-contracts.ts",
    "test:workflow-jobs": "tsx scripts/test-workflow-jobs.ts",
    "test:workflow-export-secrets": "tsx scripts/test-workflow-export-secrets.ts",
    "test:w3-assembly-input": "tsx scripts/test-w3-assembly-input.ts",
    "test:w3-assembly-worker": "tsx scripts/test-w3-assembly-worker.ts",
    "test:w3-preview-plan": "tsx scripts/test-w3-preview-plan.ts",
    "test:w3-preview-render": "tsx scripts/test-w3-preview-render.ts",
    "test:w3-preview-artifacts": "tsx scripts/test-w3-preview-artifacts.ts",
    "test:w3-manifest": "tsx scripts/test-w3-manifest.ts",
    "test:w3-manifest-publish": "tsx scripts/test-w3-manifest-publish.ts",
    "test:w4-print-input": "tsx scripts/test-w4-print-input.ts",
    "test:w4-production-approval": "tsx scripts/test-w4-production-approval.ts",
    "test:w4-production-preflight": "tsx scripts/test-w4-production-preflight.ts",
    "test:w41-production-approval": "tsx scripts/test-w41-production-approval.ts",
    "test:w41-production-preflight": "tsx scripts/test-w41-production-preflight.ts",
    "test:w4-recovery": "tsx scripts/test-w4-recovery.ts",
    "test:w41-recovery": "tsx scripts/test-w41-recovery.ts",
    "test:lulu-status-map": "tsx scripts/test-lulu-status-map.ts",
    "test:lulu-webhook-signal": "tsx scripts/test-lulu-webhook-signal.ts",
    "test:w4-submit-input": "tsx scripts/test-w4-submit-input.ts",
    "test:w4-print-worker": "tsx scripts/test-w4-print-worker.ts",
    "test:w4-print-qa-failed": "tsx scripts/test-w4-print-qa-failed.ts",
    "test:w4-print-submitted": "tsx scripts/test-w4-print-submitted.ts",
    "test:w4-sibling-print-input": "tsx scripts/test-w4-sibling-print-input.ts",
    "test:r2-client": "tsx scripts/test-r2-client.ts",
    "test:preview-token": "dotenv -e .env.local -- tsx scripts/test-preview-token.ts",
    "check:tokens": "dotenv -e .env.local -- tsx scripts/check-preview-tokens.ts",
