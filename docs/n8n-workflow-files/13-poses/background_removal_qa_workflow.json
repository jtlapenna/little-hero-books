{
  "name": "Background Removal QA Check - Expanded",
  "nodes": [
    {
      "parameters": {
        "image": {
          "binaryPropertyName": "processedImage"
        },
        "actions": [
          {
            "action": "fillBackground",
            "color": "#39FF14"
          },
          {
            "action": "overlayImage",
            "image": {
              "binaryPropertyName": "processedImage"
            },
            "position": {
              "x": 0,
              "y": 0
            },
            "compositeMode": "over"
          }
        ]
      },
      "id": "1",
      "name": "Image Edit - Neon Background",
      "type": "n8n-nodes-base.imageEdit",
      "typeVersion": 1,
      "position": [
        300,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.gemini.example.com/v2.5/flash",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "sendBinaryData": false,
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "\n                {\n                    \"image_base64\": \"={{ $binary[\\\"data\\\"].toString('base64') }}\",\n                    \"prompt\": \"Review this image for errors in background removal. Are there any white areas within the character's silhouette\u2014such as eyes or teeth\u2014that appear to have been mistakenly removed?\"\n                }\n                ",
        "headerParametersJson": "\n                {\n                    \"Content-Type\": \"application/json\",\n                    \"Authorization\": \"Bearer YOUR_TOKEN_HERE\"\n                }\n                "
      },
      "id": "2",
      "name": "Send to Gemini QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        600,
        200
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "1",
          "name": "Gemini API Auth"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "boolean": [
            {
              "name": "needs_review",
              "value": "={{ $json[\"reply\"].toLowerCase().includes(\"yes\") || $json[\"details\"].toLowerCase().includes(\"mistakenly removed\") }}"
            }
          ],
          "string": [
            {
              "name": "gemini_reply",
              "value": "={{ $json[\"reply\"] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Parse Gemini Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "propertyName1": "image_id"
      },
      "id": "4",
      "name": "Merge QA Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {},
      "id": "5",
      "name": "Continue Workflow",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ]
    }
