      "id": "fetch-retry-ready-001",
      "name": "Fetch Orders Ready for Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, 400]
    },
    {
      "parameters": {
        "jsCode": "// Route retry orders back to appropriate workflow\nconst orders = $input.all().map(item => item.json);\n\nif (orders.length === 0) {\n  console.log('No orders ready for retry');\n  return [];\n}\n\nconsole.log(`Found ${orders.length} order(s) ready for retry`);\n\n// Group by next_workflow\nconst byWorkflow = {\n  '2A': [],\n  '2B': [],\n  '3': [],\n  '4': []\n};\n\nfor (const order of orders) {\n  const workflow = order.next_workflow || '2A';\n  if (byWorkflow[workflow]) {\n    byWorkflow[workflow].push(order);\n  }\n}\n\nreturn [{ json: byWorkflow }];"
      },
      "id": "route-retries-001",
      "name": "Route Retries by Workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://mdnthwpcnphjnnblbvxk.supabase.co/rest/v1/orders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + String($json.id) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            },
            {
              "name": "apikey",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1kbnRod3BjbnBoam5uYmxidnhrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MDUwMDc4MCwiZXhwIjoyMDc2MDc2NzgwfQ.wNVQ3U2nWTGu8VsuXKasWOCxVhpca5x42wSapQDinGs"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1kbnRod3BjbnBoam5uYmxidnhrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MDUwMDc4MCwiZXhwIjoyMDc2MDc2NzgwfQ.wNVQ3U2nWTGu8VsuXKasWOCxVhpca5x42wSapQDinGs"
