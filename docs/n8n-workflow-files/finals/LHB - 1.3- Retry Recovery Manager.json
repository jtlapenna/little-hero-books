          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"execution_status\": \"ready_for_processing\",\n  \"error_message\": null,\n  \"error_type\": null,\n  \"next_retry_at\": null,\n  \"current_workflow\": null,\n  \"started_at\": null\n} }}",
        "options": {}
      },
      "id": "reset-for-retry-001",
      "name": "Reset Status for Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 400]
    },
    {
      "parameters": {
        "jsCode": "// Prepare order for router (same format as router expects)\nconst order = $input.first().json;\n\nreturn [{\n  json: {\n    orderId: order.amazon_order_id,\n    characterHash: order.character_hash,\n    characterSpecs: order.character_specs,\n    bookSpecs: order.book_specs,\n    orderDbId: order.id,\n    workflow: order.next_workflow || '2A',\n    isRetry: true,\n    retryCount: order.retry_count\n  }\n}];"
      },
      "id": "prep-for-router-001",
      "name": "Prep for Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 400]
    },
    {
      "parameters": {
        "jsCode": "// Log retry attempt\nconst order = $input.first().json;\n\nconsole.log(`🔄 Retrying order ${order.orderId} (attempt ${order.retryCount + 1})`);\nconsole.log(`Workflow: ${order.workflow}`);\n\nreturn [{ json: order }];"
      },
      "id": "log-retry-001",
      "name": "Log Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 400]
    }
  ],
