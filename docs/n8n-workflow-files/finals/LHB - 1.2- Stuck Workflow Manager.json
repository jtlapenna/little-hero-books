        "jsCode": "// Log alert for manual review\nconst order = $input.first().json;\n\nconsole.error('🚨 MANUAL REVIEW REQUIRED');\nconsole.error(`Order: ${order.amazon_order_id}`);\nconsole.error(`Workflow: ${order.current_workflow}`);\nconsole.error(`Error: ${order.error_message}`);\nconsole.error(`Retry Count: ${order.retry_count}`);\n\n// TODO: Send to Slack/Email\n\nreturn [{ json: order }];"
      },
      "id": "alert-manual-001",
      "name": "Alert: Manual Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
