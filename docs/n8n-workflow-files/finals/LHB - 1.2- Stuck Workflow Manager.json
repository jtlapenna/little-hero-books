          "conditions": [
            {
              "id": "check-action-condition-001",
              "leftValue": "={{ $json.action }}",
              "rightValue": "require_manual_review",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {
          "looseTypeValidation": true
        }
      },
