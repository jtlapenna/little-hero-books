      "id": "4b68ccde-55ea-4c87-acef-6b735497c3fe",
      "name": "Fetch Orphaned Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -352,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Classify orphaned orders and determine recovery action\nconst orders = $input.all().map(item => item.json);\n\nif (orders.length === 0) {\n  console.log('No orphaned orders found');\n  return [];\n}\n\nconsole.log(`Found ${orders.length} orphaned order(s)`);\n\nconst classified = orders.map(order => {\n  // First check: Missing manifest (highest priority)\n  if (!order.one_manifest_url) {\n    return {\n      ...order,\n      action: 'create_manifest',\n      priority: 'high',\n      orphan_reason: 'missing_manifest'\n    };\n  }\n  \n  const reason = order.orphan_reason;\n  let action = null;\n  let priority = 'low';\n  \n  switch (reason) {\n    case 'error_no_retry_scheduled':\n      // Schedule retry if retry_count < 3\n      if ((order.retry_count || 0) < 3) {\n        action = 'schedule_retry';\n        priority = 'high';\n      } else {\n        action = 'require_manual_review';\n        priority = 'medium';\n      }\n      break;\n      \n    case 'error_max_retries_exceeded':\n      // Move to manual review\n      action = 'require_manual_review';\n      priority = 'high';\n      break;\n      \n    case 'processing_stuck_over_hour':\n    case 'processing_no_timestamp':\n      // Reset to error and schedule retry\n      action = 'reset_to_error_and_retry';\n      priority = 'high';\n      break;\n      \n    case 'ready_not_picked_up':\n      // Check if router is running, or reset priority\n      action = 'check_router_or_reset';\n      priority = 'medium';\n      break;\n      \n    default:\n      action = 'manual_review';\n      priority = 'low';\n  }\n  \n  return {\n    ...order,\n    action,\n    priority\n  };\n});\n\nreturn classified.map(order => ({ json: order }));"
      },
      "id": "cdf2c8e5-0d97-471c-88d6-cc24a3293e45",
      "name": "Classify Orphans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route orders by action type\nconst orders = $input.all().map(item => item.json);\n\nconst scheduleRetry = [];\nconst manualReview = [];\nconst resetProcessing = [];\nconst createManifest = [];\n\nfor (const order of orders) {\n  if (order.action === 'create_manifest') {\n    createManifest.push(order);\n  } else if (order.action === 'schedule_retry') {\n    scheduleRetry.push(order);\n  } else if (order.action === 'require_manual_review') {\n    manualReview.push(order);\n  } else if (order.action === 'reset_to_error_and_retry') {\n    resetProcessing.push(order);\n  } else {\n    // Default to manual review for unknown actions\n    manualReview.push(order);\n  }\n}\n\n// Return separate arrays for each action type\n// n8n will process each array separately\nreturn [\n  ...createManifest.map(o => ({ json: { ...o, _route: 'create_manifest' } })),\n  ...scheduleRetry.map(o => ({ json: { ...o, _route: 'schedule_retry' } })),\n  ...manualReview.map(o => ({ json: { ...o, _route: 'manual_review' } })),\n  ...resetProcessing.map(o => ({ json: { ...o, _route: 'reset_processing' } }))\n];"
      },
