        "jsCode": "// Alert on orphaned orders\nconst orders = $input.all().map(item => item.json);\n\nif (orders.length === 0) {\n  return [];\n}\n\nconsole.error('🚨 ORPHANED ORDERS DETECTED');\nconsole.error(`Count: ${orders.length}`);\n\nfor (const order of orders) {\n  console.error(`- ${order.amazon_order_id}: ${order.orphan_reason} (${order.action})`);\n}\n\n// TODO: Send to Slack/Email/Dashboard\n\nreturn orders.map(order => ({ json: order }));"
      },
