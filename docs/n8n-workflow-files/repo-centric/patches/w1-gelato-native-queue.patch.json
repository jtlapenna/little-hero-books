    {
      "name": "Capture Failed Native Gelato Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const claim=$('Expand Native Print Queue').item.json;\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif(claim.provider!=='gelato'||claim.dispatchRoute!=='dispatch'||!uuid.test(claim.submissionId)||!uuid.test(claim.claimToken))throw Error('Failed dispatch has no paired claim identity');\nreturn {json:{submissionId:claim.submissionId,claimToken:claim.claimToken}};",
        "mode": "runOnceForEachItem"
      },
