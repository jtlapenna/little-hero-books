    {
      "parameters": {
        "jsCode": "const incoming = $input.first()?.json;\nconst payload = incoming && Object.prototype.hasOwnProperty.call(incoming, 'body') ? incoming.body : incoming;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!payload || typeof payload !== 'object' || Array.isArray(payload) || typeof payload.submissionId !== 'string' || !uuid.test(payload.submissionId) || typeof payload.claimToken !== 'string' || !uuid.test(payload.claimToken)) throw new Error('Gelato workflow requires exact submission and claim identity');\nconst backendBase = 'https://admin.littleherolabs.com';\nif (backendBase !== 'https://admin.littleherolabs.com') throw new Error('Gelato backend destination must be the canonical HTTPS admin origin');\nconst executionId = String($execution.id || '');\nif (!executionId || executionId.length > 200) throw new Error('Gelato workflow execution identity is required');\nreturn [{ json: { backendBase, assemblyBody: payload, identity: { submissionId: payload.submissionId, claimToken: payload.claimToken, executionId, mode: 'single' } } }];"
      },
