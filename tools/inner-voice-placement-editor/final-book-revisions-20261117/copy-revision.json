          "rotateDeg": 0
        },
        "lineHeight": 1.3125
      },
      {
        "id": "text-20-03",
        "text": "\"Oh. You weren't trying to be mean.\"",
        "align": "left",
        "color": "#fff5de",
        "padding": 0,
        "fontSize": 78.71354166666666,
        "edgeStyle": "stroke",
        "placement": {
