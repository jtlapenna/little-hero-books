    "page-28": [
      {
        "id": "text-28-01",
        "text": "The quiet voice was there. Small and warm.",
        "align": "left",
        "color": "#392e29",
        "padding": 0,
        "fontSize": 74.08333333333333,
        "placement": {
          "top": 131.25,
