          "zIndex": 50,
          "rotateDeg": 0
        },
        "lineHeight": 1.3125
      },
      {
        "id": "text-28-03",
        "text": "\"Almost.\"",
        "align": "left",
        "color": "#793c28",
        "padding": 0,
        "fontSize": 111.125,
        "placement": {
