          "zIndex": 50,
          "rotateDeg": 0
        },
        "lineHeight": 1.75
      },
      {
        "id": "text-28-02",
        "text": "\"Not yet,\" it said.",
        "align": "left",
        "color": "#392e29",
        "padding": 0,
        "fontSize": 74.08333333333333,
        "placement": {
          "top": 291.03986787704497,
