          "rotateDeg": 0
        },
        "lineHeight": 1.2352941176470589
      },
      {
        "id": "text-20-04",
        "text": "The tiny voice felt warm again.",
        "align": "left",
        "color": "#fff5de",
        "padding": 0,
        "fontSize": 74.08333333333333,
        "edgeStyle": "stroke",
        "placement": {
