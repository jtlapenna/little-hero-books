---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Little Hero Labs - Become the hero of your own story", image } = Astro.props;

// Get current URL for canonical and og:url
const siteUrl = 'https://www.littleherolabs.com';
const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const ogImage = image || `${siteUrl}/og-image.jpg`; // Default OG image
---

<!doctype html>
<html lang="en" style="background-color: #FFFCF8;" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    
    <!-- Google Analytics (GA4) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-DEH39J706V"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DEH39J706V');
    </script>
    
    <!-- Ahrefs Analytics -->
    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="+VrWUwkxFNCZN2m3fP5/Gw"
      async
    ></script>
    
    <!-- Favicon & App Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico">
    
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL - Fixes duplicate pages issue -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Google Search Console Verification -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}

    <!-- Ahrefs Verification -->
    {import.meta.env.PUBLIC_AHREFS_VERIFICATION && (
      <meta name="ahrefs-site-verification" content={import.meta.env.PUBLIC_AHREFS_VERIFICATION} />
    )}

    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body style="background-color: #FFFCF8;">
    <Header />
    <main transition:name="main-content" class="layout-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Stable min-height during view transition swap to prevent flash */
  .layout-main {
    min-height: 60vh;
  }
</style>

