---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StepIndicator from '../components/create/StepIndicator.astro';
import BackLink from '../components/create/BackLink.astro';

interface Props {
  step: 'character' | 'customize' | 'review' | 'checkout' | 'processing';
  title: string;
  description?: string;
  image?: string;
}

const { step, title, description = 'Create your personalized book — Little Hero Labs', image } = Astro.props;

// Env-driven site URL for correct canonical/OG in all environments
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.littleherolabs.com';
const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const ogImage = image || `${siteUrl}/og-image.jpg`;

const backHrefByStep: Record<typeof step, string> = {
  character: '/our-books',
  customize: '/create/character',
  review: '/create/customize',
  checkout: '/create/review',
  processing: '',
};
const backLabelByStep: Record<typeof step, string> = {
  character: 'Back to books',
  customize: 'Back to character',
  review: 'Back to customize',
  checkout: 'Back to review',
  processing: '',
};
const showBackLink = step !== 'processing';
const backHref = backHrefByStep[step];
const backLabel = backLabelByStep[step];
const showStartOver = step !== 'character';
---

<!doctype html>
<html lang="en" style="background-color: #FFFCF8;" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_AHREFS_VERIFICATION && (
      <meta name="ahrefs-site-verification" content={import.meta.env.PUBLIC_AHREFS_VERIFICATION} />
    )}
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-create-step={step} style="background-color: #FFFCF8;">
    <Header />
    <main class="create-main" transition:name="main-content">
      <StepIndicator currentStep={step} />
      <div class="container">
        <div class="create-nav">
          {showBackLink && <BackLink href={backHref} label={backLabel} />}
          {showStartOver && (
            <a href="/create/character" data-clear-flow class="start-over-link">Start over</a>
          )}
        </div>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { load, clear } from '../lib/createFlow/createFlowStorage';
  import { canAccessStep } from '../lib/createFlow/createFlowSelectors';

  const step = document.body?.dataset?.createStep as string | undefined;
  if (step && step !== 'character') {
    const state = load();
    if (!canAccessStep(step as 'customize' | 'review' | 'checkout' | 'processing', state)) {
      window.location.href = '/create/character?toast=missing_state';
    }
  }

  document.querySelectorAll('[data-clear-flow]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      clear();
      window.location.href = '/create/character';
    });
  });
</script>

<style>
  /* Clear fixed header; space below stepper and bottom */
  .create-main {
    padding-top: 5rem;
    padding-bottom: var(--spacing-xl, 4rem);
    padding-left: 0;
    padding-right: 0;
    /* Prevent footer flash during page load */
    min-height: calc(100vh - 200px);
  }
  /* Spacing between StepIndicator and main content */
  .create-main .container {
    margin-top: var(--spacing-md, 1rem);
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--spacing-lg, 2rem);
    padding-right: var(--spacing-lg, 2rem);
  }
  /* Back link + Start over row — always same line */
  .create-nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm, 0.5rem);
    margin-bottom: var(--spacing-md, 1rem);
    width: 100%;
  }
  .create-nav > * {
    flex-shrink: 0;
  }
  .start-over-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: var(--color-teal, #5AC6B1);
    text-decoration: none;
    padding: 0.25rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .start-over-link:hover {
    text-decoration: underline;
  }
</style>
