---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StepIndicator from '../components/create/StepIndicator.astro';
import BackLink from '../components/create/BackLink.astro';

interface Props {
  step: 'character' | 'customize' | 'checkout' | 'processing';
  title: string;
  description?: string;
  image?: string;
}

const { step, title, description = 'Create your personalized book — Little Hero Labs', image } = Astro.props;

const siteUrl = 'https://www.littleherolabs.com';
const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const ogImage = image || `${siteUrl}/og-image.jpg`;

const backHrefByStep: Record<typeof step, string> = {
  character: '/our-books',
  customize: '/create/character',
  checkout: '/create/customize',
  processing: '',
};
const backLabelByStep: Record<typeof step, string> = {
  character: 'Back to books',
  customize: 'Back to character',
  checkout: 'Back to customize',
  processing: '',
};
const showBackLink = step !== 'processing';
const backHref = backHrefByStep[step];
const backLabel = backLabelByStep[step];
---

<!doctype html>
<html lang="en" style="background-color: #FFFCF8;">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_AHREFS_VERIFICATION && (
      <meta name="ahrefs-site-verification" content={import.meta.env.PUBLIC_AHREFS_VERIFICATION} />
    )}
    <slot name="head" />
  </head>
  <body data-create-step={step} style="background-color: #FFFCF8;">
    <Header />
    <main class="create-main">
      <div class="container">
        <StepIndicator currentStep={step} />
        {showBackLink && <BackLink href={backHref} label={backLabel} />}
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { load } from '../lib/createFlow/createFlowStorage';
  import { canAccessStep } from '../lib/createFlow/createFlowSelectors';

  const step = document.body?.dataset?.createStep as string | undefined;
  if (step && step !== 'character') {
    const state = load();
    if (!canAccessStep(step as 'customize' | 'checkout' | 'processing', state)) {
      window.location.href = '/create/character?toast=missing_state';
    }
  }
</script>

<style>
  .create-main {
    padding: var(--spacing-md, 1rem) 0 var(--spacing-xl, 4rem);
  }
  /* Center content with wide margins */
  .create-main .container {
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--spacing-lg, 2rem);
    padding-right: var(--spacing-lg, 2rem);
  }
</style>
