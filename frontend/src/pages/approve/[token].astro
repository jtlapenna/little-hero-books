---
import Layout from '../../layouts/Layout.astro';

// This is a server-rendered dynamic route (not pre-rendered)
// We need to validate tokens at runtime, so we can't use static generation
export const prerender = false;

// Get token from URL params
const { token } = Astro.params;

if (!token) {
  return Astro.redirect('/');
}
---

<Layout title="Book Preview - Little Hero Labs" description="Preview your personalized children's book">
  <!-- Hide header and footer navigation for preview page (secure link, no need for nav) -->
  <style is:global>
    #main-header,
    footer {
      display: none;
    }
  </style>
  <div id="preview-app">
    <!-- Loading State -->
    <div id="loading-state" class="preview-container">
      <div class="loading-content">
        <div class="spinner"></div>
        <p class="loading-text">Loading your book preview...</p>
      </div>
    </div>

    <!-- Error State -->
    <div id="error-state" class="preview-container" style="display: none;">
      <div class="error-content">
        <svg class="error-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h1 class="error-title">Unable to Load Preview</h1>
        <p id="error-message" class="error-text"></p>
        <a href="/" class="btn btn-primary">Return Home</a>
      </div>
    </div>

    <!-- Main Preview Content -->
    <div id="preview-content" class="preview-container" style="display: none;">
      <!-- Header -->
      <header class="preview-header">
        <div class="container">
          <div class="header-content">
            <div class="header-brand">
              <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <h1 class="header-title">Little Hero Labs</h1>
            </div>
            <p class="header-subtitle">Book Preview</p>
          </div>
        </div>
      </header>

      <div class="container preview-main">
        <!-- Page Header -->
        <div class="preview-card">
          <div class="preview-card-header">
            <div>
              <h2 class="preview-title">Your Book Preview</h2>
              <p class="preview-subtitle">
                Review your personalized book for <span id="child-name" class="font-semibold">your child</span>
              </p>
            </div>
            <div class="header-actions">
              <button id="revision-btn" class="btn btn-outline btn-revision" type="button">I need a correction</button>
              <button id="approve-btn" class="btn btn-primary btn-approve" disabled>Approve Book</button>
            </div>
          </div>
        </div>

        <!-- Preview Area (Placeholder) -->
        <div class="preview-card preview-area">
          <div class="preview-placeholder">
            <svg class="placeholder-icon" xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <h3 class="placeholder-title">Preview Will Appear Here</h3>
            <p class="placeholder-text">
              The full PDF preview will be available once Developer A completes the admin previewer.
            </p>
            <div class="placeholder-badge">
              <svg class="badge-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>This is a temporary placeholder</span>
            </div>
          </div>
        </div>

        <!-- Order Details -->
        <div class="preview-card">
          <h3 class="card-title">Order Details</h3>
          <div class="order-details-grid">
            <div>
              <p class="detail-label">Order ID</p>
              <p id="order-id" class="detail-value"></p>
            </div>
            <div id="age-detail" style="display: none;">
              <p class="detail-label">Age</p>
              <p id="age-value" class="detail-value"></p>
            </div>
          </div>
        </div>

        <!-- Correction Request -->
        <div id="correction-card" class="preview-card correction-card">
          <div class="correction-header">
            <div>
              <h3 class="card-title">Need a correction?</h3>
              <p id="correction-availability" class="correction-availability">You have 1 correction available.</p>
            </div>
            <a id="mailto-link" href="mailto:hello@littleherobooks.com" class="btn btn-outline mailto-btn">
              Email from your inbox
            </a>
          </div>
          <div id="correction-locked" class="locked-banner" style="display: none;">
            We already received your correction. If you need more help, reply to our email thread and our team will assist.
          </div>
          <div id="correction-success" class="success-banner" style="display: none;">
            Thank you! We received your correction. We’ll review it and follow up by email shortly.
          </div>
          <form id="correction-form" class="correction-form">
            <div class="form-group">
              <label class="form-label" for="contact-email">Your email</label>
              <input type="email" id="contact-email" class="form-input" placeholder="you@example.com" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="contact-name">Your name (optional)</label>
              <input type="text" id="contact-name" class="form-input" placeholder="Name that Amazon order is under" maxlength="150" />
            </div>
            <div class="form-group">
              <label class="form-label" for="reason-select">What needs fixing?</label>
              <select id="reason-select" class="form-input" required>
                <option value="">Select a correction</option>
              </select>
            </div>
            <div id="reason-banner" class="reason-banner" style="display: none;"></div>
            <div id="reason-fields" class="reason-fields"></div>
            <div id="correction-error" class="correction-error" style="display: none;"></div>
            <label class="checkbox-label marketing-opt">
              <input type="checkbox" id="marketing-opt-in" />
              <span>Keep me posted on new titles and promos for Little Hero Books.</span>
            </label>
            <div id="policy-box" class="policy-box">
              We can adjust details to match the options you selected (name spelling, preset hair style/color, skin tone, pronouns, etc.). We can’t create brand-new art or styles beyond the choices shown.
            </div>
            <div class="correction-actions">
              <button type="submit" id="correction-submit" class="btn btn-primary">Send correction</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Approval Modal -->
    <div id="approval-modal" class="modal" style="display: none;">
      <div class="modal-content">
        <h3 class="modal-title">Approve Your Book</h3>
        <div class="modal-body">
          <div class="warning-box">
            <p class="warning-title">⚠️ Important Information:</p>
            <ul class="warning-list">
              <li>Changes after approval will incur additional charges</li>
              <li>Your book will be printed and shipped within 5-7 business days after approval</li>
              <li>If you do not respond within 3 days, your book will be automatically approved and sent to print</li>
              <li>By approving, you confirm the book is correct and ready for printing</li>
            </ul>
          </div>
          <div id="last-revision-checkbox-container" class="checkbox-container" style="display: none;">
            <label class="checkbox-label">
              <input type="checkbox" id="acknowledge-last-revision" />
              <span>I confirm the book is correct and ready to print immediately.</span>
            </label>
          </div>
        </div>
        <div class="modal-actions">
          <button id="approval-cancel" class="btn btn-outline">Cancel</button>
          <button id="approval-confirm" class="btn btn-primary" disabled>Approve Book</button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ token }} is:inline>
  const API_BASE = 'http://localhost:3000';
  const HAIR_STYLES = ['afro', 'bun', 'curly-long', 'curly-medium', 'curly-short', 'pigtails', 'pom-poms', 'ponytail', 'side-part', 'straight-long', 'straight-medium', 'straight-short'];
  const HAIR_COLORS = ['blonde', 'strawberry-blonde', 'light-brown', 'medium-brown', 'dark-brown', 'auburn', 'black', 'red'];
  const SKIN_TONES = ['skin-light', 'skin-medium', 'skin-tan', 'skin-brown-light', 'skin-brown-deep'];
  const PRONOUNS = ['she/her', 'he/him', 'they/them'];
  const ANIMAL_GUIDES = ['dog', 'cat', 'owl', 'lion', 'tiger', 'penguin', 't-rex', 'unicorn'];
  const FAVORITE_COLORS = ['red', 'orange', 'yellow', 'green', 'blue', 'pink', 'purple', 'brown', 'black'];
  const CLOTHING_STYLES = ['tee-shorts', 'dress'];

  const REASON_DEFINITIONS = [
    { id: 'name_typo', label: 'Name spelling is wrong', fields: [{ id: 'newName', label: 'Correct spelling', type: 'text', maxLength: 20, required: true, placeholder: 'Updated spelling' }] },
    { id: 'hairStyle_wrong', label: 'Hair style is wrong', fields: [{ id: 'hairStyle', label: 'Choose the hair style you selected', type: 'select', options: HAIR_STYLES, required: true }] },
    { id: 'hairColor_wrong', label: 'Hair color is wrong', fields: [{ id: 'hairColor', label: 'Pick the hair color you wanted', type: 'select', options: HAIR_COLORS, required: true }] },
    { id: 'skinTone_wrong', label: 'Skin tone is wrong', fields: [{ id: 'skinTone', label: 'Pick the skin tone you selected', type: 'select', options: SKIN_TONES, required: true }] },
    { id: 'pronouns_wrong', label: 'Pronouns are wrong', fields: [{ id: 'pronouns', label: 'Choose the pronouns you wanted', type: 'select', options: PRONOUNS, required: true }] },
    { id: 'animalGuide_wrong', label: 'Animal guide is wrong', fields: [{ id: 'animalGuide', label: 'Pick the animal guide you selected', type: 'select', options: ANIMAL_GUIDES, required: true }] },
    { id: 'favoriteColor_wrong', label: 'Favorite color is wrong', fields: [{ id: 'favoriteColor', label: 'Pick the favorite color you selected', type: 'select', options: FAVORITE_COLORS, required: true }] },
    { id: 'clothingStyle_wrong', label: 'Clothing style is wrong', fields: [{ id: 'clothingStyle', label: 'Choose the clothing style you selected', type: 'select', options: CLOTHING_STYLES, required: true }] },
    { id: 'dedication_fix', label: 'Dedication text needs a fix', fields: [{ id: 'dedication', label: 'Updated dedication message', type: 'textarea', maxLength: 200, required: true, rows: 4, placeholder: 'Enter the corrected dedication text' }] },
    { id: 'hometown_fix', label: 'Hometown text needs a fix', fields: [{ id: 'hometown', label: 'Updated hometown', type: 'text', maxLength: 50, required: true, placeholder: 'City, State' }] },
    { id: 'favoriteFood_fix', label: 'Favorite food text needs a fix', fields: [{ id: 'favoriteFood', label: 'Updated favorite food', type: 'text', maxLength: 30, required: true, placeholder: 'Favorite food' }] },
    { id: 'age_wrong', label: 'Age is wrong', fields: [{ id: 'age', label: 'Correct age (3-8)', type: 'number', min: 3, max: 8, required: true }] },
    {
      id: 'visual_issue',
      label: 'Something looks off (printing or color issue)',
      fields: [
        { id: 'visualIssue', label: 'What kind of issue?', type: 'select', options: ['blurry', 'missing-element', 'odd-colors', 'layout-cutoff', 'other-visual'], required: true },
        { id: 'details', label: 'Any details? (optional)', type: 'text', maxLength: 120, placeholder: 'Brief description' }
      ]
    },
    {
      id: 'other',
      label: 'Other (limited)',
      banner: 'We can fix details you selected on your order. Custom art or new styles aren’t available.',
      fields: [{ id: 'details', label: 'Describe the issue', type: 'text', maxLength: 120, required: true, placeholder: 'Short description (max 120 characters)' }]
    }
  ];

  let orderData = null;
  let correctionUsed = false;

  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorMessage = document.getElementById('error-message');
  const previewContent = document.getElementById('preview-content');
  const childNameEl = document.getElementById('child-name');
  const orderIdEl = document.getElementById('order-id');
  const ageDetail = document.getElementById('age-detail');
  const ageValue = document.getElementById('age-value');
  const approveBtn = document.getElementById('approve-btn');
  const approvalModal = document.getElementById('approval-modal');
  const acknowledgeCheckbox = document.getElementById('acknowledge-last-revision');
  const lastRevisionContainer = document.getElementById('last-revision-checkbox-container');
  const approvalConfirmBtn = document.getElementById('approval-confirm');

  const correctionAvailability = document.getElementById('correction-availability');
  const correctionForm = document.getElementById('correction-form');
  const correctionSuccess = document.getElementById('correction-success');
  const correctionLocked = document.getElementById('correction-locked');
  const correctionSubmit = document.getElementById('correction-submit');
  const correctionError = document.getElementById('correction-error');
  const reasonSelect = document.getElementById('reason-select');
  const reasonBanner = document.getElementById('reason-banner');
  const reasonFieldsContainer = document.getElementById('reason-fields');
  const marketingOptIn = document.getElementById('marketing-opt-in');
  const contactEmailInput = document.getElementById('contact-email');
  const contactNameInput = document.getElementById('contact-name');
  const mailtoLink = document.getElementById('mailto-link');
  const revisionBtn = document.getElementById('revision-btn');
  const correctionCard = document.getElementById('correction-card');

  function populateReasonOptions() {
    reasonSelect.innerHTML = '<option value="">Select a correction</option>';
    REASON_DEFINITIONS.forEach((reason) => {
      const option = document.createElement('option');
      option.value = reason.id;
      option.textContent = reason.label;
      reasonSelect.appendChild(option);
    });
  }

  function showError(message) {
    loadingState.style.display = 'none';
    errorState.style.display = 'flex';
    errorMessage.textContent = message;
  }

  function showPreview() {
    loadingState.style.display = 'none';
    previewContent.style.display = 'block';
  }

  async function loadPreview() {
    try {
      const response = await fetch(`${API_BASE}/api/preview/validate-token`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await response.json();

      if (!response.ok || !data.valid) {
        showError(data.error || 'Invalid or expired token');
        return;
      }

      if (!data.order) {
        showError('Order not found');
        return;
      }

      orderData = data.order;
      displayOrder(orderData);
      showPreview();
    } catch (error) {
      console.error('Error loading preview:', error);
      showError(error.message || 'Failed to load preview');
    }
  }

  function displayOrder(order) {
    const childName = order.characterSpecs?.childName || 'your child';
    childNameEl.textContent = childName;

    const displayOrderId = order.amazonOrderId || order.orderId;
    orderIdEl.textContent = displayOrderId;

    if (order.characterSpecs?.age) {
      ageDetail.style.display = 'block';
      ageValue.textContent = `${order.characterSpecs.age} years old`;
    }

    setupMailtoLink(displayOrderId, childName);
    updateCorrectionState(order);

    approveBtn.disabled = false;
  }

  function setupMailtoLink(orderId, childName) {
    const subject = encodeURIComponent(`Order ${orderId} - Correction request`);
    const body = encodeURIComponent(
      `Hi Little Hero Books,\n\nI'd like to correct my book for ${childName}.\n\nOrder ID: ${orderId}\nPreview link: https://littleherolabs.com/approve/${token}\n\nDetails:\n`
    );
    mailtoLink.href = `mailto:hello@littleherobooks.com?subject=${subject}&body=${body}`;
  }

  function updateCorrectionState(order) {
    correctionUsed = (order.revisionCount || 0) >= 1;

    if (correctionUsed) {
      correctionAvailability.textContent = 'Correction already submitted';
      correctionAvailability.classList.add('correction-used');
      correctionForm.style.display = 'none';
      correctionLocked.style.display = 'block';
      correctionSuccess.style.display = 'block';
      lastRevisionContainer.style.display = 'block';
      approvalConfirmBtn.disabled = !acknowledgeCheckbox.checked;
      revisionBtn.textContent = 'View correction details';
      revisionBtn.classList.add('correction-used');
    } else {
      correctionAvailability.textContent = 'You have 1 correction available.';
      correctionAvailability.classList.remove('correction-used');
      correctionForm.style.display = 'block';
      correctionLocked.style.display = 'none';
      correctionSuccess.style.display = 'none';
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';
      lastRevisionContainer.style.display = 'none';
      acknowledgeCheckbox.checked = false;
      approvalConfirmBtn.disabled = false;
      revisionBtn.textContent = 'I need a correction';
      revisionBtn.classList.remove('correction-used');
    }
  }

  function renderReasonFields(reasonId) {
    reasonFieldsContainer.innerHTML = '';
    correctionError.style.display = 'none';

    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);
    if (!reason) {
      reasonBanner.style.display = 'none';
      return;
    }

    if (reason.banner) {
      reasonBanner.textContent = reason.banner;
      reasonBanner.style.display = 'block';
    } else {
      reasonBanner.style.display = 'none';
    }

    reason.fields.forEach((field) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'form-group';

      const label = document.createElement('label');
      label.className = 'form-label';
      label.htmlFor = `field-${field.id}`;
      label.textContent = field.label;

      let input;
      if (field.type === 'select') {
        input = document.createElement('select');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.required = !!field.required;
        input.innerHTML = '<option value="">Select an option</option>';
        field.options.forEach((optionValue) => {
          const option = document.createElement('option');
          option.value = optionValue;
          option.textContent = optionValue;
          input.appendChild(option);
        });
      } else if (field.type === 'textarea') {
        input = document.createElement('textarea');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.rows = field.rows || 4;
        input.maxLength = field.maxLength || 500;
        input.placeholder = field.placeholder || '';
        if (field.required) input.required = true;
      } else {
        input = document.createElement('input');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.type = field.type === 'number' ? 'number' : 'text';
        if (field.type === 'number') {
          if (typeof field.min === 'number') input.min = field.min;
          if (typeof field.max === 'number') input.max = field.max;
        }
        if (field.maxLength) input.maxLength = field.maxLength;
        if (field.placeholder) input.placeholder = field.placeholder;
        if (field.required) input.required = true;
      }

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      reasonFieldsContainer.appendChild(wrapper);
    });
  }

  function collectFieldValues(reason) {
    const values = {};
    if (!reason) return values;

    reason.fields.forEach((field) => {
      const input = document.getElementById(`field-${field.id}`);
      if (!input) return;

      if (field.type === 'number') {
        const numericValue = input.value ? Number(input.value) : null;
        if (numericValue !== null && !Number.isNaN(numericValue)) {
          values[field.id] = numericValue;
        }
      } else {
        const value = input.value.trim();
        if (value) {
          values[field.id] = value;
        }
      }
    });

    return values;
  }

  async function handleCorrectionSubmit(event) {
    event.preventDefault();
    correctionError.style.display = 'none';

    if (!orderData) return;
    if (correctionUsed) {
      correctionError.textContent = 'You have already used your correction for this order.';
      correctionError.style.display = 'block';
      return;
    }

    const reasonId = reasonSelect.value;
    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);
    if (!reason) {
      correctionError.textContent = 'Please select what needs fixing.';
      correctionError.style.display = 'block';
      return;
    }

    const email = contactEmailInput.value.trim();
    if (!email) {
      correctionError.textContent = 'Please enter your email address.';
      correctionError.style.display = 'block';
      return;
    }

    const name = contactNameInput.value.trim();
    const fields = collectFieldValues(reason);

    const missingField = reason.fields.find((field) => field.required && !fields[field.id]);
    if (missingField) {
      correctionError.textContent = 'Please fill out the required fields.';
      correctionError.style.display = 'block';
      return;
    }

    correctionSubmit.disabled = true;
    correctionSubmit.textContent = 'Sending...';

    try {
      const response = await fetch(`${API_BASE}/api/preview/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: orderData.orderId,
          amazonOrderId: orderData.amazonOrderId || null,
          token,
          email,
          name: name || null,
          reason: reasonId,
          fields,
          marketingOptIn: marketingOptIn.checked
        })
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Failed to send correction');
      }

      correctionForm.reset();
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';

      orderData.revisionCount = (orderData.revisionCount || 0) + 1;
      updateCorrectionState(orderData);
      correctionSuccess.style.display = 'block';
      correctionLocked.style.display = 'none';
    } catch (error) {
      console.error('Error submitting correction:', error);
      correctionError.textContent = error.message || 'Failed to send correction. Please try again or email us.';
      correctionError.style.display = 'block';
    } finally {
      correctionSubmit.disabled = false;
      correctionSubmit.textContent = 'Send correction';
    }
  }

  async function handleApprove() {
    if (!orderData || !token) return;

    if (correctionUsed && !acknowledgeCheckbox.checked) {
      alert('Please confirm you are ready to send your book to print.');
      return;
    }

    approveBtn.disabled = true;
    approveBtn.textContent = 'Approving...';

    try {
      const response = await fetch(`${API_BASE}/api/preview/${orderData.orderId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Failed to approve');
      }

      window.location.href = `/order-status/${orderData.orderId}?token=${token}`;
    } catch (error) {
      console.error('Error approving:', error);
      alert(error.message || 'Failed to approve book. Please try again.');
      approveBtn.disabled = false;
      approveBtn.textContent = 'Approve Book';
    }
  }

  populateReasonOptions();
  reasonSelect.addEventListener('change', (event) => renderReasonFields(event.target.value));
  correctionForm.addEventListener('submit', handleCorrectionSubmit);

  approveBtn.addEventListener('click', () => {
    approvalModal.style.display = 'flex';
  });

  document.getElementById('approval-cancel').addEventListener('click', () => {
    approvalModal.style.display = 'none';
  });

  approvalConfirmBtn.addEventListener('click', handleApprove);

  revisionBtn.addEventListener('click', () => {
    if (correctionCard) {
      correctionCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      correctionCard.classList.add('jump-highlight');
      setTimeout(() => correctionCard.classList.remove('jump-highlight'), 800);
    }
  });

  acknowledgeCheckbox.addEventListener('change', () => {
    approvalConfirmBtn.disabled = correctionUsed && !acknowledgeCheckbox.checked;
  });

  loadPreview();
</script>

<style>
  .preview-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f5f0ff 0%, #ffffff 60%);
  }

  .loading-content,
  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    text-align: center;
    padding: var(--spacing-xl);
  }

  .spinner {
    width: 48px;
