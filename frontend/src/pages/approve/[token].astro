    if (!curtainHero) {
      console.warn('[CURTAIN] ⚠️ handleScroll: curtainHero not found, ABORTING');
      return;
    }
    
    if (!wheelListenersActive) {
      // console.log('[CURTAIN] ⏸️ handleScroll: wheel listeners inactive, IGNORING EVENT');
      return;
    }
    
    // Calculate scroll delta - use actual pixel values for normal scroll speed
    const delta = e.deltaY || e.detail || -e.wheelDelta;
    const windowHeight = window.innerHeight;
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    
    // Convert scroll delta to curtain position change (match normal scroll speed)
    // delta is typically 100-200 pixels, we want 1 viewport height to fully lift curtain
    const scrollDelta = delta / windowHeight;
    
    // Update curtain position
    const newPosition = curtainScrollPosition + scrollDelta;
    
    // const scrollDirection = delta > 0 ? '⬇️ DOWN' : delta < 0 ? '⬆️ UP' : '↔️ NONE';
    // console.log('[CURTAIN] 📊 handleScroll: CALCULATED VALUES', {
    //   direction: scrollDirection,
    //   delta: delta.toFixed(2),
    //   scrollDelta: scrollDelta.toFixed(4),
    //   windowHeight: windowHeight.toFixed(2),
    //   currentPosition: curtainScrollPosition.toFixed(3),
    //   newPosition: newPosition.toFixed(3),
    //   scrollTop: scrollTop.toFixed(2),
    //   curtainFullyLifted,
    //   wheelListenersActive
    // });
    
    // Handle scrolling down (revealing curtain) or up (hiding curtain)
    if (delta > 0) {
      // Scrolling down - lift curtain
      // console.log('[CURTAIN] ⬇️⬇️⬇️ SCROLLING DOWN - LIFTING CURTAIN', {
      //   beforePosition: curtainScrollPosition.toFixed(3),
      //   willReachMax: newPosition >= 1
      // });
      
      if (curtainScrollPosition < 1) {
        // console.log('[CURTAIN] ✅ Curtain not fully lifted yet, PREVENTING DEFAULT and updating position');
        e.preventDefault();
        const oldPosition = curtainScrollPosition;
        curtainScrollPosition = Math.max(0, Math.min(1, newPosition));
        // console.log('[CURTAIN] 📈 Position change:', {
        //   from: oldPosition.toFixed(3),
        //   to: curtainScrollPosition.toFixed(3),
        //   change: (curtainScrollPosition - oldPosition).toFixed(3)
        // });
        // console.log('[CURTAIN] 🔄 Calling updateCurtainPosition()');
        updateCurtainPosition();
        
        // If fully lifted, prepare for transition
        if (curtainScrollPosition >= 1) {
          console.log('[CURTAIN] 🎯🎯🎯 CURTAIN POSITION REACHED 1.0 (FULLY LIFTED)', {
            position: curtainScrollPosition.toFixed(3),
            message: 'Will transition in updateCurtainPosition'
          });
        }
      } else {
        // console.log('[CURTAIN] ⚠️ Curtain already at max position (>= 1), this should not happen here', {
        //   position: curtainScrollPosition.toFixed(3)
        // });
      }
    } else if (delta < 0) {
      // Scrolling up - if curtain is fully lifted, allow normal scroll
      if (curtainScrollPosition >= 1 || curtainFullyLifted) {
        // Curtain is already fully lifted, allow normal scroll behavior
        // console.log('[CURTAIN] 📄 Scroll up detected but curtain is fully lifted, ALLOWING NORMAL SCROLL', {
        //   scrollTop: scrollTop.toFixed(2),
        //   curtainPosition: curtainScrollPosition.toFixed(3),
        //   curtainFullyLifted
        // });
        return; // Allow normal scroll
      } else {
        // Curtain is still visible, allow normal scroll (no action needed)
        // console.log('[CURTAIN] 📄 Scroll up detected while curtain visible, allowing normal scroll', {
        //   scrollTop: scrollTop.toFixed(2),
        //   curtainPosition: curtainScrollPosition.toFixed(3)
        // });
        return;
      }
    } else {
      // console.log('[CURTAIN] ⚠️ Delta is 0 or undefined, no action taken', { delta });
    }
    
    // console.log('[CURTAIN] 🏁 handleScroll EVENT COMPLETE');
  }

  function handlePageScroll() {
    // console.log('[CURTAIN] 📜 handlePageScroll EVENT TRIGGERED', {
    //   timestamp: new Date().toISOString(),
    //   hasCurtainHero: !!curtainHero
    // });
    
    if (!curtainHero) {
      console.warn('[CURTAIN] ⚠️ handlePageScroll: curtainHero not found, ABORTING');
      return;
    }
    
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    const windowHeight = window.innerHeight;
    const pageContent = document.getElementById('book-content');
    
    // console.log('[CURTAIN] 📊 handlePageScroll: CURRENT STATE', {
    //   scrollTop: scrollTop.toFixed(2),
    //   windowHeight: windowHeight.toFixed(2),
    //   curtainScrollPosition: curtainScrollPosition.toFixed(3),
    //   curtainFullyLifted,
    //   wheelListenersActive,
    //   isAtTop: scrollTop <= 0,
    //   scrollPercentage: (scrollTop / windowHeight).toFixed(2) + '%'
    // });
    
    // Log DOM positions when scroll event fires
    // logDOMPositions('handlePageScroll - Scroll event fired');
    
    // Once curtain is fully lifted, it stays up permanently - no action needed
    if (curtainFullyLifted || curtainScrollPosition >= 1) {
      // console.log('[CURTAIN] ℹ️ Curtain is fully lifted, allowing normal page scroll', {
      //   scrollTop: scrollTop.toFixed(2),
      //   curtainFullyLifted,
      //   curtainScrollPosition: curtainScrollPosition.toFixed(3)
      // });
      return; // No action - curtain stays up
    } else if (scrollTop > 0 && scrollTop < windowHeight && curtainScrollPosition < 1 && !curtainFullyLifted) {
      // If we somehow scrolled without fully lifting curtain, sync position
      console.warn('[CURTAIN] ⚠️ Syncing curtain position with scroll (unexpected scroll detected)', {
        scrollTop: scrollTop.toFixed(2),
        currentPosition: curtainScrollPosition.toFixed(3),
        curtainFullyLifted,
        willSync: true
      });
      
      const oldPosition = curtainScrollPosition;
      curtainScrollPosition = Math.min(1, scrollTop / windowHeight);
      
      // console.log('[CURTAIN] 📊 Synced position:', {
      //   from: oldPosition.toFixed(3),
      //   to: curtainScrollPosition.toFixed(3),
      //   change: (curtainScrollPosition - oldPosition).toFixed(3)
      // });
      
      updateCurtainPosition();
      
      if (curtainScrollPosition >= 1) {
        console.log('[CURTAIN] ⚠️ Curtain reached max during sync - transitioning to normal scroll', {
          position: curtainScrollPosition.toFixed(3)
        });
        // This will trigger the transition in updateCurtainPosition
      }
    } else {
      // console.log('[CURTAIN] ℹ️ handlePageScroll: NO ACTION TAKEN', {
      //   scrollTop: scrollTop.toFixed(2),
      //   curtainScrollPosition: curtainScrollPosition.toFixed(3),
      //   curtainFullyLifted,
      //   reason: scrollTop <= 0 
      //     ? 'At top but conditions not met' 
      //     : curtainScrollPosition >= 1 
      //       ? 'Curtain already at max' 
      //       : curtainFullyLifted 
      //         ? 'Curtain already fully lifted' 
      //         : 'Normal scrolling'
      // });
    }
    
    // console.log('[CURTAIN] 🏁 handlePageScroll EVENT COMPLETE');
  }

  // Initial setup - ensure header is black during loading
  updateHeaderForLoading();
  
  // console.log('[CURTAIN] 🚀 Initializing curtain effect');
  window.scrollTo(0, 0);
  updateCurtainPosition();
  updateHeaderForCurtain(); // Ensure header is styled correctly on initial load (will check loading state)
  
