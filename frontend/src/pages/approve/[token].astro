---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

// This is a server-rendered dynamic route (not pre-rendered)
// We need to validate tokens at runtime, so we can't use static generation
export const prerender = false;

// Get token from URL params
const { token } = Astro.params;
const rawRequireEmail = import.meta.env.PUBLIC_REQUIRE_CUSTOMER_EMAIL;
const requireEmail =
  rawRequireEmail !== undefined
    ? !['false', '0'].includes(String(rawRequireEmail).toLowerCase())
    : Astro.site?.hostname
    ? true
    : import.meta.env.MODE === 'production';

if (!token) {
  return Astro.redirect('/');
}
---

<Layout title="Book Preview - Little Hero Labs" description="Preview your personalized children's book">
  <div id="preview-app">
    <!-- Loading State -->
    <div id="loading-state" class="preview-container">
      <div class="loading-content">
        <div class="spinner"></div>
        <p class="loading-text">Loading your book preview...</p>
      </div>
    </div>

    <!-- Error State -->
    <div id="error-state" class="preview-container" style="display: none;">
      <div class="error-content">
        <svg class="error-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h1 class="error-title">Unable to Load Preview</h1>
        <p id="error-message" class="error-text"></p>
        <Button href="/" variant="primary" size="md">Return Home</Button>
      </div>
    </div>

    <!-- Main Preview Content -->
    <div id="preview-content" class="preview-container" style="display: none;">
      <!-- Curtain Hero Section (overlay on top) -->
      <div id="curtain-hero" class="curtain-hero">
        <div class="curtain-content">
          <h1 class="curtain-title">
            Hi, <span id="curtain-buyer-name" class="buyer-name">there</span>.
          </h1>
          <p class="curtain-subtitle">
            We are so excited to show you <span id="curtain-child-name" class="child-name-highlight">your child</span>'s book!
          </p>
          <div class="scroll-indicator">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
            <span>Scroll to reveal</span>
          </div>
        </div>
      </div>

      <!-- Scroll spacer that allows curtain to be revealed -->
      <div id="curtain-scroll-area" class="curtain-scroll-area"></div>

      <!-- Book Preview Content (stays in place, revealed as curtain slides up) -->
      <div id="book-content" class="book-content-wrapper">
      <div class="container preview-main">
        <!-- Page Header -->
        <div class="preview-card">
          <div class="preview-card-header">
            <div>
              <h2 class="preview-title">Hi, <span id="buyer-name" class="buyer-name">there</span>!</h2>
              <p class="preview-subtitle">
                Review your personalized book for <span id="child-name" class="font-semibold">your child</span>
              </p>
            </div>
            <div class="header-actions">
              <Button variant="secondary" size="lg" class="btn-revision" type="button">I need a correction</Button>
              <Button size="lg" class="btn-approve" type="button">Approve Book</Button>
            </div>
          </div>
        </div>

        <!-- Preview Area (PDF Viewer) -->
        <div class="preview-card preview-area">
          <div id="pdf-viewer-container" style="display: none;">
            <div class="spread-header">
              <span class="spread-info">Spread <span id="current-spread">1</span> of <span id="total-spreads">10</span><span id="spread-label" class="spread-label"></span></span>
              <div class="spread-controls">
                <button id="prev-spread" class="spread-nav-btn" aria-label="Previous spread" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"></path>
                  </svg>
                </button>
                <button id="next-spread" class="spread-nav-btn" aria-label="Next spread">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
            <div class="spread-viewer">
              <div class="spread-container">
                <div class="two-page-spread">
                  <div class="white-page"></div>
                  <div id="spread-content" class="spread-content">
                    <!-- Pages will be inserted here -->
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div id="preview-placeholder" class="preview-placeholder">
            <svg class="placeholder-icon" xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <h3 class="placeholder-title">Loading Preview...</h3>
            <p class="placeholder-text">Loading your book preview...</p>
          </div>
        </div>

        <!-- Order Details -->
        <div id="order-details-card" class="preview-card">
          <h3 class="card-title">Order Details</h3>
          <div class="order-details-grid">
            <div>
              <p class="detail-label">Order ID</p>
              <p id="order-id" class="detail-value"></p>
            </div>
            <div id="age-detail" style="display: none;">
              <p class="detail-label">Age</p>
              <p id="age-value" class="detail-value"></p>
            </div>
          </div>
        </div>

        <!-- Correction Request -->
        <div id="correction-card" class="preview-card correction-card">
          <div class="correction-header">
            <div>
              <h3 class="card-title">Need a correction?</h3>
              <p id="correction-availability" class="correction-availability">You have 1 correction available.</p>
            </div>
          </div>
          <div id="correction-locked" class="locked-banner" style="display: none;">
            We already received your correction. If you need more help, reply to our email thread and our team will assist.
          </div>
          <div id="correction-success" class="success-banner" style="display: none;">
            Thank you! We received your correction. We’ll review it and follow up shortly.
          </div>
          <form id="correction-form" class="correction-form">
            <div class="form-group">
              <label class="form-label" for="contact-email">{requireEmail ? 'Your email' : 'Your email (optional)'}</label>
              <input type="email" id="contact-email" class="form-input" placeholder="you@example.com" required={requireEmail ? true : undefined} />
            </div>
            <div class="form-group">
              <label class="form-label" for="contact-email-confirm">{requireEmail ? 'Confirm email' : 'Confirm email (optional)'}</label>
              <input type="email" id="contact-email-confirm" class="form-input" placeholder="Re-enter your email" required={requireEmail ? true : undefined} />
            </div>
            <div class="form-group">
              <label class="form-label" for="reason-select">What needs fixing?</label>
              <select id="reason-select" class="form-input" required>
                <option value="">Select a correction</option>
              </select>
            </div>
            <div id="reason-banner" class="reason-banner" style="display: none;"></div>
            <div id="reason-fields" class="reason-fields"></div>
            <div id="correction-error" class="correction-error" style="display: none;"></div>
            <label class="checkbox-label marketing-opt">
              <input type="checkbox" id="marketing-opt-in" />
              <span>Keep me posted on new titles and promos for Little Hero Labs.</span>
            </label>
            <div id="policy-box" class="policy-box">
              We can adjust details to match the options you selected (name spelling, preset hair style/color, skin tone, pronouns, etc.). We can’t create brand-new art or styles beyond the choices shown.
            </div>
            <div class="correction-actions">
              <Button size="md" class="correction-submit-btn" type="submit">Send correction</Button>
            </div>
          </form>
        </div>
        </div>
      </div>
    </div>

    <!-- Approval Modal -->
    <div id="approval-modal" class="modal" style="display: none;">
      <div class="modal-content">
        <h3 class="modal-title">Approve Your Book</h3>
        <div class="modal-body">
          <div class="warning-box">
            <p class="warning-title">⚠️ Important Information:</p>
            <ul class="warning-list">
              <li>Changes after approval will incur additional charges</li>
              <li>Your book will be printed and shipped within 5-7 business days after approval</li>
              <li>If you do not respond within 3 days, your book will be automatically approved and sent to print</li>
              <li>By approving, you confirm the book is correct and ready for printing</li>
            </ul>
          </div>
          <div id="last-revision-checkbox-container" class="checkbox-container" style="display: none;">
            <label class="checkbox-label">
              <input type="checkbox" id="acknowledge-last-revision" />
              <span>I confirm the book is correct and ready to print immediately.</span>
            </label>
          </div>
        </div>
        <div class="modal-actions">
          <Button variant="secondary" size="md" class="modal-cancel" type="button">Cancel</Button>
          <Button size="md" class="btn-approval-confirm" type="button" disabled>Approve Book</Button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ token, requireEmail }} is:inline>
  // Determine API base URL based on environment
  // In production, use the live backend; in development, use localhost
  const isProduction = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
  const API_BASE = isProduction 
    ? 'https://admin.littleherolabs.com'
    : 'http://localhost:3000';
  const HAIR_STYLES = ['afro', 'bun', 'curly-long', 'curly-medium', 'curly-short', 'pigtails', 'pom-poms', 'ponytail', 'side-part', 'straight-long', 'straight-medium', 'straight-short'];
  const HAIR_COLORS = ['blonde', 'strawberry-blonde', 'light-brown', 'medium-brown', 'dark-brown', 'auburn', 'black', 'red'];
  const SKIN_TONES = ['skin-light', 'skin-medium', 'skin-tan', 'skin-brown-light', 'skin-brown-deep'];
  const PRONOUNS = ['she/her', 'he/him', 'they/them'];
  const ANIMAL_GUIDES = ['dog', 'cat', 'owl', 'lion', 'tiger', 'penguin', 't-rex', 'unicorn'];
  const FAVORITE_COLORS = ['red', 'orange', 'yellow', 'green', 'blue', 'pink', 'purple', 'brown', 'black'];
  const CLOTHING_STYLES = ['tee-shorts', 'dress'];

  const REASON_DEFINITIONS = [
    { id: 'name_typo', label: 'Name spelling is wrong', fields: [{ id: 'newName', label: 'Correct spelling', type: 'text', maxLength: 20, required: true, placeholder: 'Updated spelling' }] },
    { id: 'hairStyle_wrong', label: 'Hair style is wrong', fields: [{ id: 'hairStyle', label: 'Choose the hair style you selected', type: 'select', options: HAIR_STYLES, required: true }] },
    { id: 'hairColor_wrong', label: 'Hair color is wrong', fields: [{ id: 'hairColor', label: 'Pick the hair color you wanted', type: 'select', options: HAIR_COLORS, required: true }] },
    { id: 'skinTone_wrong', label: 'Skin tone is wrong', fields: [{ id: 'skinTone', label: 'Pick the skin tone you selected', type: 'select', options: SKIN_TONES, required: true }] },
    { id: 'pronouns_wrong', label: 'Pronouns are wrong', fields: [{ id: 'pronouns', label: 'Choose the pronouns you wanted', type: 'select', options: PRONOUNS, required: true }] },
    { id: 'animalGuide_wrong', label: 'Animal guide is wrong', fields: [{ id: 'animalGuide', label: 'Pick the animal guide you selected', type: 'select', options: ANIMAL_GUIDES, required: true }] },
    { id: 'favoriteColor_wrong', label: 'Favorite color is wrong', fields: [{ id: 'favoriteColor', label: 'Pick the favorite color you selected', type: 'select', options: FAVORITE_COLORS, required: true }] },
    { id: 'clothingStyle_wrong', label: 'Clothing style is wrong', fields: [{ id: 'clothingStyle', label: 'Choose the clothing style you selected', type: 'select', options: CLOTHING_STYLES, required: true }] },
    { id: 'dedication_fix', label: 'Dedication text needs a fix', fields: [{ id: 'dedication', label: 'Updated dedication message', type: 'textarea', maxLength: 200, required: true, rows: 4, placeholder: 'Enter the corrected dedication text' }] },
    { id: 'hometown_fix', label: 'Hometown text needs a fix', fields: [{ id: 'hometown', label: 'Updated hometown', type: 'text', maxLength: 50, required: true, placeholder: 'City, State' }] },
    { id: 'favoriteFood_fix', label: 'Favorite food text needs a fix', fields: [{ id: 'favoriteFood', label: 'Updated favorite food', type: 'text', maxLength: 30, required: true, placeholder: 'Favorite food' }] },
    { id: 'age_wrong', label: 'Age is wrong', fields: [{ id: 'age', label: 'Correct age (3-8)', type: 'number', min: 3, max: 8, required: true }] },
    {
      id: 'visual_issue',
      label: 'Something looks off (printing or color issue)',
      fields: [
        { id: 'visualIssue', label: 'What kind of issue?', type: 'select', options: ['blurry', 'missing-element', 'odd-colors', 'layout-cutoff', 'other-visual'], required: true },
        { id: 'details', label: 'Any details? (optional)', type: 'text', maxLength: 120, placeholder: 'Brief description' }
      ]
    },
    {
      id: 'other',
      label: 'Other (limited)',
      banner: 'We can fix details you selected on your order. Custom art or new styles aren’t available.',
      fields: [{ id: 'details', label: 'Describe the issue', type: 'text', maxLength: 120, required: true, placeholder: 'Short description (max 120 characters)' }]
    }
  ];

  let orderData = null;
  let correctionUsed = false;

  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorMessage = document.getElementById('error-message');
  const previewContent = document.getElementById('preview-content');
  const childNameEl = document.getElementById('child-name');
  const orderIdEl = document.getElementById('order-id');
  const ageDetail = document.getElementById('age-detail');
  const ageValue = document.getElementById('age-value');
  const approveBtn = document.querySelector('.btn-approve');
  const approvalModal = document.getElementById('approval-modal');
  const acknowledgeCheckbox = document.getElementById('acknowledge-last-revision');
  const lastRevisionContainer = document.getElementById('last-revision-checkbox-container');
  const approvalConfirmBtn = document.querySelector('.btn-approval-confirm');

  const correctionAvailability = document.getElementById('correction-availability');
  const correctionForm = document.getElementById('correction-form');
  const correctionSuccess = document.getElementById('correction-success');
  const correctionLocked = document.getElementById('correction-locked');
  const correctionSubmit = document.querySelector('.correction-submit-btn');
  const correctionError = document.getElementById('correction-error');
  const reasonSelect = document.getElementById('reason-select');
  const reasonBanner = document.getElementById('reason-banner');
  const reasonFieldsContainer = document.getElementById('reason-fields');
  const marketingOptIn = document.getElementById('marketing-opt-in');
  const contactEmailInput = document.getElementById('contact-email');
  const contactEmailConfirmInput = document.getElementById('contact-email-confirm');
  const revisionBtn = document.querySelector('.btn-revision');
  const correctionCard = document.getElementById('correction-card');
  const orderDetailsCard = document.getElementById('order-details-card');
  const buyerNameEl = document.getElementById('buyer-name');
  const curtainHero = document.getElementById('curtain-hero');
  const curtainBuyerNameEl = document.getElementById('curtain-buyer-name');
  const curtainChildNameEl = document.getElementById('curtain-child-name');

  function populateReasonOptions() {
    reasonSelect.innerHTML = '<option value="">Select a correction</option>';
    REASON_DEFINITIONS.forEach((reason) => {
      const option = document.createElement('option');
      option.value = reason.id;
      option.textContent = reason.label;
      reasonSelect.appendChild(option);
    });
  }

  function showError(message) {
    loadingState.style.display = 'none';
    errorState.style.display = 'flex';
    errorMessage.textContent = message;
  }

  function showPreview() {
    loadingState.style.display = 'none';
    previewContent.style.display = 'block';
  }

  async function loadPreview() {
    try {
      const response = await fetch(`${API_BASE}/api/preview/validate-token`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await response.json();

      if (!response.ok || !data.valid) {
        showError(data.error || 'Invalid or expired token');
        return;
      }

      if (!data.order) {
        showError('Order not found');
        return;
      }

      orderData = data.order;
      displayOrder(orderData);
      showPreview();
    } catch (error) {
      console.error('Error loading preview:', error);
      showError(error.message || 'Failed to load preview');
    }
  }

  // PDF Viewer state
  let spreads = [];
  let currentSpreadIndex = 0;
  const pdfViewerContainer = document.getElementById('pdf-viewer-container');
  const previewPlaceholder = document.getElementById('preview-placeholder');
  const spreadContent = document.getElementById('spread-content');
  const currentSpreadEl = document.getElementById('current-spread');
  const totalSpreadsEl = document.getElementById('total-spreads');
  const spreadLabelEl = document.getElementById('spread-label');
  const prevSpreadBtn = document.getElementById('prev-spread');
  const nextSpreadBtn = document.getElementById('next-spread');

  // Create spreads from pages (similar to order page logic)
  function createSpreads(pages, coverImageUrl) {
    const spreads = [];
    
    // Add front cover spread if cover is available
    if (coverImageUrl) {
      spreads.push({
        spreadNumber: 0,
        isCover: true,
        isBackCover: false,
        coverImageUrl: coverImageUrl
      });
    }
    
    // Find dedication page (page 0) and story pages (pages 1-15)
    const dedicationPage = pages.find(p => p.pageNumber === 0);
    const storyPages = pages.filter(p => p.pageNumber >= 1).sort((a, b) => a.pageNumber - b.pageNumber);
    
    // Add dedication spread (blank left, page00 right)
    if (dedicationPage) {
      spreads.push({
        spreadNumber: spreads.length,
        isCover: false,
        isBackCover: false,
        leftPage: null,
        rightPage: dedicationPage
      });
    }
    
    // Interior spreads: pair story pages (1-2, 3-4, 5-6, etc.)
    for (let i = 0; i < storyPages.length; i += 2) {
      spreads.push({
        spreadNumber: spreads.length,
        isCover: false,
        isBackCover: false,
        leftPage: storyPages[i],
        rightPage: storyPages[i + 1] || null
      });
    }
    
    // Add back cover spread if cover is available
    if (coverImageUrl) {
      spreads.push({
        spreadNumber: spreads.length,
        isCover: false,
        isBackCover: true,
        coverImageUrl: coverImageUrl
      });
    }
    
    return spreads;
  }

  // Load pages from manifest
  async function loadPages(orderId) {
    try {
      const manifest3Key = `book-mvp-simple-adventure/orders/${orderId}/manifests/3-manifest.json`;
      const manifest3Url = `${API_BASE}/api/manifests/${manifest3Key}?v=${Date.now()}`;
      
      const response = await fetch(manifest3Url, { cache: 'no-store' });
      if (!response.ok) {
        console.warn('[Preview] Manifest not found, pages may not be ready yet');
        return { pages: [], coverImageUrl: null };
      }
      
      const manifest3Raw = await response.json();
      const manifest3 = Array.isArray(manifest3Raw) ? manifest3Raw[0] : manifest3Raw;
      
      // Handle nested manifest structure
      const manifest = manifest3?.manifest || manifest3;
      
      // Get page preview images
      let previewImages = manifest?.pagePreviewImages 
        || manifest3?.pagePreviewImages
        || manifest?.bookAssembly?.pagePreviewImages 
        || [];
      
      // Fallback: Build from pngGeneration.pages
      if (!previewImages || previewImages.length === 0) {
        const pagesObj = manifest?.pngGeneration?.pages || {};
        if (pagesObj && Object.keys(pagesObj).length > 0) {
          console.log('[Preview] Building previewImages from pngGeneration.pages, found keys:', Object.keys(pagesObj));
          previewImages = Object.entries(pagesObj)
            .map(([key, r2Key]) => {
              let pageNumber = 0;
              if (key === 'p00_dedication' || key === 'p00') {
                pageNumber = 0;
              } else if (key.startsWith('p')) {
                const num = parseInt(key.substring(1), 10);
                if (!isNaN(num)) pageNumber = num;
              }
              return {
                pageNumber,
                r2Key: typeof r2Key === 'string' ? r2Key : null,
                imageUrl: typeof r2Key === 'string' ? `${API_BASE}/api/assets/${r2Key}` : null
              };
            })
            .filter(img => img.r2Key); // Remove entries without r2Key
          
          // Deduplicate page 0 (prefer p00_dedication)
          const page0Entries = previewImages.filter(p => p.pageNumber === 0);
          if (page0Entries.length > 1) {
            const dedication = page0Entries.find(p => p.r2Key?.includes('dedication'));
            if (dedication) {
              previewImages = previewImages.filter(p => !(p.pageNumber === 0 && p.r2Key !== dedication.r2Key));
            }
          }
          console.log('[Preview] Built previewImages from pngGeneration.pages:', previewImages.length, 'pages');
        }
      }
      
      console.log('[Preview] Total previewImages found:', previewImages.length);
      
      // Get Cloudflare Images URLs if available
      // pagesWithCloudflare is an object keyed by page keys (p01, p02, etc.), not an array
      const pagesWithCloudflare = manifest?.pngGeneration?.pagesWithCloudflare 
        || manifest3?.pngGeneration?.pagesWithCloudflare 
        || {};
      
      // Build page data array
      // Ensure previewImages is an array before mapping
      // Priority: Use Cloudflare Images URLs (preview/watermarked versions) when available
      const isValidCloudflareUrl = (url) => {
        if (!url || typeof url !== 'string') return false;
        // Must be a valid Cloudflare Images URL: https://imagedelivery.net/{accountHash}/{imageId}/{variant}
        return url.startsWith('https://imagedelivery.net/') && url.split('/').length >= 5;
      };
      
      const pages = (Array.isArray(previewImages) ? previewImages : []).map((img) => {
        const pageNum = Number(img.pageNumber || 0);
        // Generate page key for Cloudflare lookup (p00_dedication for page 0, p01 for page 1, etc.)
        const pageKey = pageNum === 0 ? 'p00_dedication' : (pageNum < 10 ? `p0${pageNum}` : `p${pageNum}`);
        
        // Get Cloudflare Images data from pagesWithCloudflare object
        // For page 0, check both p00_dedication and p00 keys
        const cfData = pageNum === 0 
          ? (pagesWithCloudflare['p00_dedication'] || pagesWithCloudflare['p00'] || null)
          : (pagesWithCloudflare[pageKey] || null);
        const cloudflareImageUrl = img.cloudflareImageUrl || cfData?.cloudflareImageUrl || null;
        
        // Priority 1: Use Cloudflare Images URL if available (preview/watermarked, WebP, CDN)
        if (cloudflareImageUrl && isValidCloudflareUrl(cloudflareImageUrl)) {
          return {
            pageNumber: pageNum,
            imageUrl: cloudflareImageUrl
          };
        }
        // Priority 2: Use imageUrl from previewImages if it's a Cloudflare URL
        else if (img.imageUrl && isValidCloudflareUrl(img.imageUrl)) {
          return {
            pageNumber: pageNum,
            imageUrl: img.imageUrl
          };
        }
        // Priority 3: Use imageUrl from previewImages (R2 proxy)
        else if (img.imageUrl) {
          return {
            pageNumber: pageNum,
            imageUrl: img.imageUrl
          };
        }
        // Priority 4: Fallback to R2 key
        else if (img.r2Key) {
          return {
            pageNumber: pageNum,
            imageUrl: `${API_BASE}/api/assets/${img.r2Key}`
          };
        }
        return null;
      }).filter(p => p && p.imageUrl); // Only include pages with valid URLs
      
      // Sort pages by pageNumber to ensure correct order
      pages.sort((a, b) => a.pageNumber - b.pageNumber);
      
      console.log('[Preview] Final pages array:', pages.length, 'pages', pages.map(p => `p${p.pageNumber}`));
      
      // Get cover image URL
      const coverImageUrl = manifest?.coverImageUrl 
        || manifest3?.coverImageUrl
        || manifest?.bookAssembly?.coverImageUrl
        || null;
      
      return { pages, coverImageUrl };
    } catch (error) {
      console.error('[Preview] Error loading pages:', error);
      return { pages: [], coverImageUrl: null };
    }
  }

  // Render current spread
  function renderSpread(spread) {
    if (!spreadContent) return;
    
    spreadContent.innerHTML = '';
    
    if (spread.isCover && spread.coverImageUrl) {
      // Render cover
      const coverContainer = document.createElement('div');
      coverContainer.className = spread.isBackCover ? 'cover-image-container back-cover' : 'cover-image-container front-cover';
      const img = document.createElement('img');
      img.alt = spread.isBackCover ? 'Back Cover' : 'Front Cover';
      img.src = spread.coverImageUrl;
      img.className = 'cover-image';
      coverContainer.appendChild(img);
      spreadContent.appendChild(coverContainer);
    } else {
      // Render two-page spread
      if (spread.leftPage) {
        const leftImg = document.createElement('img');
        leftImg.alt = `Page ${spread.leftPage.pageNumber}`;
        leftImg.src = spread.leftPage.imageUrl;
        leftImg.className = 'page-image left-page';
        spreadContent.appendChild(leftImg);
      }
      
      if (spread.rightPage) {
        const rightImg = document.createElement('img');
        rightImg.alt = `Page ${spread.rightPage.pageNumber}`;
        rightImg.src = spread.rightPage.imageUrl;
        rightImg.className = 'page-image right-page';
        spreadContent.appendChild(rightImg);
      }
    }
    
    // Update spread info
    if (currentSpreadEl) currentSpreadEl.textContent = String(spread.spreadNumber + 1);
    if (totalSpreadsEl) totalSpreadsEl.textContent = String(spreads.length);
    
    // Update spread label
    if (spreadLabelEl) {
      if (spread.isCover && !spread.isBackCover) {
        spreadLabelEl.textContent = ' (Front Cover)';
      } else if (spread.isBackCover) {
        spreadLabelEl.textContent = ' (Back Cover)';
      } else {
        spreadLabelEl.textContent = '';
      }
    }
    
    // Update navigation buttons
    if (prevSpreadBtn) prevSpreadBtn.disabled = currentSpreadIndex === 0;
    if (nextSpreadBtn) nextSpreadBtn.disabled = currentSpreadIndex === spreads.length - 1;
  }

  // Navigate spreads
  function goToSpread(index) {
    if (index < 0 || index >= spreads.length) return;
    currentSpreadIndex = index;
    renderSpread(spreads[currentSpreadIndex]);
  }

  function displayOrder(order) {
    const childName = order.characterSpecs?.childName || 'your child';
    const buyerName = order.customerName || 'there';
    buyerNameEl.textContent = buyerName;
    childNameEl.textContent = childName;
    
    // Update curtain hero section
    if (curtainBuyerNameEl) curtainBuyerNameEl.textContent = buyerName;
    if (curtainChildNameEl) curtainChildNameEl.textContent = childName;

    const displayOrderId = order.amazonOrderId || order.orderId;
    orderIdEl.textContent = displayOrderId;

    if (order.characterSpecs?.age) {
      ageDetail.style.display = 'block';
      ageValue.textContent = `${order.characterSpecs.age} years old`;
    }

    updateCorrectionState(order);

    if (approveBtn) {
      approveBtn.disabled = false;
    }
    
    // Load and display PDF pages
    loadPagesAndDisplay(order.orderId);
  }

  async function loadPagesAndDisplay(orderId) {
    try {
      const { pages, coverImageUrl } = await loadPages(orderId);
      
      if (pages.length === 0) {
        // No pages available yet, keep showing placeholder
        if (previewPlaceholder) {
          previewPlaceholder.querySelector('.placeholder-title').textContent = 'Preview Not Ready';
          previewPlaceholder.querySelector('.placeholder-text').textContent = 'The book preview is being generated. Please check back soon.';
        }
        return;
      }
      
      // Create spreads
      spreads = createSpreads(pages, coverImageUrl);
      
      if (spreads.length === 0) {
        console.warn('[Preview] No spreads created from pages');
        return;
      }
      
      // Hide placeholder and show viewer
      if (previewPlaceholder) previewPlaceholder.style.display = 'none';
      if (pdfViewerContainer) pdfViewerContainer.style.display = 'block';
      
      // Render first spread
      currentSpreadIndex = 0;
      renderSpread(spreads[0]);
    } catch (error) {
      console.error('[Preview] Error loading pages:', error);
      // Keep placeholder visible on error
    }
  }

  function updateCorrectionState(order) {
    correctionUsed = (order.revisionCount || 0) >= 1;

    if (correctionUsed) {
      correctionAvailability.textContent = 'Correction already submitted';
      correctionAvailability.classList.add('correction-used');
      correctionForm.style.display = 'none';
      correctionLocked.style.display = 'block';
      correctionSuccess.style.display = 'block';
      lastRevisionContainer.style.display = 'block';
      if (approvalConfirmBtn) {
        approvalConfirmBtn.disabled = !acknowledgeCheckbox.checked;
      }
      if (revisionBtn) {
        revisionBtn.textContent = 'View correction details';
        revisionBtn.classList.add('correction-used');
      }
    } else {
      correctionAvailability.textContent = 'You have 1 correction available.';
      correctionAvailability.classList.remove('correction-used');
      correctionForm.style.display = 'block';
      correctionLocked.style.display = 'none';
      correctionSuccess.style.display = 'none';
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';
      lastRevisionContainer.style.display = 'none';
      acknowledgeCheckbox.checked = false;
      if (approvalConfirmBtn) {
        approvalConfirmBtn.disabled = false;
      }
      if (revisionBtn) {
        revisionBtn.textContent = 'I need a correction';
        revisionBtn.classList.remove('correction-used');
      }
    }
  }

  function renderReasonFields(reasonId) {
    reasonFieldsContainer.innerHTML = '';
    correctionError.style.display = 'none';

    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);
    if (!reason) {
      reasonBanner.style.display = 'none';
      return;
    }

    if (reason.banner) {
      reasonBanner.textContent = reason.banner;
      reasonBanner.style.display = 'block';
    } else {
      reasonBanner.style.display = 'none';
    }

    reason.fields.forEach((field) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'form-group';

      const label = document.createElement('label');
      label.className = 'form-label';
      label.htmlFor = `field-${field.id}`;
      label.textContent = field.label;

      let input;
      if (field.type === 'select') {
        input = document.createElement('select');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.required = !!field.required;
        input.innerHTML = '<option value="">Select an option</option>';
        field.options.forEach((optionValue) => {
          const option = document.createElement('option');
          option.value = optionValue;
          option.textContent = optionValue;
          input.appendChild(option);
        });
      } else if (field.type === 'textarea') {
        input = document.createElement('textarea');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.rows = field.rows || 4;
        input.maxLength = field.maxLength || 500;
        input.placeholder = field.placeholder || '';
        if (field.required) input.required = true;
      } else {
        input = document.createElement('input');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.type = field.type === 'number' ? 'number' : 'text';
        if (field.type === 'number') {
          if (typeof field.min === 'number') input.min = field.min;
          if (typeof field.max === 'number') input.max = field.max;
        }
        if (field.maxLength) input.maxLength = field.maxLength;
        if (field.placeholder) input.placeholder = field.placeholder;
        if (field.required) input.required = true;
      }

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      reasonFieldsContainer.appendChild(wrapper);
    });
  }

  function collectFieldValues(reason) {
    const values = {};
    if (!reason) return values;

    reason.fields.forEach((field) => {
      const input = document.getElementById(`field-${field.id}`);
      if (!input) return;

      if (field.type === 'number') {
        const numericValue = input.value ? Number(input.value) : null;
        if (numericValue !== null && !Number.isNaN(numericValue)) {
          values[field.id] = numericValue;
        }
      } else {
        const value = input.value.trim();
        if (value) {
          values[field.id] = value;
        }
      }
    });

    return values;
  }

  async function handleCorrectionSubmit(event) {
    event.preventDefault();
    correctionError.style.display = 'none';

    if (!orderData) return;
    if (!correctionSubmit) return;
    if (correctionUsed) {
      correctionError.textContent = 'You have already used your correction for this order.';
      correctionError.style.display = 'block';
      return;
    }

    const reasonId = reasonSelect.value;
    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);

    if (!reasonId || !reason) {
      correctionError.textContent = 'Please choose what needs fixing.';
      correctionError.style.display = 'block';
      return;
    }

    const emailRaw = contactEmailInput.value.trim();
    const emailConfirmRaw = contactEmailConfirmInput.value.trim();
    let emailToSend = null;

    if (requireEmail) {
      if (!emailRaw || !emailConfirmRaw) {
        correctionError.textContent = 'Please enter and confirm your email address.';
        correctionError.style.display = 'block';
        return;
      }

      if (emailRaw.toLowerCase() !== emailConfirmRaw.toLowerCase()) {
        correctionError.textContent = 'Email addresses do not match. Please re-type them.';
        correctionError.style.display = 'block';
        return;
      }

      emailToSend = emailRaw;
    } else if (emailRaw || emailConfirmRaw) {
      if (!emailRaw || !emailConfirmRaw) {
        correctionError.textContent =
          'Please enter and confirm your email address, or leave both fields blank.';
        correctionError.style.display = 'block';
        return;
      }

      if (emailRaw.toLowerCase() !== emailConfirmRaw.toLowerCase()) {
        correctionError.textContent = 'Email addresses do not match. Please re-type them.';
        correctionError.style.display = 'block';
        return;
      }

      emailToSend = emailRaw;
    }

    const fields = collectFieldValues(reason);

    const missingField = reason.fields.find((field) => field.required && !fields[field.id]);
    if (missingField) {
      correctionError.textContent = 'Please fill out the required fields.';
      correctionError.style.display = 'block';
      return;
    }

    correctionSubmit.disabled = true;
    correctionSubmit.textContent = 'Sending...';

    try {
      /** @type {Record<string, unknown>} */
      const payload = {
        orderId: orderData.orderId,
        token,
        reason: reasonId,
        fields,
        marketingOptIn: marketingOptIn.checked
      };

      if (orderData.amazonOrderId) {
        payload.amazonOrderId = orderData.amazonOrderId;
      }

      if (orderData.customerName && orderData.customerName.trim().length > 0) {
        payload.name = orderData.customerName;
      }

      if (emailToSend && emailToSend.trim().length > 0) {
        payload.email = emailToSend.trim();
      }

      const response = await fetch(`${API_BASE}/api/preview/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Failed to send correction');
      }

      correctionForm.reset();
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';
      correctionSuccess.style.display = 'block';
      correctionLocked.style.display = 'none';

      orderData.revisionCount = (orderData.revisionCount || 0) + 1;
      updateCorrectionState(orderData);
    } catch (error) {
      console.error('Error submitting correction:', error);
      correctionError.textContent = error.message || 'Failed to send correction. Please try again or email us.';
      correctionError.style.display = 'block';
    } finally {
      correctionSubmit.disabled = false;
      correctionSubmit.textContent = 'Send correction';
    }
  }

  async function handleApprove() {
    if (!orderData || !token) return;

    if (correctionUsed && !acknowledgeCheckbox.checked) {
      alert('Please confirm you are ready to send your book to print.');
      return;
    }

    if (approveBtn) {
      approveBtn.disabled = true;
      approveBtn.textContent = 'Approving...';
    }

    try {
      const response = await fetch(`${API_BASE}/api/preview/${orderData.orderId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Failed to approve');
      }

      /** @type {Error | null} */
      let printTriggerError = null;
      try {
        const printResponse = await fetch(`${API_BASE}/api/orders/${orderData.orderId}/print`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ source: 'customer-approval' })
        });

        if (!printResponse.ok) {
          const error = await printResponse.json().catch(() => null);
          throw new Error(error?.error || 'Failed to notify print service');
        }
      } catch (error) {
        console.error('Error triggering print workflow:', error);
        printTriggerError =
          error instanceof Error
            ? error
            : new Error('Failed to notify print service');
      }

      if (printTriggerError) {
        alert(
          `Book approval recorded, but print service could not be notified: ${printTriggerError.message}`
        );
      } else {
        alert('Book Successfully Sent to Print Service');
      }

      window.location.href = `/order-status/${orderData.orderId}?token=${token}`;
    } catch (error) {
      console.error('Error approving:', error);
      alert(error.message || 'Failed to approve book. Please try again.');
      if (approveBtn) {
        approveBtn.disabled = false;
        approveBtn.textContent = 'Approve Book';
      }
    }
  }

  populateReasonOptions();
  reasonSelect.addEventListener('change', (event) => {
    const target = event.target;
    const value =
      target && target instanceof HTMLSelectElement ? target.value : '';
    renderReasonFields(value);
  });
  correctionForm.addEventListener('submit', handleCorrectionSubmit);

  if (approveBtn) {
    approveBtn.addEventListener('click', () => {
      approvalModal.style.display = 'flex';
    });
  }

  const modalCancelBtn = document.querySelector('.modal-cancel');
  if (modalCancelBtn) {
    modalCancelBtn.addEventListener('click', () => {
      approvalModal.style.display = 'none';
    });
  }

  if (approvalConfirmBtn) {
    approvalConfirmBtn.addEventListener('click', handleApprove);
  }

  if (revisionBtn) {
    revisionBtn.addEventListener('click', () => {
      const target = orderDetailsCard || correctionCard;
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        target.classList.add('jump-highlight');
        setTimeout(() => target.classList.remove('jump-highlight'), 800);
      }
    });
  }

  acknowledgeCheckbox.addEventListener('change', () => {
    if (approvalConfirmBtn) {
      approvalConfirmBtn.disabled = correctionUsed && !acknowledgeCheckbox.checked;
    }
  });

  // PDF Viewer navigation
  if (prevSpreadBtn) {
    prevSpreadBtn.addEventListener('click', () => {
      goToSpread(currentSpreadIndex - 1);
    });
  }

  if (nextSpreadBtn) {
    nextSpreadBtn.addEventListener('click', () => {
      goToSpread(currentSpreadIndex + 1);
    });
  }

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (pdfViewerContainer && pdfViewerContainer.style.display !== 'none') {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goToSpread(currentSpreadIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goToSpread(currentSpreadIndex + 1);
      }
    }
  });

  // Curtain reveal scroll effect
  // The curtain scrolls up while page content stays fixed, then page scrolls normally
  const curtainScrollArea = document.getElementById('curtain-scroll-area');
  let curtainScrollPosition = 0; // 0 to 1, represents how much curtain is lifted
  let curtainFullyLifted = false;
  let wheelListenersActive = true;
  
  // Helper function to log comprehensive DOM measurements
  function logDOMPositions(label) {
    const curtain = curtainHero;
    const pageContent = document.getElementById('book-content');
    const curtainScrollAreaEl = curtainScrollArea;
    const html = document.documentElement;
    const body = document.body;
    
    const curtainRect = curtain ? curtain.getBoundingClientRect() : null;
    const pageContentRect = pageContent ? pageContent.getBoundingClientRect() : null;
    const scrollAreaRect = curtainScrollAreaEl ? curtainScrollAreaEl.getBoundingClientRect() : null;
    
    const curtainComputed = curtain ? window.getComputedStyle(curtain) : null;
    const pageContentComputed = pageContent ? window.getComputedStyle(pageContent) : null;
    const pageContentInline = pageContent ? {
      position: pageContent.style.position || 'none',
      top: pageContent.style.top || 'none',
      left: pageContent.style.left || 'none',
      width: pageContent.style.width || 'none',
      zIndex: pageContent.style.zIndex || 'none',
      transform: pageContent.style.transform || 'none'
    } : null;
    
    const curtainInline = curtain ? {
      transform: curtain.style.transform || 'none',
      position: curtain.style.position || 'none',
      top: curtain.style.top || 'none',
      left: curtain.style.left || 'none',
      width: curtain.style.width || 'none',
      height: curtain.style.height || 'none'
    } : null;
    
    console.log(`[CURTAIN] 📐📐📐 DOM POSITIONS: ${label}`, {
      timestamp: new Date().toISOString(),
      
      // Window/Document measurements
      windowScrollY: window.pageYOffset?.toFixed(2),
      windowScrollX: window.pageXOffset?.toFixed(2),
      windowInnerHeight: window.innerHeight.toFixed(2),
      windowInnerWidth: window.innerWidth.toFixed(2),
      documentScrollTop: (html.scrollTop || 0).toFixed(2),
      documentScrollLeft: (html.scrollLeft || 0).toFixed(2),
      bodyScrollTop: (body.scrollTop || 0).toFixed(2),
      bodyScrollLeft: (body.scrollLeft || 0).toFixed(2),
      documentScrollHeight: html.scrollHeight.toFixed(2),
      documentClientHeight: html.clientHeight.toFixed(2),
      bodyScrollHeight: body.scrollHeight.toFixed(2),
      bodyClientHeight: body.clientHeight.toFixed(2),
      
      // Curtain element measurements
      curtain: curtainRect ? {
        top: curtainRect.top.toFixed(2),
        left: curtainRect.left.toFixed(2),
        right: curtainRect.right.toFixed(2),
        bottom: curtainRect.bottom.toFixed(2),
        width: curtainRect.width.toFixed(2),
        height: curtainRect.height.toFixed(2),
        x: curtainRect.x.toFixed(2),
        y: curtainRect.y.toFixed(2)
      } : 'NOT FOUND',
      curtainComputed: curtainComputed ? {
        position: curtainComputed.position,
        top: curtainComputed.top,
        left: curtainComputed.left,
        width: curtainComputed.width,
        height: curtainComputed.height,
        transform: curtainComputed.transform,
        zIndex: curtainComputed.zIndex,
        display: curtainComputed.display,
        visibility: curtainComputed.visibility,
        pointerEvents: curtainComputed.pointerEvents
      } : 'NOT FOUND',
      curtainInline: curtainInline || 'NOT FOUND',
      
      // Page content element measurements
      pageContent: pageContentRect ? {
        top: pageContentRect.top.toFixed(2),
        left: pageContentRect.left.toFixed(2),
        right: pageContentRect.right.toFixed(2),
        bottom: pageContentRect.bottom.toFixed(2),
        width: pageContentRect.width.toFixed(2),
        height: pageContentRect.height.toFixed(2),
        x: pageContentRect.x.toFixed(2),
        y: pageContentRect.y.toFixed(2)
      } : 'NOT FOUND',
      pageContentComputed: pageContentComputed ? {
        position: pageContentComputed.position,
        top: pageContentComputed.top,
        left: pageContentComputed.left,
        width: pageContentComputed.width,
        height: pageContentComputed.height,
        transform: pageContentComputed.transform,
        zIndex: pageContentComputed.zIndex,
        display: pageContentComputed.display,
        marginTop: pageContentComputed.marginTop,
        marginLeft: pageContentComputed.marginLeft,
        paddingTop: pageContentComputed.paddingTop,
        paddingLeft: pageContentComputed.paddingLeft
      } : 'NOT FOUND',
      pageContentInline: pageContentInline || 'NOT FOUND',
      
      // Scroll area measurements
      scrollArea: scrollAreaRect ? {
        top: scrollAreaRect.top.toFixed(2),
        left: scrollAreaRect.left.toFixed(2),
        right: scrollAreaRect.right.toFixed(2),
        bottom: scrollAreaRect.bottom.toFixed(2),
        width: scrollAreaRect.width.toFixed(2),
        height: scrollAreaRect.height.toFixed(2),
        x: scrollAreaRect.x.toFixed(2),
        y: scrollAreaRect.y.toFixed(2)
      } : 'NOT FOUND',
      
      // State variables
      curtainScrollPosition: curtainScrollPosition.toFixed(3),
      curtainFullyLifted,
      wheelListenersActive,
      
      // Visual relationship calculations
      curtainTopToViewportTop: curtainRect ? (curtainRect.top - 0).toFixed(2) : 'N/A',
      pageContentTopToViewportTop: pageContentRect ? (pageContentRect.top - 0).toFixed(2) : 'N/A',
      pageContentTopToCurtainTop: curtainRect && pageContentRect ? (pageContentRect.top - curtainRect.top).toFixed(2) : 'N/A'
    });
  }
  
  // Verbose logging
  console.log('[CURTAIN] Initialized:', {
    curtainScrollPosition,
    curtainFullyLifted,
    wheelListenersActive
  });

  function updateCurtainPosition() {
    console.log('[CURTAIN] 🔧 updateCurtainPosition CALLED', {
      timestamp: new Date().toISOString(),
      curtainScrollPosition: curtainScrollPosition.toFixed(3),
      curtainFullyLifted,
      hasCurtainHero: !!curtainHero
    });
    
    // Log DOM positions at start
    logDOMPositions('updateCurtainPosition START');
    
    if (!curtainHero) {
      console.warn('[CURTAIN] ⚠️ updateCurtainPosition: curtainHero not found, ABORTING');
      return;
    }
    
    // Always update curtain position based on curtainScrollPosition
    const translateY = -100 * curtainScrollPosition;
    curtainHero.style.transform = `translateY(${translateY}%)`;
    
    console.log('[CURTAIN] 📐 Applied transform to curtain:', {
      curtainScrollPosition: curtainScrollPosition.toFixed(3),
      translateY: translateY.toFixed(2) + '%',
      curtainFullyLifted,
      scrollTop: (window.pageYOffset || document.documentElement.scrollTop || 0).toFixed(2)
    });
    
    const pageContent = document.getElementById('book-content');
    
    if (curtainScrollPosition < 1) {
      // Curtain is still visible - lock page content in place
      console.log('[CURTAIN] 👁️ Curtain is VISIBLE (position < 1), locking page content in place');
      
      if (pageContent) {
        const wasFixed = pageContent.style.position === 'fixed';
        pageContent.style.position = 'fixed';
        pageContent.style.top = '0';
        pageContent.style.left = '0';
        pageContent.style.width = '100%';
        pageContent.style.zIndex = '5';
        
        if (!wasFixed) {
          console.log('[CURTAIN] 📌 Changed pageContent to FIXED positioning');
        } else {
          console.log('[CURTAIN] 📌 PageContent already FIXED (maintaining)');
        }
      } else {
        console.warn('[CURTAIN] ⚠️ pageContent element not found');
      }
      
      if (curtainHero.classList.contains('fully-lifted')) {
        console.log('[CURTAIN] 🔄 Removing "fully-lifted" class from curtain');
        curtainHero.classList.remove('fully-lifted');
      }
      
      if (curtainFullyLifted) {
        console.log('[CURTAIN] 🔄 Resetting curtainFullyLifted flag (was true, now false)');
        curtainFullyLifted = false;
      }
      
      console.log('[CURTAIN] ✅ Curtain visible - content locked in place');
      // Log DOM positions after setting fixed
      logDOMPositions('updateCurtainPosition AFTER SETTING FIXED');
    } else {
      // Curtain is fully lifted
      console.log('[CURTAIN] 🚪 Curtain is FULLY LIFTED (position >= 1)');
      curtainScrollPosition = Math.min(curtainScrollPosition, 1);
      
      if (!curtainFullyLifted) {
        console.log('[CURTAIN] ⬆️⬆️⬆️ TRANSITION: Curtain fully lifted - starting transition to normal scroll', {
          curtainScrollPosition: curtainScrollPosition.toFixed(3),
          wasFullyLifted: false,
          willBeFullyLifted: true
        });
        
        // Log DOM positions BEFORE transition
        logDOMPositions('TRANSITION BEFORE - Fixed positioning still active');
        
        curtainFullyLifted = true;
        curtainHero.classList.add('fully-lifted');
        console.log('[CURTAIN] ✅ Set curtainFullyLifted = true and added "fully-lifted" class');
        
        // SIMPLIFIED: Transition from fixed to normal flow
        if (pageContent) {
          console.log('[CURTAIN] 🏗️ Starting simplified transition');
          
          // Lock scroll to prevent drift during transition
          const originalBodyOverflow = document.body.style.overflow;
          const originalHtmlOverflow = document.documentElement.style.overflow;
          document.body.style.overflow = 'hidden';
          document.documentElement.style.overflow = 'hidden';
          
          // Hide content during transition to prevent visual jump
          const originalOpacity = pageContent.style.opacity;
          pageContent.style.opacity = '0';
          pageContent.style.transition = 'opacity 0s'; // Instant hide
          
          // Remove fixed positioning immediately
          pageContent.style.position = '';
          pageContent.style.top = '';
          pageContent.style.left = '';
          pageContent.style.width = '';
          pageContent.style.zIndex = '';
          pageContent.style.transform = '';
          pageContent.style.willChange = '';
          
          console.log('[CURTAIN] ✅ Removed fixed positioning (content hidden)');
          
          // Wait one frame for layout, then measure and adjust scroll
          requestAnimationFrame(() => {
            const contentRect = pageContent.getBoundingClientRect();
            const currentScroll = window.pageYOffset || window.scrollY || document.documentElement.scrollTop || 0;
            const contentTop = contentRect.top;
            const scrollNeeded = currentScroll + contentTop;
            
            console.log('[CURTAIN] 📐 Adjusting scroll:', {
              contentTop: contentTop.toFixed(2),
              currentScroll: currentScroll.toFixed(2),
              scrollNeeded: scrollNeeded.toFixed(2)
            });
            
            // Set scroll to bring content to top (still hidden)
            window.scrollTo({ top: scrollNeeded, left: 0, behavior: 'instant' });
            document.documentElement.scrollTop = scrollNeeded;
            document.body.scrollTop = scrollNeeded;
            
            // Wait one more frame for scroll to settle, then show content and unlock scroll
            requestAnimationFrame(() => {
              // Show content now that scroll is correct
              pageContent.style.opacity = originalOpacity || '1';
              pageContent.style.transition = ''; // Remove transition
              
              // Restore scroll overflow
              document.body.style.overflow = originalBodyOverflow;
              document.documentElement.style.overflow = originalHtmlOverflow;
              
              // Disable wheel listeners
              wheelListenersActive = false;
              window.removeEventListener('wheel', handleScroll, { passive: false });
              window.removeEventListener('DOMMouseScroll', handleScroll, { passive: false });
              
              console.log('[CURTAIN] ✅✅✅ TRANSITION COMPLETE - Normal scrolling enabled');
            });
          });
        } else {
          console.warn('[CURTAIN] ⚠️ pageContent element not found during transition');
          wheelListenersActive = false;
          window.removeEventListener('wheel', handleScroll, { passive: false });
          window.removeEventListener('DOMMouseScroll', handleScroll, { passive: false });
        }
      }
    }
    
    // Log DOM positions at end
    logDOMPositions('updateCurtainPosition END');
    console.log('[CURTAIN] 🏁 updateCurtainPosition COMPLETE');
  }

  function handleScroll(e) {
    console.log('[CURTAIN] 🎡 handleScroll EVENT TRIGGERED', {
      timestamp: new Date().toISOString(),
      eventType: e.type,
      hasCurtainHero: !!curtainHero,
      wheelListenersActive,
      curtainFullyLifted,
      curtainScrollPosition: curtainScrollPosition.toFixed(3)
    });
    
    if (!curtainHero) {
      console.warn('[CURTAIN] ⚠️ handleScroll: curtainHero not found, ABORTING');
      return;
    }
    
    if (!wheelListenersActive) {
      console.log('[CURTAIN] ⏸️ handleScroll: wheel listeners inactive, IGNORING EVENT');
      return;
    }
    
    // Calculate scroll delta - use actual pixel values for normal scroll speed
    const delta = e.deltaY || e.detail || -e.wheelDelta;
    const windowHeight = window.innerHeight;
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    
    // Convert scroll delta to curtain position change (match normal scroll speed)
    // delta is typically 100-200 pixels, we want 1 viewport height to fully lift curtain
    const scrollDelta = delta / windowHeight;
    
    // Update curtain position
    const newPosition = curtainScrollPosition + scrollDelta;
    
    const scrollDirection = delta > 0 ? '⬇️ DOWN' : delta < 0 ? '⬆️ UP' : '↔️ NONE';
    console.log('[CURTAIN] 📊 handleScroll: CALCULATED VALUES', {
      direction: scrollDirection,
      delta: delta.toFixed(2),
      scrollDelta: scrollDelta.toFixed(4),
      windowHeight: windowHeight.toFixed(2),
      currentPosition: curtainScrollPosition.toFixed(3),
      newPosition: newPosition.toFixed(3),
      scrollTop: scrollTop.toFixed(2),
      curtainFullyLifted,
      wheelListenersActive
    });
    
    // Handle scrolling down (revealing curtain) or up (hiding curtain)
    if (delta > 0) {
      // Scrolling down - lift curtain
      console.log('[CURTAIN] ⬇️⬇️⬇️ SCROLLING DOWN - LIFTING CURTAIN', {
        beforePosition: curtainScrollPosition.toFixed(3),
        willReachMax: newPosition >= 1
      });
      
      if (curtainScrollPosition < 1) {
        console.log('[CURTAIN] ✅ Curtain not fully lifted yet, PREVENTING DEFAULT and updating position');
        e.preventDefault();
        const oldPosition = curtainScrollPosition;
        curtainScrollPosition = Math.max(0, Math.min(1, newPosition));
        console.log('[CURTAIN] 📈 Position change:', {
          from: oldPosition.toFixed(3),
          to: curtainScrollPosition.toFixed(3),
          change: (curtainScrollPosition - oldPosition).toFixed(3)
        });
        console.log('[CURTAIN] 🔄 Calling updateCurtainPosition()');
        updateCurtainPosition();
        
        // If fully lifted, prepare for transition
        if (curtainScrollPosition >= 1) {
          console.log('[CURTAIN] 🎯🎯🎯 CURTAIN POSITION REACHED 1.0 (FULLY LIFTED)', {
            position: curtainScrollPosition.toFixed(3),
            message: 'Will transition in updateCurtainPosition'
          });
        }
      } else {
        console.log('[CURTAIN] ⚠️ Curtain already at max position (>= 1), this should not happen here', {
          position: curtainScrollPosition.toFixed(3)
        });
      }
    } else if (delta < 0) {
      // Scrolling up - bring curtain back down
      console.log('[CURTAIN] ⬆️⬆️⬆️ SCROLLING UP - LOWERING CURTAIN', {
        scrollTop: scrollTop.toFixed(2),
        curtainScrollPosition: curtainScrollPosition.toFixed(3),
        newPosition: newPosition.toFixed(3)
      });
      
      // If we're at the top of the page, bring curtain back down
      if (scrollTop <= 0 && curtainScrollPosition > 0) {
        console.log('[CURTAIN] ✅ At top of page (scrollTop <= 0) AND curtain position > 0', {
          scrollTop: scrollTop.toFixed(2),
          curtainPosition: curtainScrollPosition.toFixed(3),
          action: 'Bringing curtain back down'
        });
        e.preventDefault();
        const oldPosition = curtainScrollPosition;
        curtainScrollPosition = Math.max(0, Math.min(1, newPosition));
        console.log('[CURTAIN] 📉 Curtain position change (lowering):', {
          from: oldPosition.toFixed(3),
          to: curtainScrollPosition.toFixed(3),
          change: (curtainScrollPosition - oldPosition).toFixed(3)
        });
        console.log('[CURTAIN] 🔄 Calling updateCurtainPosition() to lower curtain');
        updateCurtainPosition();
      } else if (scrollTop > 0 && curtainScrollPosition >= 1) {
        // We're scrolled down on the page, let normal scroll handle it
        console.log('[CURTAIN] 📄 Scrolled down on page (scrollTop > 0) and curtain fully lifted, ALLOWING NORMAL SCROLL', {
          scrollTop: scrollTop.toFixed(2),
          curtainPosition: curtainScrollPosition.toFixed(3)
        });
        // But if we reach the top, start bringing curtain back
        return;
      } else {
        console.log('[CURTAIN] ❌ Scroll up conditions NOT MET:', {
          scrollTop: scrollTop.toFixed(2),
          curtainScrollPosition: curtainScrollPosition.toFixed(3),
          reason: scrollTop > 0 ? 'Not at top of page' : 'Curtain position is 0'
        });
      }
    } else {
      console.log('[CURTAIN] ⚠️ Delta is 0 or undefined, no action taken', { delta });
    }
    
    console.log('[CURTAIN] 🏁 handleScroll EVENT COMPLETE');
  }

  function handlePageScroll() {
    console.log('[CURTAIN] 📜 handlePageScroll EVENT TRIGGERED', {
      timestamp: new Date().toISOString(),
      hasCurtainHero: !!curtainHero
    });
    
    if (!curtainHero) {
      console.warn('[CURTAIN] ⚠️ handlePageScroll: curtainHero not found, ABORTING');
      return;
    }
    
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    const windowHeight = window.innerHeight;
    const pageContent = document.getElementById('book-content');
    
    console.log('[CURTAIN] 📊 handlePageScroll: CURRENT STATE', {
      scrollTop: scrollTop.toFixed(2),
      windowHeight: windowHeight.toFixed(2),
      curtainScrollPosition: curtainScrollPosition.toFixed(3),
      curtainFullyLifted,
      wheelListenersActive,
      isAtTop: scrollTop <= 0,
      scrollPercentage: (scrollTop / windowHeight).toFixed(2) + '%'
    });
    
    // Log DOM positions when scroll event fires
    logDOMPositions('handlePageScroll - Scroll event fired');
    
    // If we're at the top of the page and curtain was lifted, restore curtain
    if (scrollTop <= 0) {
      console.log('[CURTAIN] 📍 AT TOP OF PAGE (scrollTop <= 0)', {
        scrollTop: scrollTop.toFixed(2),
        curtainFullyLifted,
        curtainScrollPosition: curtainScrollPosition.toFixed(3),
        shouldRestore: curtainFullyLifted || curtainScrollPosition >= 1
      });
      
      // If curtain was fully lifted, restore it and re-enable curtain scrolling
      if (curtainFullyLifted || curtainScrollPosition >= 1) {
        console.log('[CURTAIN] ✅ Conditions met for restoring curtain', {
          curtainFullyLifted,
          curtainScrollPosition: curtainScrollPosition.toFixed(3)
        });
        
        // Reset curtain state - fully down (visible)
        curtainFullyLifted = false;
        curtainScrollPosition = 0; // Curtain fully down at top of page
        curtainHero.classList.remove('fully-lifted');
        
        console.log('[CURTAIN] 🔄 Reset curtain state:', {
          curtainFullyLifted: false,
          curtainScrollPosition: curtainScrollPosition.toFixed(3),
          fullyLiftedClassRemoved: true,
          curtainState: 'FULLY DOWN (visible)'
        });
        
        // Ensure scroll is at 0
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        
        // Re-enable wheel listeners to handle curtain scrolling
        if (!wheelListenersActive) {
          console.log('[CURTAIN] 🔄 RE-ENABLING wheel listeners for curtain scrolling', {
            wasActive: false,
            willBeActive: true
          });
          wheelListenersActive = true;
          window.addEventListener('wheel', handleScroll, { passive: false });
          window.addEventListener('DOMMouseScroll', handleScroll, { passive: false });
          console.log('[CURTAIN] ✅ Wheel listeners ADDED back');
        } else {
          console.log('[CURTAIN] ℹ️ Wheel listeners already active, no change needed');
        }
        
        // Restore fixed positioning on page content
        if (pageContent) {
          console.log('[CURTAIN] 🔄 Restoring fixed positioning on page content');
          pageContent.style.position = 'fixed';
          pageContent.style.top = '0';
          pageContent.style.left = '0';
          pageContent.style.width = '100%';
          pageContent.style.zIndex = '5';
          console.log('[CURTAIN] ✅ Page content restored to fixed positioning');
        }
        
        // Update curtain position to reflect current state (fully down)
        updateCurtainPosition();
        
        // Log DOM positions after restoring curtain
        requestAnimationFrame(() => {
          logDOMPositions('handlePageScroll - After restoring curtain at top');
        });
      } else {
        console.log('[CURTAIN] ❌ At top but curtain conditions NOT MET', {
          curtainFullyLifted,
          curtainScrollPosition: curtainScrollPosition.toFixed(3),
          reason: 'Curtain not fully lifted and position < 1'
        });
      }
    } else if (scrollTop > 0 && scrollTop < windowHeight && curtainScrollPosition < 1 && !curtainFullyLifted) {
      // If we somehow scrolled without fully lifting curtain, sync position
      console.log('[CURTAIN] 🔄 Syncing curtain position with scroll (unexpected scroll detected)', {
        scrollTop: scrollTop.toFixed(2),
        currentPosition: curtainScrollPosition.toFixed(3),
        curtainFullyLifted,
        willSync: true
      });
      
      const oldPosition = curtainScrollPosition;
      curtainScrollPosition = Math.min(1, scrollTop / windowHeight);
      
      console.log('[CURTAIN] 📊 Synced position:', {
        from: oldPosition.toFixed(3),
        to: curtainScrollPosition.toFixed(3),
        change: (curtainScrollPosition - oldPosition).toFixed(3)
      });
      
      updateCurtainPosition();
      
      if (curtainScrollPosition >= 1) {
        console.log('[CURTAIN] ⚠️ Curtain reached max during sync - transitioning to normal scroll', {
          position: curtainScrollPosition.toFixed(3)
        });
        // This will trigger the transition in updateCurtainPosition
      }
    } else {
      console.log('[CURTAIN] ℹ️ handlePageScroll: NO ACTION TAKEN', {
        scrollTop: scrollTop.toFixed(2),
        curtainScrollPosition: curtainScrollPosition.toFixed(3),
        curtainFullyLifted,
        reason: scrollTop <= 0 
          ? 'At top but conditions not met' 
          : curtainScrollPosition >= 1 
            ? 'Curtain already at max' 
            : curtainFullyLifted 
              ? 'Curtain already fully lifted' 
              : 'Normal scrolling'
      });
    }
    
    console.log('[CURTAIN] 🏁 handlePageScroll EVENT COMPLETE');
  }

  // Initial setup
  console.log('[CURTAIN] 🚀 Initializing curtain effect');
  window.scrollTo(0, 0);
  updateCurtainPosition();
  
  // Listen for wheel events to control curtain
  console.log('[CURTAIN] Adding wheel event listeners');
  window.addEventListener('wheel', handleScroll, { passive: false });
  window.addEventListener('DOMMouseScroll', handleScroll, { passive: false }); // Firefox
  
  // Listen to scroll events to handle bringing curtain back when scrolling up
  console.log('[CURTAIN] Adding scroll event listener');
  window.addEventListener('scroll', handlePageScroll, { passive: true });
  
  console.log('[CURTAIN] ✅ Initialization complete');

  loadPreview();
</script>

