  // Setup approval confirm button
  function setupApprovalButton() {
    if (!approvalConfirmBtn) {
      // Button not ready yet, try again shortly (max 40 tries = 2 seconds)
      if (setupApprovalButton.retries === undefined) {
        setupApprovalButton.retries = 0;
      }
      if (setupApprovalButton.retries < 40) {
        setupApprovalButton.retries++;
        setTimeout(setupApprovalButton, 50);
      }
      return;
    }

    // Set initial disabled state
    const updateDisabledState = () => {
  if (approvalConfirmBtn) {
        approvalConfirmBtn.disabled = correctionUsed && !acknowledgeCheckbox.checked;
  }
    };
    updateDisabledState();

    // Attach click handler
    approvalConfirmBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      handleApprove(event);
    });

    // Update disabled state when checkbox changes
    if (acknowledgeCheckbox) {
      acknowledgeCheckbox.addEventListener('change', updateDisabledState);
    }
  }

  // Setup approval button when approval info is shown
  if (approveBtn) {
    approveBtn.addEventListener('click', () => {
      // Reset retries when showing approval info
      setupApprovalButton.retries = 0;
      setTimeout(setupApprovalButton, 200);
    });
  }

  // Also try to setup immediately after page load (in case approval-info is visible)
  setTimeout(setupApprovalButton, 300);

  acknowledgeCheckbox.addEventListener('change', () => {
    if (approvalConfirmBtn) {
      approvalConfirmBtn.disabled = correctionUsed && !acknowledgeCheckbox.checked;
    }
  });

