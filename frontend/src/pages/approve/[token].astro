  }

  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    padding: var(--spacing-md);
  }

  .modal-content {
    background: white;
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    max-width: 28rem;
    width: 100%;
    padding: var(--spacing-lg);
  }

  .modal-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-navy-midnight);
    margin-bottom: var(--spacing-md);
  }

  .modal-subtitle {
    font-size: 0.875rem;
    color: var(--color-soft-charcoal);
    margin-bottom: var(--spacing-md);
  }

  .modal-body {
    margin-bottom: var(--spacing-lg);
  }

  .warning-box {
    background: #fef3c7;
    border: 1px solid #fbbf24;
    border-radius: 8px;
    padding: var(--spacing-md);
  }

  .warning-title {
    font-weight: 600;
    color: #92400e;
    margin-bottom: var(--spacing-sm);
  }

  .warning-list {
    font-size: 0.875rem;
    color: #78350f;
    list-style: disc;
    list-style-position: inside;
    margin: 0;
    padding: 0;
  }

  .warning-list li {
    margin-bottom: var(--spacing-xs);
  }

  .checkbox-label {
    display: flex;
    align-items: start;
    gap: var(--spacing-sm);
