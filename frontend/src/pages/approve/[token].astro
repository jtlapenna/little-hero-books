  // Update header text color based on curtain visibility
  function updateHeaderForCurtain() {
    if (!mainHeader) return;
    
    // First check if we're still loading - if so, keep it black
    const isLoading = loadingState && loadingState.style.display !== 'none';
    if (isLoading) {
      mainHeader.classList.remove('header-curtain-visible');
      return;
