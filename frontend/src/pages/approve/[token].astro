            trackingDetails.appendChild(link);
          });
        }
        
        if (statusData.carrierName) {
          const carrier = document.createElement('div');
          carrier.textContent = `Carrier: ${statusData.carrierName}`;
          carrier.style.fontSize = '0.875rem';
