---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import BookSpreadViewer from '../../components/BookSpreadViewer.tsx';

// This is a server-rendered dynamic route (not pre-rendered)
// We need to validate tokens at runtime, so we can't use static generation
export const prerender = false;

// Get token from URL params
const { token } = Astro.params;
const rawRequireEmail = import.meta.env.PUBLIC_REQUIRE_CUSTOMER_EMAIL;
const requireEmail =
  rawRequireEmail !== undefined
    ? !['false', '0'].includes(String(rawRequireEmail).toLowerCase())
    : Astro.site?.hostname
    ? true
    : import.meta.env.MODE === 'production';

if (!token) {
  return Astro.redirect('/');
}
---

<Layout title="Book Preview - Little Hero Labs" description="Preview your personalized children's book">
  <div id="preview-app">
    <!-- Loading State -->
    <div id="loading-state" class="preview-container">
      <div class="loading-content">
        <div class="spinner"></div>
        <p class="loading-text">Loading your book preview...</p>
      </div>
    </div>

    <!-- Error State -->
    <div id="error-state" class="preview-container" style="display: none;">
      <div class="error-content">
        <svg class="error-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h1 class="error-title">Unable to Load Preview</h1>
        <p id="error-message" class="error-text"></p>
        <Button href="/" variant="primary" size="md">Return Home</Button>
      </div>
    </div>

    <!-- Main Preview Content -->
    <div id="preview-content" class="preview-container" style="display: none;">
      <!-- Curtain Hero Section (overlay on top) -->
      <div id="curtain-hero" class="curtain-hero">
        <div class="curtain-content">
          <h1 class="curtain-title">
            Hi, <span id="curtain-buyer-name" class="buyer-name">there</span>.
          </h1>
          <p class="curtain-subtitle">
            We are so excited to show you <span id="curtain-child-name" class="child-name-highlight">your child</span>'s book!
          </p>
          <div class="scroll-indicator">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
            <span>Scroll to reveal</span>
          </div>
        </div>
      </div>

      <!-- Scroll spacer that allows curtain to be revealed -->
      <div id="curtain-scroll-area" class="curtain-scroll-area"></div>

      <!-- Book Preview Content (stays in place, revealed as curtain slides up) -->
      <div id="book-content" class="book-content-wrapper">
      <div class="container preview-main">
        <!-- Page Header -->
        <div class="preview-card">
          <div class="preview-card-header">
            <div class="header-left">
              <h2 class="preview-title">Hi, <span id="buyer-name" class="buyer-name">there</span>!</h2>
              <p class="preview-subtitle">
                Review your personalized book for <span id="child-name" class="font-semibold">your child</span>
              </p>
            </div>
            <!-- Order Status Indicator (shown after approval) - Desktop: center, Mobile: after order details -->
            <div id="header-order-status" class="header-order-status" style="display: none;">
              <button id="status-indicator-wrapper" class="status-indicator-wrapper" aria-label="View order status details">
                <!-- Status Icon with colored circle background (matches success message icon) -->
                <div id="header-status-icon-wrapper" class="header-status-icon-wrapper status-icon-success">
                  <!-- Success Icon (Checkmark) -->
                  <svg id="header-status-icon-check" class="header-status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <!-- Warning Icon (Exclamation) -->
                  <svg id="header-status-icon-exclamation" class="header-status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>
                  <!-- Error Icon (X) -->
                  <svg id="header-status-icon-x" class="header-status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                  </svg>
                </div>
                <div class="status-indicator-content">
                  <span id="header-status-text" class="status-text">Preparing for Print</span>
                  <div class="status-indicator-bottom">
                    <span class="status-click-text">Click for details</span>
                    <svg class="status-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 5v14M19 12l-7 7-7-7"/>
                    </svg>
                  </div>
                </div>
              </button>
            </div>
            <div class="order-details-inline">
              <div class="order-detail-line">
                <span class="detail-label">Order ID:</span>
                <span id="order-id" class="detail-value"></span>
              </div>
              <div id="age-detail" class="order-detail-line" style="display: none;">
                <span id="child-name-order" class="font-semibold"></span>, <span id="age-value" class="detail-value"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Preview Area (PDF Viewer) -->
        <div class="preview-card preview-area">
          <div id="book-viewer-wrapper" class="book-viewer-wrapper" data-viewer-ready="false">
            <BookSpreadViewer
              client:load
              spreads={[]}
              initialSpread={0}
              externalEventName="lhb:book-spreads"
            />
          </div>
        </div>

        <!-- Action Buttons -->
        <div id="action-buttons-container" class="preview-card">
          <div class="action-buttons">
            <Button variant="secondary" size="lg" class="btn-revision" type="button">I need a correction</Button>
            <Button size="lg" class="btn-approve" type="button">Approve Book</Button>
        </div>

          <!-- Correction Info (hidden by default, shown when button clicked) -->
          <div id="correction-info" class="correction-info" style="display: none;">
          <div class="correction-header">
            <div>
              <h3 class="card-title">Need a correction?</h3>
              <p id="correction-availability" class="correction-availability">You have 1 correction available.</p>
            </div>
          </div>
          <div id="correction-locked" class="locked-banner" style="display: none;">
            We already received your correction. If you need more help, reply to our email thread and our team will assist.
          </div>
          <div id="correction-success" class="success-banner" style="display: none;">
              Thank you! We received your correction. We'll review it and follow up shortly.
          </div>
          <form id="correction-form" class="correction-form">
            <div class="form-group">
              <label class="form-label" for="contact-email">{requireEmail ? 'Your email' : 'Your email (optional)'}</label>
              <input type="email" id="contact-email" class="form-input" placeholder="you@example.com" required={requireEmail ? true : undefined} />
            </div>
            <div class="form-group">
              <label class="form-label" for="contact-email-confirm">{requireEmail ? 'Confirm email' : 'Confirm email (optional)'}</label>
              <input type="email" id="contact-email-confirm" class="form-input" placeholder="Re-enter your email" required={requireEmail ? true : undefined} />
            </div>
            <div class="form-group">
              <label class="form-label" for="reason-select">What needs fixing?</label>
              <select id="reason-select" class="form-input" required>
                <option value="">Select a correction</option>
              </select>
            </div>
            <div id="reason-banner" class="reason-banner" style="display: none;"></div>
            <div id="reason-fields" class="reason-fields"></div>
            <div id="correction-error" class="correction-error" style="display: none;"></div>
            <label class="checkbox-label marketing-opt">
              <input type="checkbox" id="marketing-opt-in" />
              <span>Keep me posted on new titles and promos for Little Hero Labs.</span>
            </label>
            <div id="policy-box" class="policy-box">
              We can adjust details to match the options you selected (name spelling, preset hair style/color, skin tone, pronouns, etc.). We can’t create brand-new art or styles beyond the choices shown.
            </div>
            <div class="correction-actions">
              <Button variant="secondary" size="md" class="correction-cancel" type="button">Cancel</Button>
              <Button size="md" class="correction-submit-btn" type="submit">Send correction</Button>
            </div>
          </form>
    </div>

          <!-- Approval Info (hidden by default, shown when button clicked) -->
          <div id="approval-info" class="approval-info" style="display: none;">
            <h3 class="card-title">Approve Your Book</h3>
            <div class="approval-info-content">
              <div class="info-box">
                <p class="info-title">Important Information:</p>
                <ul class="info-list">
              <li>Changes after approval will incur additional charges</li>
              <li>Your book will be printed and shipped within 5-7 business days after approval</li>
              <li>If you do not respond within 3 days, your book will be automatically approved and sent to print</li>
              <li>By approving, you confirm the book is correct and ready for printing</li>
            </ul>
          </div>
          <div id="last-revision-checkbox-container" class="checkbox-container" style="display: none;">
            <label class="checkbox-label">
              <input type="checkbox" id="acknowledge-last-revision" />
              <span>I confirm the book is correct and ready to print immediately.</span>
            </label>
          </div>
              <div class="approval-actions">
                <Button variant="secondary" size="lg" class="approval-cancel" type="button">Cancel</Button>
                <Button
                  size="lg"
                  class="btn-approval-confirm"
                  id="approval-confirm-btn"
                  type="button"
                >
                  Approve Book
                </Button>
        </div>
            </div>
          </div>
        </div>

        <!-- Success Message (shown after approval) -->
        <div id="success-message" class="preview-card success-message-card" style="display: none;">
          <div class="success-message-content">
            <!-- Dynamic Status Icon (Green check, Yellow exclamation, Red X) -->
            <div id="status-icon-wrapper" class="status-icon-wrapper status-icon-success">
              <!-- Success Icon (Checkmark) -->
              <svg id="status-icon-check" class="status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <!-- Warning Icon (Exclamation) -->
              <svg id="status-icon-exclamation" class="status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <!-- Error Icon (X) -->
              <svg id="status-icon-x" class="status-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
            </div>
            <!-- Dynamic Title -->
            <h2 id="status-title" class="success-message-title">Success! Magic is on the way!</h2>
            <!-- Dynamic Message -->
            <p id="status-message" class="success-message-text">
              Your book has been approved and is now being prepared for printing. We'll update this page with tracking information once it ships.
            </p>
            <!-- Tracking Information (shown when shipped) -->
            <div id="tracking-info" class="tracking-info" style="display: none;">
              <h4 class="tracking-title">Tracking Information</h4>
              <div id="tracking-details" class="tracking-details">
                <!-- Tracking details will be inserted here -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ token, requireEmail }} type="module" is:inline>
  // Determine API base URL based on environment
  // In production, use the live backend; in development, use localhost
  const isProduction = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
  const API_BASE = isProduction 
    ? 'https://admin.littleherolabs.com'
    : 'http://localhost:3000';
  const HAIR_STYLES = ['afro', 'bun', 'curly-long', 'curly-medium', 'curly-short', 'pigtails', 'pom-poms', 'ponytail', 'side-part', 'straight-long', 'straight-medium', 'straight-short'];
  const HAIR_COLORS = ['blonde', 'strawberry-blonde', 'light-brown', 'medium-brown', 'dark-brown', 'auburn', 'black', 'red'];
  const SKIN_TONES = ['skin-light', 'skin-medium', 'skin-tan', 'skin-brown-light', 'skin-brown-deep'];
  const PRONOUNS = ['she/her', 'he/him', 'they/them'];
  const ANIMAL_GUIDES = ['dog', 'cat', 'owl', 'lion', 'tiger', 'penguin', 't-rex', 'unicorn'];
  const FAVORITE_COLORS = ['red', 'orange', 'yellow', 'green', 'blue', 'pink', 'purple', 'brown', 'black'];
  const CLOTHING_STYLES = ['tee-shorts', 'dress'];

  const REASON_DEFINITIONS = [
    { id: 'name_typo', label: 'Name spelling is wrong', fields: [{ id: 'newName', label: 'Correct spelling', type: 'text', maxLength: 20, required: true, placeholder: 'Updated spelling' }] },
    { id: 'hairStyle_wrong', label: 'Hair style is wrong', fields: [{ id: 'hairStyle', label: 'Choose the hair style you selected', type: 'select', options: HAIR_STYLES, required: true }] },
    { id: 'hairColor_wrong', label: 'Hair color is wrong', fields: [{ id: 'hairColor', label: 'Pick the hair color you wanted', type: 'select', options: HAIR_COLORS, required: true }] },
    { id: 'skinTone_wrong', label: 'Skin tone is wrong', fields: [{ id: 'skinTone', label: 'Pick the skin tone you selected', type: 'select', options: SKIN_TONES, required: true }] },
    { id: 'pronouns_wrong', label: 'Pronouns are wrong', fields: [{ id: 'pronouns', label: 'Choose the pronouns you wanted', type: 'select', options: PRONOUNS, required: true }] },
    { id: 'animalGuide_wrong', label: 'Animal guide is wrong', fields: [{ id: 'animalGuide', label: 'Pick the animal guide you selected', type: 'select', options: ANIMAL_GUIDES, required: true }] },
    { id: 'favoriteColor_wrong', label: 'Favorite color is wrong', fields: [{ id: 'favoriteColor', label: 'Pick the favorite color you selected', type: 'select', options: FAVORITE_COLORS, required: true }] },
    { id: 'clothingStyle_wrong', label: 'Clothing style is wrong', fields: [{ id: 'clothingStyle', label: 'Choose the clothing style you selected', type: 'select', options: CLOTHING_STYLES, required: true }] },
    { id: 'dedication_fix', label: 'Dedication text needs a fix', fields: [{ id: 'dedication', label: 'Updated dedication message', type: 'textarea', maxLength: 200, required: true, rows: 4, placeholder: 'Enter the corrected dedication text' }] },
    { id: 'hometown_fix', label: 'Hometown text needs a fix', fields: [{ id: 'hometown', label: 'Updated hometown', type: 'text', maxLength: 50, required: true, placeholder: 'City, State' }] },
    { id: 'favoriteFood_fix', label: 'Favorite food text needs a fix', fields: [{ id: 'favoriteFood', label: 'Updated favorite food', type: 'text', maxLength: 30, required: true, placeholder: 'Favorite food' }] },
    { id: 'age_wrong', label: 'Age is wrong', fields: [{ id: 'age', label: 'Correct age (3-8)', type: 'number', min: 3, max: 8, required: true }] },
    {
      id: 'visual_issue',
      label: 'Something looks off (printing or color issue)',
      fields: [
        { id: 'visualIssue', label: 'What kind of issue?', type: 'select', options: ['blurry', 'missing-element', 'odd-colors', 'layout-cutoff', 'other-visual'], required: true },
        { id: 'details', label: 'Any details? (optional)', type: 'text', maxLength: 120, placeholder: 'Brief description' }
      ]
    },
    {
      id: 'other',
      label: 'Other (limited)',
      banner: 'We can fix details you selected on your order. Custom art or new styles aren’t available.',
      fields: [{ id: 'details', label: 'Describe the issue', type: 'text', maxLength: 120, required: true, placeholder: 'Short description (max 120 characters)' }]
    }
  ];

  let orderData = null;
  let correctionUsed = false;

  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorMessage = document.getElementById('error-message');
  const previewContent = document.getElementById('preview-content');
  const childNameEl = document.getElementById('child-name');
  const orderIdEl = document.getElementById('order-id');
  const ageDetail = document.getElementById('age-detail');
  const ageValue = document.getElementById('age-value');
  const childNameOrderEl = document.getElementById('child-name-order');
  const approveBtn = document.querySelector('.btn-approve');
  const approvalInfo = document.getElementById('approval-info');
  const acknowledgeCheckbox = document.getElementById('acknowledge-last-revision');
  const lastRevisionContainer = document.getElementById('last-revision-checkbox-container');
  const approvalConfirmBtn = document.querySelector('.btn-approval-confirm') || document.getElementById('approval-confirm-btn');

  const correctionAvailability = document.getElementById('correction-availability');
  const correctionForm = document.getElementById('correction-form');
  const correctionSuccess = document.getElementById('correction-success');
  const correctionLocked = document.getElementById('correction-locked');
  const correctionSubmit = document.querySelector('.correction-submit-btn');
  const correctionError = document.getElementById('correction-error');
  const reasonSelect = document.getElementById('reason-select');
  const reasonBanner = document.getElementById('reason-banner');
  const reasonFieldsContainer = document.getElementById('reason-fields');
  const marketingOptIn = document.getElementById('marketing-opt-in');
  const contactEmailInput = document.getElementById('contact-email');
  const contactEmailConfirmInput = document.getElementById('contact-email-confirm');
  const revisionBtn = document.querySelector('.btn-revision');
  const correctionInfo = document.getElementById('correction-info');
  const buyerNameEl = document.getElementById('buyer-name');
  const curtainHero = document.getElementById('curtain-hero');
  const curtainBuyerNameEl = document.getElementById('curtain-buyer-name');
  const curtainChildNameEl = document.getElementById('curtain-child-name');

  function populateReasonOptions() {
    reasonSelect.innerHTML = '<option value="">Select a correction</option>';
    REASON_DEFINITIONS.forEach((reason) => {
      const option = document.createElement('option');
      option.value = reason.id;
      option.textContent = reason.label;
      reasonSelect.appendChild(option);
    });
  }

  function showError(message) {
    loadingState.style.display = 'none';
    errorState.style.display = 'flex';
    errorMessage.textContent = message;
    // Error state has light background - keep header text black
    updateHeaderForCurtain(); // This will check loading state and set to black
  }

  function showPreview() {
    // Don't hide loading state yet - keep it visible until PDF is ready
    previewContent.style.display = 'block';
    // Update header when preview is shown (curtain will be visible, so text should be white)
    updateHeaderForCurtain();
  }

  async function loadPreview() {
    try {
      const response = await fetch(`${API_BASE}/api/preview/validate-token`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await response.json();

      // Backend now returns order data even when token is used/expired
      // If we have order data, use it regardless of validation status
      if (data.order) {
        orderData = data.order;
        
        // Cache order data in localStorage so we can retrieve it later if needed
        if (orderData && orderData.orderId) {
          try {
            localStorage.setItem(`order_data_${orderData.orderId}`, JSON.stringify(orderData));
          } catch (e) {
            console.warn('[PREVIEW] Failed to cache order data:', e);
          }
        }
        
        displayOrder(orderData);
        showPreview();
        
        // If token is valid, check order status normally
        if (data.valid) {
          checkOrderStatus(orderData);
        } else {
          // Token is invalid (used or expired) but we have order data
          // If token is used, it means customer already approved, so show approved state
          // If token is expired, check customer_approval_status to determine state
          if (data.used) {
            console.log('[PREVIEW] Token already used - customer has approved, showing approved state');
            showApprovedState(orderData);
          } else if (data.expired) {
            // Token expired - check if customer approved before expiration
            console.log('[PREVIEW] Token expired - checking approval status', 
              'customer_approval_status:', orderData.customer_approval_status
            );
            if (orderData.customer_approval_status === 'approved') {
              showApprovedState(orderData);
            } else {
              // Token expired but not approved - show error
              showError('This preview link has expired. Please contact us for a new link.');
            }
          } else {
            // Token invalid for other reason
            showError('Invalid preview link. Please contact us for assistance.');
          }
        }
        return;
      }

      // No order data in response - show error
      if (!response.ok || !data.valid) {
        const errorMsg = typeof data.error === 'string' ? data.error : 'Invalid or expired token';
        showError(errorMsg);
        return;
      }

      if (!data.order) {
        showError('Order not found');
        return;
      }
    } catch (error) {
      console.error('Error loading preview:', error);
      const errorMsg = error instanceof Error ? error.message : String(error || 'Failed to load preview');
      showError(errorMsg);
    }
  }

  // React Book Viewer state
  let spreads = [];
  let currentInitialSpread = 0;
  const BOOK_VIEWER_EVENT = 'lhb:book-spreads';
  const bookViewerWrapper = document.getElementById('book-viewer-wrapper');

  function computeInitialSpreadIndex(spreadsList) {
    if (!Array.isArray(spreadsList) || spreadsList.length === 0) {
      return 0;
    }
    const firstInterior = spreadsList.findIndex((spread) => !spread.isCover);
    return firstInterior >= 0 ? firstInterior : 0;
  }

  function syncReactViewer(spreadsToRender) {
    if (!Array.isArray(spreadsToRender) || spreadsToRender.length === 0) {
      console.warn('[Preview] Viewer sync skipped: no spreads provided');
      return;
    }

    currentInitialSpread = computeInitialSpreadIndex(spreadsToRender);

    window.dispatchEvent(
      new CustomEvent(BOOK_VIEWER_EVENT, {
        detail: {
          spreads: spreadsToRender,
          initialSpread: currentInitialSpread
        }
      })
    );

    if (bookViewerWrapper) {
      bookViewerWrapper.setAttribute('data-viewer-ready', 'true');
    }
  }

  // Create spreads from pages (similar to order page logic)
  function createSpreads(pages, coverImageUrl) {
    const spreads = [];
    
    console.log('[Preview] createSpreads called:', {
      pagesCount: pages.length,
      coverImageUrl: coverImageUrl || 'NULL',
      hasCover: !!coverImageUrl
    });
    
    // Add front cover spread (blank left, cover right half) if cover is available
    if (coverImageUrl) {
      console.log('[Preview] Adding front cover spread with URL:', coverImageUrl);
      spreads.push({
        spreadNumber: 0,
        leftPage: null,
        rightPage: null,
        coverData: {
          fullImageUrl: coverImageUrl,
          isFrontCover: true,
          isBackCover: false
        },
        isCover: true,
        isBackCover: false
      });
    } else {
      console.warn('[Preview] ⚠️ No coverImageUrl provided - front cover will not be shown');
    }
    
    // Find dedication page (page 0) and story pages (pages 1-15)
    const dedicationPage = pages.find(p => p.pageNumber === 0);
    const storyPages = pages.filter(p => p.pageNumber >= 1).sort((a, b) => a.pageNumber - b.pageNumber);
    
    // Add dedication spread (blank left, page00 right)
    if (dedicationPage) {
      spreads.push({
        spreadNumber: spreads.length,
        isCover: false,
        isBackCover: false,
        leftPage: null,
        rightPage: dedicationPage
      });
    }
    
    // Interior spreads: pair story pages (1-2, 3-4, 5-6, etc.)
    for (let i = 0; i < storyPages.length; i += 2) {
      spreads.push({
        spreadNumber: spreads.length,
        isCover: false,
        isBackCover: false,
        leftPage: storyPages[i],
        rightPage: storyPages[i + 1] || null
      });
    }
    
    // Add back cover spread (cover left half, blank right) if cover is available
    if (coverImageUrl) {
      console.log('[Preview] Adding back cover spread with URL:', coverImageUrl);
      spreads.push({
        spreadNumber: spreads.length,
        leftPage: null,
        rightPage: null,
        coverData: {
          fullImageUrl: coverImageUrl,
          isFrontCover: false,
          isBackCover: true
        },
        isCover: false,
        isBackCover: true
      });
    } else {
      console.warn('[Preview] ⚠️ No coverImageUrl provided - back cover will not be shown');
    }
    
    console.log('[Preview] Total spreads created:', spreads.length, spreads.map(s => ({
      spreadNumber: s.spreadNumber,
      isCover: s.isCover,
      isBackCover: s.isBackCover,
      hasCoverData: !!s.coverData,
      coverUrl: s.coverData?.fullImageUrl ? s.coverData.fullImageUrl.substring(0, 100) + '...' : 'none'
    })));
    
    return spreads;
  }

  // Load pages from manifest
  async function loadPages(orderId) {
    try {
      const manifest3Key = `book-mvp-simple-adventure/orders/${orderId}/manifests/3-manifest.json`;
      const manifest3Url = `${API_BASE}/api/manifests/${manifest3Key}?v=${Date.now()}`;
      
      const response = await fetch(manifest3Url, { cache: 'no-store' });
      if (!response.ok) {
        console.warn('[Preview] Manifest not found, pages may not be ready yet');
        return { pages: [], coverImageUrl: null };
      }
      
      const manifest3Raw = await response.json();
      const manifest3 = Array.isArray(manifest3Raw) ? manifest3Raw[0] : manifest3Raw;
      
      // Handle nested manifest structure
      const manifest = manifest3?.manifest || manifest3;
      
      // Get page preview images
      let previewImages = manifest?.pagePreviewImages 
        || manifest3?.pagePreviewImages
        || manifest?.bookAssembly?.pagePreviewImages 
        || [];
      
      // Fallback: Build from pngGeneration.pages
      if (!previewImages || previewImages.length === 0) {
        const pagesObj = manifest?.pngGeneration?.pages || {};
        if (pagesObj && Object.keys(pagesObj).length > 0) {
          console.log('[Preview] Building previewImages from pngGeneration.pages, found keys:', Object.keys(pagesObj));
          previewImages = Object.entries(pagesObj)
            .map(([key, r2Key]) => {
              let pageNumber = 0;
              if (key === 'p00_dedication' || key === 'p00') {
                pageNumber = 0;
              } else if (key.startsWith('p')) {
                const num = parseInt(key.substring(1), 10);
                if (!isNaN(num)) pageNumber = num;
              }
              return {
                pageNumber,
                r2Key: typeof r2Key === 'string' ? r2Key : null,
                imageUrl: typeof r2Key === 'string' ? `${API_BASE}/api/assets/${r2Key}` : null
              };
            })
            .filter(img => img.r2Key); // Remove entries without r2Key
          
          // Deduplicate page 0 (prefer p00_dedication)
          const page0Entries = previewImages.filter(p => p.pageNumber === 0);
          if (page0Entries.length > 1) {
            const dedication = page0Entries.find(p => p.r2Key?.includes('dedication'));
            if (dedication) {
              previewImages = previewImages.filter(p => !(p.pageNumber === 0 && p.r2Key !== dedication.r2Key));
            }
          }
          console.log('[Preview] Built previewImages from pngGeneration.pages:', previewImages.length, 'pages');
        }
      }
      
      console.log('[Preview] Total previewImages found:', previewImages.length);
      
      // Get Cloudflare Images URLs if available
      // pagesWithCloudflare is an object keyed by page keys (p01, p02, etc.), not an array
      const pagesWithCloudflare = manifest?.pngGeneration?.pagesWithCloudflare 
        || manifest3?.pngGeneration?.pagesWithCloudflare 
        || {};
      
      // Build page data array
      // Ensure previewImages is an array before mapping
      // Priority: Use Cloudflare Images URLs (preview/watermarked versions) when available
      const isValidCloudflareUrl = (url) => {
        if (!url || typeof url !== 'string') return false;
        // Must be a valid Cloudflare Images URL: https://imagedelivery.net/{accountHash}/{imageId}/{variant}
        return url.startsWith('https://imagedelivery.net/') && url.split('/').length >= 5;
      };
      
      const pages = (Array.isArray(previewImages) ? previewImages : []).map((img) => {
        const pageNum = Number(img.pageNumber || 0);
        // Generate page key for Cloudflare lookup (p00_dedication for page 0, p01 for page 1, etc.)
        const pageKey = pageNum === 0 ? 'p00_dedication' : (pageNum < 10 ? `p0${pageNum}` : `p${pageNum}`);
        
        // Get Cloudflare Images data from pagesWithCloudflare object
        // For page 0, check both p00_dedication and p00 keys
        const cfData = pageNum === 0 
          ? (pagesWithCloudflare['p00_dedication'] || pagesWithCloudflare['p00'] || null)
          : (pagesWithCloudflare[pageKey] || null);
        const cloudflareImageUrl = img.cloudflareImageUrl || cfData?.cloudflareImageUrl || null;
        
        // Priority 1: Use Cloudflare Images URL if available (preview/watermarked, WebP, CDN)
        if (cloudflareImageUrl && isValidCloudflareUrl(cloudflareImageUrl)) {
          return {
            pageNumber: pageNum,
            imageUrl: cloudflareImageUrl
          };
        }
        // Priority 2: Use imageUrl from previewImages if it's a Cloudflare URL
        else if (img.imageUrl && isValidCloudflareUrl(img.imageUrl)) {
          return {
            pageNumber: pageNum,
            imageUrl: img.imageUrl
          };
        }
        // Priority 3: Use imageUrl from previewImages (R2 proxy)
        else if (img.imageUrl) {
          return {
            pageNumber: pageNum,
            imageUrl: img.imageUrl
          };
        }
        // Priority 4: Fallback to R2 key
        else if (img.r2Key) {
          return {
            pageNumber: pageNum,
            imageUrl: `${API_BASE}/api/assets/${img.r2Key}`
          };
        }
        return null;
      }).filter(p => p && p.imageUrl); // Only include pages with valid URLs
      
      // Sort pages by pageNumber to ensure correct order
      pages.sort((a, b) => a.pageNumber - b.pageNumber);
      
      console.log('[Preview] Final pages array:', pages.length, 'pages', pages.map(p => `p${p.pageNumber}`));
      
      // Get cover image URL - check multiple possible locations
      // Priority: Cloudflare Images URL (preview/watermarked), then direct URL, then R2 key
      const pngGen = manifest?.pngGeneration || manifest3?.pngGeneration || {};
      
      // Check for Cloudflare Images URL first (preferred for preview)
      let coverImageUrl = pngGen.coverCloudflareImageUrl 
        || manifest?.coverCloudflareImageUrl
        || manifest3?.coverCloudflareImageUrl
        || null;
      
      // If Cloudflare URL exists, ensure it has a variant (add /public if missing)
      if (coverImageUrl && typeof coverImageUrl === 'string') {
        if (!coverImageUrl.includes('/public') && !coverImageUrl.includes('/backend')) {
          coverImageUrl = coverImageUrl.endsWith('/') ? coverImageUrl + 'public' : coverImageUrl + '/public';
        }
      }
      
      // Fallback to direct coverImageUrl fields
      if (!coverImageUrl) {
        coverImageUrl = manifest?.coverImageUrl 
          || manifest3?.coverImageUrl
          || manifest?.bookAssembly?.coverImageUrl
          || pngGen?.coverImageUrl
          || null;
      }
      
      // Fallback to R2 key (construct URL)
      if (!coverImageUrl && pngGen?.coverImageR2Key) {
        coverImageUrl = `${API_BASE}/api/assets/${pngGen.coverImageR2Key}`;
      }
      
      console.log('[Preview] Cover image URL lookup:', {
        'pngGeneration.coverCloudflareImageUrl': pngGen?.coverCloudflareImageUrl || 'not found',
        'manifest.coverCloudflareImageUrl': manifest?.coverCloudflareImageUrl || 'not found',
        'manifest3.coverCloudflareImageUrl': manifest3?.coverCloudflareImageUrl || 'not found',
        'manifest.coverImageUrl': manifest?.coverImageUrl || 'not found',
        'manifest3.coverImageUrl': manifest3?.coverImageUrl || 'not found',
        'manifest.bookAssembly.coverImageUrl': manifest?.bookAssembly?.coverImageUrl || 'not found',
        'pngGeneration.coverImageUrl': pngGen?.coverImageUrl || 'not found',
        'pngGeneration.coverImageR2Key': pngGen?.coverImageR2Key || 'not found',
        'final coverImageUrl': coverImageUrl || 'NULL - COVER NOT FOUND'
      });
      
      return { pages, coverImageUrl };
    } catch (error) {
      console.error('[Preview] Error loading pages:', error);
      return { pages: [], coverImageUrl: null };
    }
  }

  function displayOrder(order) {
    const childName = order.characterSpecs?.childName || 'your child';
    const buyerName = order.customerName || 'there';
    buyerNameEl.textContent = buyerName;
    childNameEl.textContent = childName;
    
    // Update curtain hero section
    if (curtainBuyerNameEl) curtainBuyerNameEl.textContent = buyerName;
    if (curtainChildNameEl) curtainChildNameEl.textContent = childName;

    const displayOrderId = order.amazonOrderId || order.orderId;
    orderIdEl.textContent = displayOrderId;

    if (order.characterSpecs?.age) {
      ageDetail.style.display = 'block';
      ageValue.textContent = `${order.characterSpecs.age} years old`;
      if (childNameOrderEl) childNameOrderEl.textContent = childName;
    }

    updateCorrectionState(order);

    if (approveBtn) {
      approveBtn.disabled = false;
    }
    
    // Load and display PDF pages
    loadPagesAndDisplay(order.orderId);
  }

  async function loadPagesAndDisplay(orderId) {
    try {
      const { pages, coverImageUrl } = await loadPages(orderId);
      
      if (pages.length === 0) {
        // No pages available yet, update loading message
        if (loadingState && loadingState.querySelector('.loading-text')) {
          loadingState.querySelector('.loading-text').textContent = 'Preview Not Ready. The book preview is being generated. Please check back soon.';
        }
        return;
      }
      
      // Create spreads
      console.log('[Preview] Creating spreads with:', {
        pagesCount: pages.length,
        coverImageUrl: coverImageUrl || 'NULL'
      });
      spreads = createSpreads(pages, coverImageUrl);

      const spreadSummaries = spreads.map((spread) => ({
        spreadNumber: spread.spreadNumber,
        hasLeftPage: !!spread.leftPage?.imageUrl,
        hasRightPage: !!spread.rightPage?.imageUrl,
        hasCoverData: !!spread.coverData?.fullImageUrl,
        isCover: !!spread.isCover,
        isBackCover: !!spread.isBackCover
      }));
      console.log('[Preview] Viewer spreads summary:', spreadSummaries);

      const invalidSpread = spreads.find((spread) => {
        const leftValid =
          !spread.leftPage || (typeof spread.leftPage.pageNumber === 'number' && typeof spread.leftPage.imageUrl === 'string');
        const rightValid =
          !spread.rightPage || (typeof spread.rightPage.pageNumber === 'number' && typeof spread.rightPage.imageUrl === 'string');
        const coverValid =
          !spread.coverData || typeof spread.coverData.fullImageUrl === 'string';
        return !(leftValid && rightValid && coverValid);
      });

      if (invalidSpread) {
        console.warn('[Preview] Detected spread with missing data:', invalidSpread);
      }
      
      if (spreads.length === 0) {
        console.warn('[Preview] No spreads created from pages');
        if (loadingState && loadingState.querySelector('.loading-text')) {
          loadingState.querySelector('.loading-text').textContent = 'Unable to load preview. Please try again later.';
        }
        return;
      }
      
      console.log('[Preview] Spreads created successfully:', spreads.length, 'total spreads');
      
      // Hide loading state now that preview is ready
      if (loadingState) loadingState.style.display = 'none';
      
      // Dispatch spreads to the React viewer
      syncReactViewer(spreads);
    } catch (error) {
      console.error('[Preview] Error loading pages:', error);
      // Show error in loading state
      if (loadingState && loadingState.querySelector('.loading-text')) {
        loadingState.querySelector('.loading-text').textContent = 'Unable to load preview. Please try again later.';
      }
    }
  }

  function updateCorrectionState(order) {
    correctionUsed = (order.revisionCount || 0) >= 1;

    if (correctionUsed) {
      correctionAvailability.textContent = 'Correction already submitted';
      correctionAvailability.classList.add('correction-used');
      correctionForm.style.display = 'none';
      correctionLocked.style.display = 'block';
      correctionSuccess.style.display = 'block';
      lastRevisionContainer.style.display = 'block';
      if (approvalConfirmBtn) {
        approvalConfirmBtn.disabled = !acknowledgeCheckbox.checked;
      }
      if (revisionBtn) {
        revisionBtn.textContent = 'View correction details';
        revisionBtn.classList.add('correction-used');
      }
    } else {
      correctionAvailability.textContent = 'You have 1 correction available.';
      correctionAvailability.classList.remove('correction-used');
      correctionForm.style.display = 'block';
      correctionLocked.style.display = 'none';
      correctionSuccess.style.display = 'none';
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';
      lastRevisionContainer.style.display = 'none';
      acknowledgeCheckbox.checked = false;
      if (approvalConfirmBtn) {
        approvalConfirmBtn.disabled = false;
      }
      if (revisionBtn) {
        revisionBtn.textContent = 'I need a correction';
        revisionBtn.classList.remove('correction-used');
      }
    }
  }

  function renderReasonFields(reasonId) {
    reasonFieldsContainer.innerHTML = '';
    correctionError.style.display = 'none';

    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);
    if (!reason) {
      reasonBanner.style.display = 'none';
      return;
    }

    if (reason.banner) {
      reasonBanner.textContent = reason.banner;
      reasonBanner.style.display = 'block';
    } else {
      reasonBanner.style.display = 'none';
    }

    reason.fields.forEach((field) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'form-group';

      const label = document.createElement('label');
      label.className = 'form-label';
      label.htmlFor = `field-${field.id}`;
      label.textContent = field.label;

      let input;
      if (field.type === 'select') {
        input = document.createElement('select');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.required = !!field.required;
        input.innerHTML = '<option value="">Select an option</option>';
        field.options.forEach((optionValue) => {
          const option = document.createElement('option');
          option.value = optionValue;
          option.textContent = optionValue;
          input.appendChild(option);
        });
      } else if (field.type === 'textarea') {
        input = document.createElement('textarea');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.rows = field.rows || 4;
        input.maxLength = field.maxLength || 500;
        input.placeholder = field.placeholder || '';
        if (field.required) input.required = true;
      } else {
        input = document.createElement('input');
        input.className = 'form-input';
        input.id = `field-${field.id}`;
        input.type = field.type === 'number' ? 'number' : 'text';
        if (field.type === 'number') {
          if (typeof field.min === 'number') input.min = field.min;
          if (typeof field.max === 'number') input.max = field.max;
        }
        if (field.maxLength) input.maxLength = field.maxLength;
        if (field.placeholder) input.placeholder = field.placeholder;
        if (field.required) input.required = true;
      }

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      reasonFieldsContainer.appendChild(wrapper);
    });
  }

  function collectFieldValues(reason) {
    const values = {};
    if (!reason) return values;

    reason.fields.forEach((field) => {
      const input = document.getElementById(`field-${field.id}`);
      if (!input) return;

      if (field.type === 'number') {
        const numericValue = input.value ? Number(input.value) : null;
        if (numericValue !== null && !Number.isNaN(numericValue)) {
          values[field.id] = numericValue;
        }
      } else {
        const value = input.value.trim();
        if (value) {
          values[field.id] = value;
        }
      }
    });

    return values;
  }

  async function handleCorrectionSubmit(event) {
    event.preventDefault();
    correctionError.style.display = 'none';

    if (!orderData) return;
    if (!correctionSubmit) return;
    if (correctionUsed) {
      correctionError.textContent = 'You have already used your correction for this order.';
      correctionError.style.display = 'block';
      return;
    }

    const reasonId = reasonSelect.value;
    const reason = REASON_DEFINITIONS.find((r) => r.id === reasonId);

    if (!reasonId || !reason) {
      correctionError.textContent = 'Please choose what needs fixing.';
      correctionError.style.display = 'block';
      return;
    }

    const emailRaw = contactEmailInput.value.trim();
    const emailConfirmRaw = contactEmailConfirmInput.value.trim();
    let emailToSend = null;

    if (requireEmail) {
      if (!emailRaw || !emailConfirmRaw) {
        correctionError.textContent = 'Please enter and confirm your email address.';
        correctionError.style.display = 'block';
        return;
      }

      if (emailRaw.toLowerCase() !== emailConfirmRaw.toLowerCase()) {
        correctionError.textContent = 'Email addresses do not match. Please re-type them.';
        correctionError.style.display = 'block';
        return;
      }

      emailToSend = emailRaw;
    } else if (emailRaw || emailConfirmRaw) {
      if (!emailRaw || !emailConfirmRaw) {
        correctionError.textContent =
          'Please enter and confirm your email address, or leave both fields blank.';
        correctionError.style.display = 'block';
        return;
      }

      if (emailRaw.toLowerCase() !== emailConfirmRaw.toLowerCase()) {
        correctionError.textContent = 'Email addresses do not match. Please re-type them.';
        correctionError.style.display = 'block';
        return;
      }

      emailToSend = emailRaw;
    }

    const fields = collectFieldValues(reason);

    const missingField = reason.fields.find((field) => field.required && !fields[field.id]);
    if (missingField) {
      correctionError.textContent = 'Please fill out the required fields.';
      correctionError.style.display = 'block';
      return;
    }

    correctionSubmit.disabled = true;
    correctionSubmit.textContent = 'Sending...';

    try {
      /** @type {Record<string, unknown>} */
      const payload = {
        orderId: orderData.orderId,
        token,
        reason: reasonId,
        fields,
        marketingOptIn: marketingOptIn.checked
      };

      if (orderData.amazonOrderId) {
        payload.amazonOrderId = orderData.amazonOrderId;
      }

      if (orderData.customerName && orderData.customerName.trim().length > 0) {
        payload.name = orderData.customerName;
      }

      if (emailToSend && emailToSend.trim().length > 0) {
        payload.email = emailToSend.trim();
      }

      const response = await fetch(`${API_BASE}/api/preview/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Failed to send correction');
      }

      correctionForm.reset();
      reasonFieldsContainer.innerHTML = '';
      reasonBanner.style.display = 'none';
      correctionSuccess.style.display = 'block';
      correctionLocked.style.display = 'none';

      orderData.revisionCount = (orderData.revisionCount || 0) + 1;
      updateCorrectionState(orderData);
    } catch (error) {
      console.error('Error submitting correction:', error);
      correctionError.textContent = error.message || 'Failed to send correction. Please try again or email us.';
      correctionError.style.display = 'block';
    } finally {
      correctionSubmit.disabled = false;
      correctionSubmit.textContent = 'Send correction';
    }
  }

  function checkOrderStatus(order) {
    // ONLY check customer_approval_status to determine if customer has approved
    // Do NOT check execution_status or next_workflow as these can be set for many reasons
    // (e.g., order ready for workflow 2A, 2B, or 3, not just customer approval)
    const isApproved = order.customer_approval_status === 'approved';
    
    if (isApproved) {
      console.log('[STATUS] Order is already approved by customer, showing success message and hiding actions');
      showApprovedState(order);
    } else {
      console.log('[STATUS] Order not yet approved by customer, showing approval interface');
    }
  }

  function showApprovedState(orderDataFromResponse = null) {
    // Hide error and loading states
    loadingState.style.display = 'none';
    errorState.style.display = 'none';
    
    // If we have full order data passed in, use it directly
    if (orderDataFromResponse && orderDataFromResponse.customerName && orderDataFromResponse.characterSpecs) {
      orderData = orderDataFromResponse;
      displayOrder(orderData);
    } else {
      // Try to extract order info from token if no order data provided
      let extractedOrderId = null;
      if (!orderDataFromResponse && token) {
        // Token format might be like "E2E-005-5d397e5ff397645b" where first part is order ID
        const tokenParts = token.split('-');
        if (tokenParts.length >= 2) {
          // Try to construct a partial order ID from token
          extractedOrderId = tokenParts[0] + '-' + tokenParts[1];
        }
      }
      
      // Try to get cached order data from localStorage
      if (extractedOrderId) {
        try {
          const cachedOrderData = localStorage.getItem(`order_data_${extractedOrderId}`);
          if (cachedOrderData) {
            const parsed = JSON.parse(cachedOrderData);
            orderData = parsed;
            displayOrder(orderData);
          }
        } catch (e) {
          console.warn('[PREVIEW] Failed to retrieve cached order data:', e);
        }
      }
    }
    
    // Hide action buttons and curtain
    const actionButtonsContainer = document.getElementById('action-buttons-container');
    if (actionButtonsContainer) {
      actionButtonsContainer.style.display = 'none';
    }
    
    if (curtainHero) {
      curtainHero.style.display = 'none';
    }
    
    // Show success message
    showSuccessMessage();
    
    // Show preview content
    showPreview();
  }

  function showSuccessMessage() {
    console.log('[SUCCESS] showSuccessMessage called');
    
    // Hide action buttons
    const actionButtonsContainer = document.getElementById('action-buttons-container');
    if (actionButtonsContainer) {
      actionButtonsContainer.style.display = 'none';
    }
    
    // Hide curtain if visible
    if (curtainHero) {
      curtainHero.style.display = 'none';
    }
    
    // Hide approval and correction info sections
    if (approvalInfo) {
      approvalInfo.style.display = 'none';
    }
    if (correctionInfo) {
      correctionInfo.style.display = 'none';
    }
    
    // Show header status indicator
    const headerStatus = document.getElementById('header-order-status');
    if (headerStatus) {
      headerStatus.style.display = 'flex';
    }
    
    // Show success message
    const successMessage = document.getElementById('success-message');
    if (successMessage) {
      successMessage.style.display = 'block';
      successMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      console.error('[SUCCESS] success-message element not found!');
    }
    
    // Start fetching order status
    if (orderData && orderData.orderId) {
      fetchOrderStatus(orderData.orderId);
      // Poll for status updates every 30 seconds
      startStatusPolling(orderData.orderId);
    }
  }

  // Status polling interval
  let statusPollInterval = null;

  async function fetchOrderStatus(orderId) {
    try {
      const response = await fetch(`${API_BASE}/api/preview/${orderId}/status`);
      if (!response.ok) {
        throw new Error('Failed to fetch status');
      }
      const statusData = await response.json();
      updateStatusDisplay(statusData);
    } catch (error) {
      console.error('[STATUS] Error fetching order status:', error);
    }
  }

  function updateStatusDisplay(statusData) {
    // Update header status text with actual status
    const headerStatusText = document.getElementById('header-status-text');
    if (headerStatusText) {
      headerStatusText.textContent = statusData.status;
    }

    // Get status configuration based on Lulu status
    const luluStatus = statusData.luluStatus || '';
    const statusConfig = getStatusConfig(luluStatus, statusData.status);

    // Update header status icon to match main status icon
    updateHeaderStatusIcon(statusConfig.iconType);

    // Update status icon
    updateStatusIcon(statusConfig.iconType);

    // Update title and message
    const statusTitle = document.getElementById('status-title');
    const statusMessage = document.getElementById('status-message');
    
    if (statusTitle) {
      statusTitle.textContent = statusConfig.title;
    }
    
    if (statusMessage) {
      statusMessage.textContent = statusConfig.message;
    }

    // Show tracking info if shipped
    if (statusData.trackingNumber || statusData.trackingUrls) {
      const trackingInfo = document.getElementById('tracking-info');
      const trackingDetails = document.getElementById('tracking-details');
      
      if (trackingInfo && trackingDetails) {
        trackingInfo.style.display = 'block';
        trackingDetails.innerHTML = '';
        
        if (statusData.trackingNumber) {
          const trackingNum = document.createElement('div');
          trackingNum.textContent = `Tracking Number: ${statusData.trackingNumber}`;
          trackingDetails.appendChild(trackingNum);
        }
        
        if (statusData.trackingUrls && statusData.trackingUrls.length > 0) {
          statusData.trackingUrls.forEach(url => {
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'tracking-link';
            link.textContent = 'Track Your Package';
