  async function handleApprove() {
    if (!orderData || !token) return;

    if (correctionUsed && !acknowledgeCheckbox.checked) {
      alert('Please confirm you are ready to send your book to print.');
      return;
    }

    const confirmBtn = approvalConfirmBtn || document.querySelector('.btn-approval-confirm');
    if (confirmBtn) {
      confirmBtn.disabled = true;
      if (confirmBtn.textContent) {
        confirmBtn.textContent = 'Approving...';
      }
    }

    try {
      // Set order status to ready_for_processing - router cron job will pick it up and send to w1.1 -> w4
      const response = await fetch(`${API_BASE}/api/preview/${orderData.orderId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      if (!response.ok) {
        const errorData = await response.json();
        const errorMsg = typeof errorData?.error === 'string' ? errorData.error : 'Failed to approve';
        throw new Error(errorMsg);
      }

      console.log('[APPROVE] Approval successful, showing success message');
      
      // Show success message
      showSuccessMessage();
      } catch (error) {
      console.error('[APPROVE] Error approving:', error);
      const errorMsg = error instanceof Error ? error.message : String(error || 'Failed to approve book. Please try again.');
      alert(errorMsg);
      if (confirmBtn) {
        confirmBtn.disabled = false;
        if (confirmBtn.textContent) {
          confirmBtn.textContent = 'Approve Book';
        }
      }
    }
  }

