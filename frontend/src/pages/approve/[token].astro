  /**
   * Get status configuration based on Lulu status
   * Each status has a unique descriptive message
   */
  function getStatusConfig(luluStatus, fallbackStatus) {
    // Success states (green checkmark)
    if (luluStatus === 'IN_PRODUCTION') {
      return {
        iconType: 'success',
        title: 'Printing Your Book',
        message: 'Your book is currently being printed at our facility. This process typically takes 2-3 business days. We\'ll update this page with tracking information once it ships.'
      };
    }
    
    if (luluStatus === 'SHIPPED') {
      return {
        iconType: 'success',
        title: 'Shipped',
        message: 'Great news! Your book has been shipped and is on its way to you. You can track your package using the tracking information below. Delivery typically takes 5-7 business days.'
      };
    }
    
    if (luluStatus === 'DELIVERED') {
      return {
        iconType: 'success',
        title: 'Delivered',
        message: 'Your personalized book has been delivered! We hope you and your little hero enjoy the magical adventure together. Thank you for choosing Little Hero Labs!'
      };
    }
    
    // Error states
    if (luluStatus === 'REJECTED') {
      return {
        iconType: 'warning',
        title: 'Action Required',
        message: 'We encountered an issue while processing your order. Our team has been notified and will contact you shortly to resolve this. Please check your email for updates or contact our support team if you have questions.'
      };
    }
    
    if (luluStatus === 'CANCELED') {
      return {
        iconType: 'error',
        title: 'Canceled',
        message: 'Your order has been canceled. If you believe this was done in error or have questions about your order, please contact our support team. We\'re here to help!'
      };
    }
    
    // Default: Preparing for Print (green checkmark)
    // This covers: CREATED, UNPAID, PAYMENT_IN_PROGRESS, PRODUCTION_DELAYED, PRODUCTION_READY
    // and fallback states like customer_approved, pending_print
    return {
      iconType: 'success',
      title: 'Success! Magic is on the way!',
      message: 'Your book has been approved and is now being prepared for printing. Our team is processing your order and will begin printing soon. We\'ll update this page with tracking information once your book ships.'
    };
  }

  /**
   * Update status icon based on type (success, warning, error)
   */
  function updateStatusIcon(iconType) {
    const iconWrapper = document.getElementById('status-icon-wrapper');
    const iconCheck = document.getElementById('status-icon-check');
    const iconExclamation = document.getElementById('status-icon-exclamation');
    const iconX = document.getElementById('status-icon-x');
    
    if (!iconWrapper) return;
    
    // Remove all icon type classes
    iconWrapper.classList.remove('status-icon-success', 'status-icon-warning', 'status-icon-error');
    
    // Hide all icons
    if (iconCheck) iconCheck.style.display = 'none';
    if (iconExclamation) iconExclamation.style.display = 'none';
    if (iconX) iconX.style.display = 'none';
    
    // Show appropriate icon based on type
    if (iconType === 'success') {
      iconWrapper.classList.add('status-icon-success');
      if (iconCheck) iconCheck.style.display = 'block';
    } else if (iconType === 'warning') {
      iconWrapper.classList.add('status-icon-warning');
      if (iconExclamation) iconExclamation.style.display = 'block';
    } else if (iconType === 'error') {
      iconWrapper.classList.add('status-icon-error');
      if (iconX) iconX.style.display = 'block';
    }
  }

