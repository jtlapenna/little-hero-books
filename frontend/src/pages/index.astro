---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
---

<Layout title="Personalized Children's Books | Custom Kids Books | Little Hero Labs" description="Create a personalized children's book where your child is the actual hero. Customize their look, hometown, dedication, pronouns, and animal companion in a 16-page launch edition softcover.">
  <Hero 
    imageSrc="/homepage-hero-mobile.webp" 
    imageAlt="Personalized children's books - Little Hero Labs"
    bgImage="/homepage-hero-bg.webp"
    characterA="/homepage-hero-character-a.webp"
    characterB="/homepage-hero-character-b.webp"
    title="Personalized Books Where Your Child Is The Actual Hero"
    subtitle="Build their look, hometown, dedication, pronouns, and animal companion"
    buttonText="Create Your Book"
    buttonHref="/create/character"
  />
  
  <!-- About Section -->
  <section class="section-padding">
    <div class="container">
      <div class="content-section">
        <h2 class="section-title">Stories That Celebrate Every Child</h2>
        <p class="section-text">
          Most personalized children's books let you pick from pre-made characters. Ours lets you build your
          child's actual look: hair style, skin tone, hometown, animal companion, pronouns, and dedication.
        </p>
        <p class="section-text">
          We create a one-of-a-kind picture book where your child appears throughout the story, not just on the
          cover. The launch edition is a short, gentle softcover made for cozy read-alouds and the joy of seeing
          your child in the story.
        </p>
        <div class="button-container">
          <Button href="/create/character" variant="primary" size="lg">
            Get Started
          </Button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Features Section -->
  <section class="section-padding features-section">
    <div class="container">
      <h2 class="section-title text-center">Why Choose Little Hero Labs?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <img src="/assets/icon_star.png" alt="Star" />
          </div>
          <h3>Imagination</h3>
          <p>Stories that spark creativity and celebrate what makes your child uniquely them.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <img src="/assets/icon_book.png" alt="Book" />
          </div>
          <h3>Learning</h3>
          <p>Gentle lessons about friendship, courage, and exploring the world woven into every adventure.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <img src="/assets/icon_rocket.png" alt="Rocket" />
          </div>
          <h3>Joy</h3>
          <p>A personalized story made for smiles, bedtime, and the joy of being seen.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Latest Book Section -->
  <section class="section-padding latest-book-section">
    <div class="container">
      <div class="latest-book-content">
        <div class="latest-book-text">
          <h2 class="section-title">[Your Child's] Inner Voice</h2>
          <p class="section-text">
            A 16-page journey through enchanted places where young heroes discover their own
            quiet strength, listen to themselves, and find the bravery to be exactly who they are.
          </p>
          <p class="section-text">
            Launch edition softcover. 8.5 &times; 8.5. Watercolor-style illustrations in a short, gentle
            picture book made to order.
          </p>
          <div class="button-container">
            <Button href="/our-books" variant="secondary" size="lg">
              View Our Books
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- How It Works Preview -->
  <section class="section-padding">
    <div class="container">
      <div class="content-section">
        <h2 class="section-title text-center">How It Works</h2>
        <p class="section-text text-center" style="max-width: 600px; margin: 0 auto 2rem;">
          Creating your child's personalized adventure takes just three simple steps.
        </p>
        <div class="steps-preview">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Customize Character</h3>
            <p>Tell us about your child's appearance</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Choose Story</h3>
            <p>Select the adventure theme</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Receive Book</h3>
            <p>Get your personalized book delivered</p>
          </div>
        </div>
        <div class="button-container text-center">
          <Button href="/how-it-works" variant="primary" size="lg">
            Learn More
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-section {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .section-title {
    margin-bottom: var(--spacing-lg);
    color: var(--color-navy-midnight);
  }
  
  .section-text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
    color: var(--color-soft-charcoal);
  }
  
  .button-container {
    margin-top: var(--spacing-lg);
  }
  
  .features-section {
    background: var(--color-storybook-beige);
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }
  
  .feature-card {
    text-align: center;
    padding: var(--spacing-lg);
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.15);
  }
  
  .feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .feature-icon img {
    width: 100%;
    height: auto;
  }
  
  .feature-card h3 {
    margin-bottom: var(--spacing-md);
    color: var(--color-hero-coral);
  }
  
  .latest-book-section {
    background: linear-gradient(135deg, var(--color-soft-teal) 0%, var(--color-sage-green) 100%);
    color: var(--color-navy-midnight);
  }
  
  .latest-book-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .latest-book-text .section-title {
    color: var(--color-navy-midnight);
  }
  
  .latest-book-text .section-text {
    color: var(--color-navy-midnight);
  }
  
  .steps-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin: var(--spacing-xl) 0;
  }
  
  .step {
    text-align: center;
    padding: var(--spacing-lg);
  }
  
  .step-number {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-hero-coral);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 auto var(--spacing-md);
    font-family: var(--font-display);
  }
  
  .step h3 {
    margin-bottom: var(--spacing-sm);
    color: var(--color-navy-midnight);
  }
  
  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      padding: 0 var(--spacing-lg); /* Add more left/right padding on mobile */
    }
    
    .latest-book-content {
      padding: 0 var(--spacing-lg); /* Add more left/right padding on mobile */
    }
    
    .steps-preview {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .section-text {
      font-size: 1rem;
    }

    .feature-card {
      padding: var(--spacing-md);
    }

    .step {
      padding: var(--spacing-md);
    }

    /* Ensure buttons are full-width on mobile */
    .button-container :global(.btn) {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
