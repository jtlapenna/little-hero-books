---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const title = "Little Hero Labs · A Personalized Picture Book Where Your Child Is the Hero";
const description = "A personalized children's picture book where your child becomes the hero of the story, illustrated to look like them. Watercolor-style art, 16 pages, ages 0–7.";

const spreads = [
  { src: '/preview/spread-1-bedtime-walk.png',     caption: "The story opens at home, in your child's hometown, on a dream-walk into the magic." },
  { src: '/preview/spread-2-glowing-doorway.png',  caption: "A glowing door opens. New worlds begin to whisper back." },
  { src: '/preview/spread-3-forest-run.png',       caption: "Listening brings courage. The voice can feel like joy." },
  { src: '/preview/spread-4-beach-shells.png',     caption: "Look closely, and beautiful things show up where you least expect them." },
  { src: '/preview/spread-5-autumn-forest.png',    caption: "The voice goes quiet. That quiet is your heart." },
  { src: '/preview/spread-6-flying-home.png',      caption: "Wherever you go, pause, breathe, listen. I'm always with you." },
];

const characters = [
  { src: '/preview/char-same-1-brown-bun-tan.png',     alt: 'Personalized character with a brown bun and medium-tan skin' },
  { src: '/preview/char-same-2-blonde-light.png',      alt: 'Personalized character with short blonde hair and light skin' },
  { src: '/preview/char-same-3-brown-bob-light.png',   alt: 'Personalized character with a brown bob and light skin' },
  { src: '/preview/char-same-4-long-brown-light.png',  alt: 'Personalized character with long brown hair and light skin' },
  { src: '/preview/char-same-5-curly-dark.png',        alt: 'Personalized character with curly dark hair and dark skin' },
  { src: '/preview/char-same-6-redbuns-light.png',     alt: 'Personalized character with red pom-pom buns and light skin' },
];
---

<Layout
  title={title}
  description={description}
  image="/preview/cover-laney-front.png"
  noindex={true}
>
  <article class="preview-page">

    <section class="hero section-padding">
      <div class="container hero-grid">
        <div class="hero-cover-wrap">
          <img
            src="/preview/cover-laney-front.png"
            alt="Cover of Finding Our Inner Voice, personalized for a child named Laney"
            class="hero-cover"
            width="800"
            height="800"
          />
        </div>
        <div class="hero-copy">
          <p class="eyebrow">Little Hero Labs</p>
          <h1>Your child becomes the hero of a personalized picture book.</h1>
          <p class="lede">
            A magical-journey story illustrated to look like them, with their favorite animal joining for the final reveal. Watercolor-style art, 16&nbsp;pages, ages&nbsp;0&ndash;7.
          </p>
          <div class="hero-cta">
            <Button href="https://www.amazon.com/dp/B0G4QPLWKH" variant="primary" size="lg">
              See it on Amazon
            </Button>
            <a class="hero-link" href="mailto:hello@littleherolabs.com">hello@littleherolabs.com</a>
          </div>
        </div>
      </div>
    </section>

    <section class="story section-padding">
      <div class="container content-narrow">
        <h2>What we make</h2>
        <p class="paragraph">
          Little Hero Labs makes personalized children's picture books where your child is the actual protagonist. Their look and their hometown show up across a 16-page magical-journey story called <em>Finding Our Inner Voice</em>, with their favorite animal joining for the final reveal. Most personalized books pick from pre-made characters; ours doesn't. The result is a keepsake that genuinely feels like the child's, illustrated to look like them on every page.
        </p>
      </div>
    </section>

    <section class="diff section-padding">
      <div class="container content-narrow">
        <h2>What makes it different</h2>
        <ul class="diff-list">
          <li><strong>Custom characters, not stock.</strong> Most personalized books let you pick from pre-made characters. Ours lets you create your own.</li>
          <li><strong>Watercolor-style illustration</strong> with the warmth of a beloved children's book classic. Not trend-driven art.</li>
          <li><strong>Premium 8.5&times;8.5 softcover</strong>, 16 pages, printed in the USA via the Lulu print network.</li>
          <li><strong>Ages 0&ndash;7</strong>, with a sweet spot of ages 3&ndash;6.</li>
          <li><strong>Made-to-order</strong>, typical 3&ndash;5 business days production.</li>
        </ul>
      </div>
    </section>

    <section class="gallery section-padding">
      <div class="container">
        <h2 class="text-center">Inside the book</h2>
        <p class="section-sub text-center">A few moments from <em>Finding Our Inner Voice</em>.</p>
        <div class="spread-grid">
          {spreads.map((s) => (
            <figure class="spread">
              <img src={s.src} alt={s.caption} loading="lazy" width="800" height="800" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="lifestyle section-padding">
      <div class="container content-narrow">
        <figure class="lifestyle-figure">
          <img
            src="/preview/lifestyle-reading-tiger.jpg"
            alt="A parent and child reading the personalized book together at home"
            loading="lazy"
            width="1200"
            height="900"
          />
          <figcaption>
            Kids light up when they see themselves on the page. Their favorite animal (here, a tiger) joins them for the final reveal.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="showcase section-padding">
      <div class="container">
        <h2 class="text-center">Six different children. Six different books.</h2>
        <p class="section-sub text-center">
          You create your child's actual look. Hair style and color, skin tone, favorite color, favorite animal. Not pre-made stock characters.
        </p>

        <div class="char-row" aria-label="Six personalized characters showing different hair, skin, and clothing">
          {characters.map((c) => (
            <img src={c.src} alt={c.alt} class="char-img" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section class="facts section-padding">
      <div class="container content-narrow">
        <h2>Quick facts</h2>
        <dl class="facts-list">
          <div class="fact"><dt>Format</dt><dd>8.5" &times; 8.5" softcover, 16 pages</dd></div>
          <div class="fact"><dt>Ages</dt><dd>0&ndash;7</dd></div>
          <div class="fact"><dt>Customization</dt><dd>
            <span class="cust-count">11 attributes</span>
            <ul class="cust-chips">
              <li>Name</li>
              <li>Age</li>
              <li>Hair style</li>
              <li>Hair color</li>
              <li>Skin tone</li>
              <li>Favorite color</li>
              <li>Animal sidekick</li>
              <li>Hometown</li>
              <li>Dedication</li>
              <li>Pronouns</li>
              <li>Clothing style</li>
            </ul>
          </dd></div>
          <div class="fact"><dt>Story title</dt><dd><em>Finding Our Inner Voice</em></dd></div>
          <div class="fact"><dt>Available on</dt><dd>Amazon Custom (live) and littleherolabs.com (D2C, launching)</dd></div>
          <div class="fact"><dt>Pricing</dt><dd>$29.99</dd></div>
          <div class="fact"><dt>Production</dt><dd>Lulu print network, typical 3&ndash;5 business days</dd></div>
        </dl>
      </div>
    </section>

    <section class="cta section-padding">
      <div class="container content-narrow text-center">
        <h2>Want to take a look?</h2>
        <p class="paragraph">If your audience is parents who'd love this, get in touch.</p>
        <ul class="cta-links">
          <li><a href="mailto:hello@littleherolabs.com">hello@littleherolabs.com</a></li>
          <li><a href="https://www.amazon.com/dp/B0G4QPLWKH">amazon.com/dp/B0G4QPLWKH</a></li>
          <li><a href="https://www.littleherolabs.com">littleherolabs.com</a></li>
        </ul>
        <p class="signoff">
          Jeff<br />
          <span class="signoff-org">Little Hero Labs</span>
        </p>
      </div>
    </section>

  </article>
</Layout>

<style>
  .preview-page {
    background-color: var(--color-off-white);
  }

  .content-narrow {
    max-width: 760px;
    margin: 0 auto;
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-hero-coral);
    margin-bottom: var(--spacing-md);
  }

  /* Hero */
  .hero {
    background:
      radial-gradient(circle at 20% 0%, color-mix(in srgb, var(--color-golden-yellow) 18%, transparent) 0%, transparent 45%),
      radial-gradient(circle at 90% 100%, color-mix(in srgb, var(--color-soft-teal) 25%, transparent) 0%, transparent 50%),
      var(--color-storybook-beige);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .hero-cover-wrap {
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 30px 60px -25px rgba(45, 49, 66, 0.35),
      0 12px 24px -12px rgba(45, 49, 66, 0.25);
  }

  .hero-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-copy h1 {
    font-size: 2.75rem;
    line-height: 1.15;
    color: var(--color-navy-midnight);
    margin-bottom: var(--spacing-md);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-soft-charcoal);
    margin-bottom: var(--spacing-lg);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .hero-link {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--color-forest-green);
  }

  /* Story / What we make */
  .story h2,
  .diff h2,
  .facts h2,
  .cta h2,
  .gallery h2,
  .showcase h2 {
    font-size: 2.25rem;
    color: var(--color-navy-midnight);
    margin-bottom: var(--spacing-md);
  }

  .gallery h2,
  .showcase h2,
  .cta h2 {
    margin-bottom: var(--spacing-sm);
  }

  .section-sub {
    font-size: 1.125rem;
    color: var(--color-soft-charcoal);
    margin-bottom: var(--spacing-xl);
  }

  .paragraph {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-soft-charcoal);
  }

  /* Differentiation list */
  .diff {
    background-color: var(--color-soft-cream);
  }

  .diff-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .diff-list li {
    font-size: 1.0625rem;
    line-height: 1.6;
    padding-left: var(--spacing-md);
    border-left: 3px solid var(--color-golden-yellow);
  }

  .diff-list strong {
    color: var(--color-navy-midnight);
  }

  /* Gallery / spreads */
  .gallery {
    background-color: var(--color-storybook-beige);
  }

  .spread-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl) var(--spacing-lg);
  }

  .spread {
    margin: 0;
  }

  .spread img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    box-shadow:
      0 18px 40px -20px rgba(45, 49, 66, 0.30),
      0 6px 14px -8px rgba(45, 49, 66, 0.18);
  }

  .spread figcaption {
    margin-top: var(--spacing-md);
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-soft-charcoal);
    text-align: center;
  }

  /* Lifestyle */
  .lifestyle {
    background-color: var(--color-off-white);
  }

  .lifestyle-figure {
    margin: 0;
  }

  .lifestyle-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow:
      0 24px 50px -22px rgba(45, 49, 66, 0.35),
      0 8px 20px -10px rgba(45, 49, 66, 0.20);
  }

  .lifestyle-figure figcaption {
    margin-top: var(--spacing-md);
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-soft-charcoal);
    text-align: center;
  }

  /* Showcase rows */
  .showcase {
    background-color: var(--color-soft-cream);
  }

  .char-row {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-lg);
  }

  .char-row:last-child {
    margin-bottom: 0;
  }

  .char-img {
    width: 14%;
    min-width: 110px;
    max-width: 160px;
    height: auto;
    object-fit: contain;
  }

  /* Quick facts */
  .facts {
    background-color: var(--color-storybook-beige);
  }

  .facts-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin: 0;
  }

  .fact {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-soft-charcoal) 12%, transparent);
  }

  .fact:last-child {
    border-bottom: none;
  }

  .fact dt {
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--color-navy-midnight);
    font-size: 1rem;
  }

  .fact dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-soft-charcoal);
  }

  .cust-count {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--color-navy-midnight);
    margin-bottom: var(--spacing-sm);
  }

  .cust-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cust-chips li {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-navy-midnight);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-golden-yellow) 22%, var(--color-off-white));
    border: 1px solid color-mix(in srgb, var(--color-golden-yellow) 45%, transparent);
    line-height: 1;
  }

  /* CTA */
  .cta {
    background:
      linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--color-golden-yellow) 10%, transparent) 100%),
      var(--color-off-white);
  }

  .cta-links {
    list-style: none;
    padding: 0;
    margin: var(--spacing-lg) 0 var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: center;
  }

  .cta-links a {
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    color: var(--color-hero-coral);
  }

  .cta-links a:hover {
    color: var(--color-forest-green);
  }

  .signoff {
    margin-top: var(--spacing-xl);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-navy-midnight);
  }

  .signoff-org {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--color-soft-charcoal);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .hero-copy h1 {
      font-size: 2rem;
    }

    .lede {
      font-size: 1.0625rem;
    }

    .spread-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .fact {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
    }

    .fact dt {
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-hero-coral);
    }

    .char-img {
      width: 28%;
      min-width: 90px;
    }
  }

  @media (max-width: 480px) {
    .hero-copy h1 {
      font-size: 1.75rem;
    }

    .story h2,
    .diff h2,
    .facts h2,
    .cta h2,
    .gallery h2,
    .showcase h2 {
      font-size: 1.75rem;
    }

    .char-img {
      width: 30%;
      min-width: 80px;
    }
  }
</style>
