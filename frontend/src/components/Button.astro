---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;
---

{href ? (
  <a href={href} class={`btn btn-${variant} btn-${size} ${className}`}>
    <slot />
  </a>
) : (
  <button class={`btn btn-${variant} btn-${size} ${className}`}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1rem;
  }
  
  .btn-primary {
    background: var(--color-hero-coral);
    color: #FFFFFF;
  }
  
  .btn-primary:hover {
    background: color-mix(in srgb, var(--color-hero-coral) 85%, black);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-hero-coral) 40%, transparent);
    color: #FFFFFF;
  }
  
  .btn-secondary {
    background: var(--color-golden-yellow);
    color: var(--color-navy-midnight);
  }
  
  .btn-secondary:hover {
    background: color-mix(in srgb, var(--color-golden-yellow) 95%, white);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-golden-yellow) 40%, transparent);
    color: var(--color-navy-midnight);
  }
  
  .btn-sm {
    padding: 0.5rem 1.5rem;
    font-size: 0.9rem;
  }
  
  .btn-md {
    padding: 0.75rem 2rem;
    font-size: 1rem;
  }
  
  .btn-lg {
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
  }
</style>

