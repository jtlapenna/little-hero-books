---
// Footer component
---

<footer class="footer" transition:name="site-footer" transition:persist>
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3 class="footer-logo">Little Hero Labs</h3>
        <p class="footer-tagline">Become the hero of your own story.</p>
      </div>
      
      <div class="footer-section">
        <h4>Pages</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/our-books">Our Books</a></li>
          <li><a href="/how-it-works">How It Works</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Personalized Books</h4>
        <ul class="footer-links">
          <li><a href="/personalized-birthday-book/">Birthday Book</a></li>
          <li><a href="/personalized-dinosaur-book/">Dinosaur Book</a></li>
          <li><a href="/personalized-unicorn-book/">Unicorn Book</a></li>
          <li><a href="/childrens-books-about-courage/">Books About Courage</a></li>
          <li><a href="/confidence-book-for-kids/">Confidence Book</a></li>
        </ul>
      </div>
      
      <div class="footer-section">
        <h4>Connect</h4>
        <p>Follow us for updates and stories</p>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; 2025 Little Hero Labs. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-midnight);
    color: var(--color-off-white);
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }
  
  .footer-section h3,
  .footer-section h4 {
    color: var(--color-off-white);
    margin-bottom: var(--spacing-md);
    font-family: var(--font-heading);
  }
  
  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  
  .footer-tagline {
    color: var(--color-sage-green);
    font-style: italic;
  }
  
  .footer-links {
    list-style: none;
  }
  
  .footer-links li {
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-links a {
    color: var(--color-sage-green);
    transition: color 0.3s ease;
  }
  
  .footer-links a:hover {
    color: var(--color-hero-coral);
  }
  
  .footer-bottom {
    text-align: center;
    padding-top: var(--spacing-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-sage-green);
    font-size: 0.9rem;
  }
  
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
