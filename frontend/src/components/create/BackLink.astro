---
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Back' } = Astro.props;
---

<a href={href} class="back-link">
  ← {label}
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: var(--color-teal, #5AC6B1);
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
