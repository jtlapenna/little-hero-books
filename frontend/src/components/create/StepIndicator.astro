---
interface Props {
  currentStep: 'character' | 'customize' | 'review' | 'checkout' | 'processing';
}

const { currentStep } = Astro.props;

const steps: { id: string; label: string }[] = [
  { id: 'character', label: 'Character' },
  { id: 'customize', label: 'Customize' },
  { id: 'review', label: 'Review' },
  { id: 'checkout', label: 'Checkout' },
  { id: 'processing', label: 'Processing' },
];
---

<nav class="step-indicator" aria-label="Create your book progress">
  <ol class="step-list" role="list">
    {steps.map((step) => (
      <li
        class:list={['step-item', step.id === currentStep && 'step-item--current']}
        aria-current={step.id === currentStep ? 'step' : undefined}
      >
        <span class="step-label">{step.label}</span>
      </li>
    ))}
  </ol>
  <span class="step-book-count" id="step-book-count" style="display:none;"></span>
</nav>

<script>
  import { load } from '../../lib/createFlow/createFlowStorage';
  const state = load();
  if (state && state.books && state.books.length > 1) {
    const badge = document.getElementById('step-book-count');
    if (badge) {
      badge.textContent = `${state.books.length} books`;
      badge.style.display = 'inline-block';
    }
  }
</script>

<style>
  .step-indicator {
    padding: var(--spacing-md, 1rem) var(--spacing-lg, 2rem);
  }

  .step-list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
  }

  .step-item {
    display: flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--color-soft-charcoal, #333);
  }

  .step-item--current .step-label {
    font-weight: 600;
    color: var(--color-navy, #2D3142);
  }

  .step-item:not(:last-child)::after {
    content: '›';
    margin-left: var(--spacing-sm, 0.5rem);
    margin-right: var(--spacing-sm, 0.5rem);
    color: var(--color-teal, #5AC6B1);
  }

  .step-label {
    color: inherit;
    white-space: nowrap;
  }

  .step-book-count {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: var(--color-teal, #5AC6B1);
    border-radius: 12px;
    padding: 0.125rem 0.5rem;
    margin-left: var(--spacing-sm, 0.5rem);
    vertical-align: middle;
  }

  /* Scale down on narrow screens to keep all steps on one line */
  @media (max-width: 420px) {
    .step-item { font-size: 0.75rem; }
    .step-item:not(:last-child)::after {
      margin-left: 0.25rem;
      margin-right: 0.25rem;
    }
    .step-book-count { font-size: 0.625rem; }
  }
</style>
