---
import Button from './Button.astro';

interface Props {
  imageSrc: string;
  imageAlt: string;
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  // Layered animation mode
  bgImage?: string;
  characterA?: string;
  characterB?: string;
}

const { 
  imageSrc, 
  imageAlt, 
  title, 
  subtitle, 
  buttonText, 
  buttonHref,
  bgImage,
  characterA,
  characterB
} = Astro.props;

const isLayered = bgImage && characterA && characterB;
---

<section class="hero">
  <div class="hero-image-container">
    {isLayered ? (
      <>
        <img src={bgImage} alt={imageAlt} class="hero-bg" />
        <img src={characterA} alt="Character A" class={`hero-character hero-character-a`} />
        <img src={characterB} alt="Character B" class={`hero-character hero-character-b`} />
        {/* Mobile fallback - static image only in layered mode */}
        <img src={imageSrc} alt={imageAlt} class="hero-image mobile-hero" />
      </>
    ) : (
      <img src={imageSrc} alt={imageAlt} class="hero-image" />
    )}
    {(title || subtitle || buttonText) && (
      <div class="hero-content">
        <div class="container">
          {title && <h1 class="hero-title">{title}</h1>}
          {subtitle && <p class="hero-subtitle">{subtitle}</p>}
          {buttonText && buttonHref && (
            <Button href={buttonHref} variant="primary" size="lg">
              {buttonText}
            </Button>
          )}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    margin-top: 0; /* Hero slides under header */
  }
  
  .hero-image-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: 500px;
  }
  
  /* Ensure layered mode has proper aspect ratio */
  .hero-image-container:has(.hero-bg) {
    aspect-ratio: 16 / 9;
    min-height: 500px;
  }
  
  /* Single image mode (non-layered) */
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  /* Hidden by default; shown on mobile */
  .mobile-hero {
    display: none;
  }
  
  /* Ken Burns effect - subtle zoom and pan on hover */
  @keyframes kenBurns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    50% {
      transform: scale(1.05) translate(-1%, -1%);
    }
    100% {
      transform: scale(1) translate(0, 0);
    }
  }
  
  .hero-image-container:hover .hero-image {
    animation: kenBurns 20s ease-in-out infinite;
  }
  
  /* Layered animation mode */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .hero-character {
    position: absolute;
    top: 0;
    height: 100%;
    width: auto;
    object-fit: contain;
    z-index: 2;
  }
  
  .hero-character-a {
    left: 0;
  }
  
  .hero-character-b {
    right: 0;
  }
  
  /* Version 1 removed */
  
  /* Version 2: Independent movement - each character moves on its own */
  @keyframes characterMoveV2A {
    0%, 100% {
      transform: scale(0.55) translate(-22%, -10%);
    }
    20% {
      transform: scale(0.55) translate(-18%, -2%);
    }
    40% {
      transform: scale(0.55) translate(-24%, 4%);
    }
    60% {
      transform: scale(0.55) translate(-30%, -2%);
    }
    80% {
      transform: scale(0.55) translate(-26%, -8%);
    }
  }
  
  @keyframes characterMoveV2B {
    0% {
      transform: scale(0.55) translate(50%, 28%); /* start even further right */
    }
    50% {
      transform: scale(0.55) translate(15%, 28%); /* slide left to stop */
    }
    100% {
      transform: scale(0.55) translate(50%, 28%); /* slide back right to start */
    }
  }
  
  .hero-character-a {
    animation: characterMoveV2A 18s ease-in-out infinite;
  }
  
  .hero-character-b {
    animation: characterMoveV2B 22s ease-in-out infinite;
  }
  
  .hero-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 10;
    width: 100%;
    max-width: 600px;
    padding: 0 var(--spacing-lg);
    pointer-events: none;
  }
  
  .hero-content .container {
    pointer-events: auto;
  }
  
  .hero-title {
    color: var(--color-forest-green);
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    text-shadow: none;
  }
  
  .hero-subtitle {
    color: var(--color-soft-charcoal);
    font-size: 1.125rem;
    font-family: var(--font-ui);
    text-shadow: none;
    margin-bottom: var(--spacing-lg);
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    .hero-content {
      max-width: 90%;
      padding: 0 var(--spacing-md);
    }
    /* On mobile, show static image and hide layered elements */
    .mobile-hero {
      display: block;
    }
    .hero-bg,
    .hero-character {
      display: none;
    }
    .hero-image-container {
      aspect-ratio: auto;
      min-height: auto;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
  }
  
  @media (min-width: 769px) and (max-width: 1200px) {
    .hero-content {
      max-width: 500px;
    }
    
    .hero-title {
      font-size: 2.5rem;
    }
  }
</style>

