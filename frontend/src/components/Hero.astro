---
import Button from './Button.astro';

interface Props {
  imageSrc: string;
  imageAlt: string;
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  // Layered animation mode
  bgImage?: string;
  characterA?: string;
  characterB?: string;
}

const { 
  imageSrc, 
  imageAlt, 
  title, 
  subtitle, 
  buttonText, 
  buttonHref,
  bgImage,
  characterA,
  characterB
} = Astro.props;

const isLayered = bgImage && characterA && characterB;
---

<section class="hero">
  <div class="hero-image-container">
    {isLayered ? (
      <>
        <img src={bgImage} alt={imageAlt} class="hero-bg" />
        {/* Floating clouds - behind characters, above background */}
        <img src="/cloud-1.png" alt="Cloud 1" class="hero-cloud hero-cloud-1" />
        <img src="/cloud-2.png" alt="Cloud 2" class="hero-cloud hero-cloud-2" />
        <img src="/cloud-1.png" alt="Cloud 3" class="hero-cloud hero-cloud-3" />
        <img src="/cloud-2.png" alt="Cloud 4" class="hero-cloud hero-cloud-4" />
        {/* Twinkling stars - behind left character, above background */}
        <img src="/stars1.webp" alt="Stars 1" class="hero-stars hero-stars-1" />
        <img src="/stars4.webp" alt="Stars 4" class="hero-stars hero-stars-4" />
        <img src="/stars3.webp" alt="Stars 3" class="hero-stars hero-stars-3" />
        <img src={characterA} alt="Character A" class={`hero-character hero-character-a`} />
        <img src={characterB} alt="Character B" class={`hero-character hero-character-b`} />
        {/* Mobile fallback - static image only in layered mode */}
        <img src={imageSrc} alt={imageAlt} class="hero-image mobile-hero" />
      </>
    ) : (
      <img src={imageSrc} alt={imageAlt} class="hero-image" />
    )}
    {(title || subtitle || buttonText) && (
      <div class="hero-content">
        <div class="container">
          {title && <h1 class="hero-title">{title}</h1>}
          {subtitle && <p class="hero-subtitle">{subtitle}</p>}
          {buttonText && buttonHref && (
            <Button href={buttonHref} variant="primary" size="lg">
              {buttonText}
            </Button>
          )}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    margin-top: 0; /* Hero slides under header */
  }
  
  .hero-image-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: 500px;
  }
  
  /* Ensure layered mode has proper aspect ratio */
  .hero-image-container:has(.hero-bg) {
    aspect-ratio: 16 / 9;
    min-height: 500px;
  }
  
  /* Single image mode (non-layered) */
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  /* Hidden by default; shown on mobile */
  .mobile-hero {
    display: none;
  }
  
  /* Ken Burns effect - subtle zoom and pan on hover */
  @keyframes kenBurns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    50% {
      transform: scale(1.05) translate(-1%, -1%);
    }
    100% {
      transform: scale(1) translate(0, 0);
    }
  }
  
  .hero-image-container:hover .hero-image {
    animation: kenBurns 20s ease-in-out infinite;
  }
  
  /* Layered animation mode */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .hero-character {
    position: absolute;
    top: 0;
    height: 100%;
    width: auto;
    object-fit: contain;
    z-index: 2;
  }
  
  .hero-character-a {
    left: 0;
  }
  
  .hero-character-b {
    right: 0;
  }
  
  /* Version 1 removed */
  
  /* Version 2: Independent movement - each character moves on its own */
  @keyframes characterMoveV2A {
    0%, 100% {
      transform: scale(0.55) translate(-22%, -10%);
    }
    20% {
      transform: scale(0.55) translate(-18%, -2%);
    }
    40% {
      transform: scale(0.55) translate(-24%, 4%);
    }
    60% {
      transform: scale(0.55) translate(-30%, -2%);
    }
    80% {
      transform: scale(0.55) translate(-26%, -8%);
    }
  }
  
  @keyframes characterMoveV2B {
    0% {
      transform: scale(0.55) translate(50%, 28%); /* start at right */
    }
    100% {
      transform: scale(0.55) translate(15%, 28%); /* slide left and stop */
    }
  }
  
  .hero-character-a {
    animation: characterMoveV2A 18s ease-in-out infinite;
  }
  
  .hero-character-b {
    animation: characterMoveV2B 22s ease-in forwards; /* forwards = stay at end position */
  }
  
  /* Floating clouds - behind characters, above background */
  .hero-cloud {
    position: absolute;
    z-index: 1; /* Above background (1), below characters (2) */
    opacity: 0;
    pointer-events: none;
  }
  
  .hero-cloud-1 {
    top: 6%; /* Top 48%: 0-48% */
    width: 138px; /* Small +15% (was 120px) */
    height: auto;
    animation: cloudFloat1 28s linear infinite;
  }
  
  .hero-cloud-2 {
    top: 18%; /* Top 48% */
    width: 230px; /* Large +15% (was 200px) */
    height: auto;
    animation: cloudFloat2 32s linear infinite 4s; /* Staggered start */
  }
  
  .hero-cloud-3 {
    top: 32%; /* Top 48% */
    width: 115px; /* Small +15% (was 100px) */
    height: auto;
    animation: cloudFloat3 26s linear infinite 8s;
  }
  
  .hero-cloud-4 {
    top: 12%; /* Top 48% */
    width: 253px; /* Large +15% (was 220px) */
    height: auto;
    animation: cloudFloat4 35s linear infinite 12s;
  }
  
  @keyframes cloudFloat1 {
    0% {
      left: 50%; /* Start at midpoint */
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 1; /* Fade in quickly */
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%; /* Exit off right edge */
      opacity: 0;
      transform: translateX(20%);
    }
  }
  
  @keyframes cloudFloat2 {
    0% {
      left: 50%; /* Start at midpoint */
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 1; /* Fade in quickly */
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%; /* Exit off right edge */
      opacity: 0;
      transform: translateX(20%);
    }
  }
  
  @keyframes cloudFloat3 {
    0% {
      left: 50%; /* Start at midpoint */
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 1; /* Fade in quickly */
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%; /* Exit off right edge */
      opacity: 0;
      transform: translateX(20%);
    }
  }
  
  @keyframes cloudFloat4 {
    0% {
      left: 50%; /* Start at midpoint */
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 1; /* Fade in quickly */
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%; /* Exit off right edge */
      opacity: 0;
      transform: translateX(20%);
    }
  }
  
  /* Twinkling stars - behind left character, above background */
  .hero-stars {
    position: absolute;
    z-index: 1; /* Above background (1), below characters (2) */
    pointer-events: none;
    will-change: transform, opacity;
  }
  
  .hero-stars-1 {
    left: 0%; /* Moved left 2% (was 2%) */
    top: 26%; /* Moved down 8% (was 18%) */
    width: 400px; /* Initial size */
    animation: 
      heroStarsTwinkle1 3.8s ease-in-out infinite 0.83s,
      heroStarsDrift1 7.3s ease-in-out infinite alternate;
  }
  
  .hero-stars-4 {
    left: -1%; /* Moved right 1% (was -2%) */
    top: 52%; /* Moved down 12% (was 40%) */
    width: 171px; /* 25% smaller (was 228px) */
    animation: 
      heroStarsTwinkle4 4.2s ease-in-out infinite 1.2s,
      heroStarsDrift4 8.5s ease-in-out infinite alternate;
  }
  
  .hero-stars-3 {
    left: 10%; /* Moved left 5% (was 15%) */
    top: 63%; /* Moved up 12% (was 75%) */
    width: 255px; /* 15% smaller (was 300px) */
    animation: 
      heroStarsTwinkle3 3.9s ease-in-out infinite 0.6s,
      heroStarsDrift3 7.8s ease-in-out infinite alternate-reverse;
  }
  
  @keyframes heroStarsTwinkle3 {
    0% { opacity: 0.28; transform: scale(0.96); }
    18% { opacity: 0.92; transform: scale(1.09); }
    42% { opacity: 0.38; transform: scale(1.0); }
    65% { opacity: 1; transform: scale(1.11); }
    88% { opacity: 0.48; transform: scale(1.0); }
    100% { opacity: 0.28; transform: scale(0.96); }
  }
  
  @keyframes heroStarsDrift3 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-0.3%, 0.3%); }
    100% { transform: translate(0, 0); }
  }
  
  @keyframes heroStarsTwinkle4 {
    0% { opacity: 0.3; transform: scale(0.97); }
    20% { opacity: 0.9; transform: scale(1.08); }
    45% { opacity: 0.4; transform: scale(1.0); }
    68% { opacity: 1; transform: scale(1.12); }
    85% { opacity: 0.5; transform: scale(1.01); }
    100% { opacity: 0.3; transform: scale(0.97); }
  }
  
  @keyframes heroStarsDrift4 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(0.2%, 0.4%); }
    100% { transform: translate(0, 0); }
  }
  
  @keyframes heroStarsTwinkle1 {
    0% { opacity: 0.25; transform: scale(0.98); }
    17% { opacity: 0.95; transform: scale(1.07); }
    39% { opacity: 0.45; transform: scale(1.0); }
    63% { opacity: 1; transform: scale(1.1); }
    82% { opacity: 0.5; transform: scale(1.02); }
    100% { opacity: 0.25; transform: scale(0.98); }
  }
  
  /* Subtle drifting to enhance randomness */
  @keyframes heroStarsDrift1 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(0.3%, -0.5%); }
    100% { transform: translate(0, 0); }
  }
  
  .hero-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 10;
    width: 100%;
    max-width: 600px;
    padding: 0 var(--spacing-lg);
    pointer-events: none;
  }
  
  .hero-content .container {
    pointer-events: auto;
  }
  
  .hero-title {
    color: var(--color-forest-green);
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    text-shadow: none;
  }
  
  .hero-subtitle {
    color: var(--color-soft-charcoal);
    font-size: 1.125rem;
    font-family: var(--font-ui);
    text-shadow: none;
    margin-bottom: var(--spacing-lg);
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    .hero-content {
      max-width: 90%;
      padding: 0 var(--spacing-md);
    }
    /* On mobile, show static image and hide layered elements */
    .mobile-hero {
      display: block;
    }
    .hero-bg,
    .hero-character,
    .hero-cloud,
    .hero-stars {
      display: none;
    }
    .hero-image-container {
      aspect-ratio: auto;
      min-height: auto;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
  }
  
  @media (min-width: 769px) and (max-width: 1200px) {
    .hero-content {
      max-width: 500px;
    }
    
    .hero-title {
      font-size: 2.5rem;
    }
  }
</style>

