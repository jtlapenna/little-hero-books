# Backend API base URL for create flow and approve page. Empty = same origin.
# Local dev: backend runs on 3001, so use http://localhost:3001
# Production: set to backend URL (e.g. https://admin.littleherolabs.com) in build/deploy env.
PUBLIC_BACKEND_URL=http://localhost:3000

# Stripe test mode keys (get from Stripe dashboard)
STRIPE_SANDBOX_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SANDBOX_SECRET_KEY=sk_test_your_secret_key
STRIPE_SANDBOX_WEBHOOK_SECRET=whsec_your_webhook_secret