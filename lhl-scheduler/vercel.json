{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "echo No dependencies required",
  "schedules": {
    "router": {
      "schedule": "0 0 29 2 *",
      "path": "/api/cron/router",
      "requestMethod": "GET"
    },
    "health-monitor": {
      "schedule": "0 0 29 2 *",
      "path": "/api/cron/health-monitor",
      "requestMethod": "GET"
    },
    "book-config-integrity": {
      "schedule": "0 0 29 2 *",
      "path": "/api/cron/book-config-integrity",
      "requestMethod": "GET"
    }
  }
}
